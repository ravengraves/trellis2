// roseviz_app.pka — Minimal roseviz shell for images + point clouds.

use fmt;
use math;

def ROSEVIZ_TAB_COUNT: i32 = 11;
def ROSEVIZ_TAB_ALL: i32 = 10;

def ROSEVIZ_TILE_IMAGE: i32 = 0;
def ROSEVIZ_TILE_POINTS: i32 = 1;

def ROSEVIZ_KEY_0: i32 = 48;
def ROSEVIZ_KEY_1: i32 = 49;
def ROSEVIZ_KEY_2: i32 = 50;
def ROSEVIZ_KEY_3: i32 = 51;
def ROSEVIZ_KEY_4: i32 = 52;
def ROSEVIZ_KEY_5: i32 = 53;
def ROSEVIZ_KEY_6: i32 = 54;
def ROSEVIZ_KEY_7: i32 = 55;
def ROSEVIZ_KEY_8: i32 = 56;
def ROSEVIZ_KEY_9: i32 = 57;

def ROSEVIZ_SIDEBAR_W: i32 = 220;
def ROSEVIZ_BOTTOM_H: i32 = 30;
def ROSEVIZ_GAP: i32 = 8;
def ROSEVIZ_TAB_W: i32 = 28;
def ROSEVIZ_TAB_ALL_W: i32 = 40;
def ROSEVIZ_TAB_GAP: i32 = 4;

def ROSEVIZ_IMAGE_W: i32 = 96;
def ROSEVIZ_IMAGE_H: i32 = 64;
def ROSEVIZ_IMAGE_RGB: size = 18432z;

def ROSEVIZ_CLOUD_RT_W: i32 = 320;
def ROSEVIZ_CLOUD_RT_H: i32 = 180;
def ROSEVIZ_CLOUD_PIXELS: size = 57600z;
def ROSEVIZ_CLOUD_RGB: size = 172800z;

export type RosevizRect = struct {
	x: i32,
	y: i32,
	w: i32,
	h: i32,
};

export type RosevizApp = struct {
	selected_tab: i32,
	selected_tile: i32,
	last_image_tab: i32,
	image_tex: E2GpuTexture,
	image_rgb: [ROSEVIZ_IMAGE_RGB]u8,
	image_ready: bool,
	cloud_tex: E2GpuTexture,
	cloud_rgb: [ROSEVIZ_CLOUD_RGB]u8,
	cloud_depth: [ROSEVIZ_CLOUD_PIXELS]f32,
	cloud_ready: bool,
	cloud_points: E2GpuColorBuffer,
	cloud_cam: Camera,
};

fn roseviz_window_dims(rt: *E2Runtime, out_w: *i32, out_h: *i32) void = {
	if (rt.mode == E2_MODE_WINDOW) {
		*out_w = shim_window_width();
		*out_h = shim_window_height();
	} else {
		*out_w = rt.fb.width;
		*out_h = rt.fb.height;
	};
};

fn roseviz_sidebar_rect(wh: i32) RosevizRect = {
	return RosevizRect {
		x = 0,
		y = 0,
		w = ROSEVIZ_SIDEBAR_W,
		h = wh - ROSEVIZ_BOTTOM_H
	};
};

fn roseviz_bottom_rect(ww: i32, wh: i32) RosevizRect = {
	return RosevizRect {
		x = 0,
		y = wh - ROSEVIZ_BOTTOM_H,
		w = ww,
		h = ROSEVIZ_BOTTOM_H
	};
};

fn roseviz_image_rect(ww: i32, wh: i32) RosevizRect = {
	let main_x = ROSEVIZ_SIDEBAR_W + ROSEVIZ_GAP;
	let main_y = ROSEVIZ_GAP;
	let main_w = ww - main_x - ROSEVIZ_GAP;
	let main_h = wh - ROSEVIZ_BOTTOM_H - ROSEVIZ_GAP * 2;
	let image_h = (main_h * 11) / 20;
	return RosevizRect {
		x = main_x,
		y = main_y,
		w = main_w,
		h = image_h
	};
};

fn roseviz_points_rect(ww: i32, wh: i32) RosevizRect = {
	let image = roseviz_image_rect(ww, wh);
	let bottom_y = image.y + image.h + ROSEVIZ_GAP;
	let main_x = image.x;
	let main_w = image.w;
	let main_h = wh - ROSEVIZ_BOTTOM_H - ROSEVIZ_GAP * 2;
	let points_h = main_h - image.h - ROSEVIZ_GAP;
	return RosevizRect {
		x = main_x,
		y = bottom_y,
		w = main_w,
		h = points_h
	};
};

fn roseviz_add_rect(buf: *E2CpuColorVertexBuffer,
	x: i32, y: i32, w: i32, h: i32, c: Color) void = {
	if (w <= 0 || h <= 0) { return; };
	let p0 = vec3_new(x: f32, y: f32, 0.0);
	let p1 = vec3_new((x + w): f32, y: f32, 0.0);
	let p2 = vec3_new((x + w): f32, (y + h): f32, 0.0);
	let p3 = vec3_new(x: f32, (y + h): f32, 0.0);
	util_cpu_color_buffer_add_tri(buf, p0, p1, p2, c);
	util_cpu_color_buffer_add_tri(buf, p0, p2, p3, c);
};

fn roseviz_add_outline(buf: *E2CpuColorVertexBuffer,
	x: i32, y: i32, w: i32, h: i32, c: Color) void = {
	if (w <= 1 || h <= 1) { return; };
	let p0 = vec3_new(x: f32, y: f32, 0.0);
	let p1 = vec3_new((x + w): f32, y: f32, 0.0);
	let p2 = vec3_new((x + w): f32, (y + h): f32, 0.0);
	let p3 = vec3_new(x: f32, (y + h): f32, 0.0);
	util_cpu_color_buffer_add_line(buf, p0, p1, c);
	util_cpu_color_buffer_add_line(buf, p1, p2, c);
	util_cpu_color_buffer_add_line(buf, p2, p3, c);
	util_cpu_color_buffer_add_line(buf, p3, p0, c);
};

fn roseviz_tab_rect(tab: i32, wh: i32) RosevizRect = {
	let x = 8 + tab * (ROSEVIZ_TAB_W + ROSEVIZ_TAB_GAP);
	return RosevizRect {
		x = x,
		y = wh - ROSEVIZ_BOTTOM_H + 4,
		w = ROSEVIZ_TAB_W,
		h = ROSEVIZ_BOTTOM_H - 8
	};
};

fn roseviz_tab_all_rect(wh: i32) RosevizRect = {
	let x = 8 + 10 * (ROSEVIZ_TAB_W + ROSEVIZ_TAB_GAP);
	return RosevizRect {
		x = x,
		y = wh - ROSEVIZ_BOTTOM_H + 4,
		w = ROSEVIZ_TAB_ALL_W,
		h = ROSEVIZ_BOTTOM_H - 8
	};
};

fn roseviz_fit_image(tile: *RosevizRect, img_w: i32, img_h: i32) RosevizRect = {
	let out = *tile;
	if (tile.w <= 0 || tile.h <= 0 || img_w <= 0 || img_h <= 0) {
		return out;
	};

	let tile_aspect = (tile.w: f32) / (tile.h: f32);
	let img_aspect = (img_w: f32) / (img_h: f32);

	if (img_aspect > tile_aspect) {
		let fit_h = ((tile.w: f32) / img_aspect): i32;
		out.x = tile.x;
		out.w = tile.w;
		out.h = fit_h;
		out.y = tile.y + (tile.h - fit_h) / 2;
		return out;
	};

	let fit_w = ((tile.h: f32) * img_aspect): i32;
	out.y = tile.y;
	out.h = tile.h;
	out.w = fit_w;
	out.x = tile.x + (tile.w - fit_w) / 2;
	return out;
};

fn roseviz_tile_topic(tile: i32) str = {
	if (tile == ROSEVIZ_TILE_IMAGE) {
		return "/demo/camera/front";
	};
	return "/demo/points/lidar";
};

fn roseviz_tile_topic_alt1(tile: i32) str = {
	if (tile == ROSEVIZ_TILE_IMAGE) {
		return "/demo/camera/left";
	};
	return "/demo/points/map";
};

fn roseviz_tile_topic_alt2(tile: i32) str = {
	if (tile == ROSEVIZ_TILE_IMAGE) {
		return "/demo/camera/depth";
	};
	return "/demo/points/local";
};

fn roseviz_tile_name(tile: i32) str = {
	if (tile == ROSEVIZ_TILE_IMAGE) {
		return "Image";
	};
	return "PointCloud";
};

fn roseviz_fill_demo_image(app: *RosevizApp, tab: i32) void = {
	for (let py: i32 = 0; py < ROSEVIZ_IMAGE_H; py += 1) {
		for (let px: i32 = 0; px < ROSEVIZ_IMAGE_W; px += 1) {
			let idx: size = ((py * ROSEVIZ_IMAGE_W + px) * 3): size;
			let rr: i32 = (px * 255) / ROSEVIZ_IMAGE_W;
			let gg: i32 = (py * 255) / ROSEVIZ_IMAGE_H;
			let bb: i32 = ((px + py + tab * 17) * 255) / (ROSEVIZ_IMAGE_W + ROSEVIZ_IMAGE_H);
			if (((px / 8) + (py / 8) + tab) % 2 == 0) {
				rr = (rr + 64);
				bb = (bb + 48);
			};
			if (rr > 255) { rr = 255; };
			if (gg > 255) { gg = 255; };
			if (bb > 255) { bb = 255; };
			app.image_rgb[idx] = rr: u8;
			app.image_rgb[idx + 1z] = gg: u8;
			app.image_rgb[idx + 2z] = bb: u8;
		};
	};
};

fn roseviz_make_cloud_points() E2GpuColorBuffer = {
	let cpu = util_cpu_color_buffer_init();
	for (let i: i32 = 0; i < 256; i += 1) {
		let t = (i: f32) * 9.0;
		let sc = math::sincos(t * (math::PI / 180.0));
		let z = ((i % 32): f32 - 16.0) * 0.06;
		let r = 0.25 + ((i % 5): f32) * 0.03;
		let x = sc.c * r;
		let y = sc.s * r;
		let col = color_new(
			0.82 + ((i % 3): f32) * 0.06,
			0.08 + ((i % 4): f32) * 0.02,
			0.08 + ((i % 5): f32) * 0.02,
			1.0);
		util_cpu_color_buffer_add_point(&cpu, vec3_new(x, y, z), color_clamp(col));
	};
	util_cpu_color_buffer_add_point(&cpu, vec3_new(0.0, 0.0, 0.0), color_new(1.0, 0.0, 0.0, 1.0));
	util_cpu_color_buffer_add_point(&cpu, vec3_new(0.4, 0.0, 0.0), color_new(1.0, 0.1, 0.1, 1.0));
	util_cpu_color_buffer_add_point(&cpu, vec3_new(0.0, 0.4, 0.0), color_new(0.95, 0.05, 0.05, 1.0));
	util_cpu_color_buffer_add_point(&cpu, vec3_new(0.0, 0.0, 0.4), color_new(0.9, 0.0, 0.0, 1.0));
	return util_color_upload(&cpu);
};

export fn roseviz_app_init(app: *RosevizApp) bool = {
	app.selected_tab = 0;
	app.selected_tile = ROSEVIZ_TILE_IMAGE;
	app.last_image_tab = -1;
	app.image_tex = E2GpuTexture { handle = 0u32, width = 0, height = 0, valid = false };
	app.image_ready = false;
	app.cloud_tex = E2GpuTexture { handle = 0u32, width = 0, height = 0, valid = false };
	app.cloud_ready = false;
	app.cloud_points = roseviz_make_cloud_points();
	app.cloud_cam = camera_default();
	app.cloud_cam.distance = 2.2;
	app.cloud_cam.yaw = 30.0;
	app.cloud_cam.pitch = 20.0;
	app.cloud_cam.target = vec3_new(0.0, 0.0, 0.0);

	roseviz_fill_demo_image(app, 0);
	app.image_tex = e2_gpu_texture_create_rgb(
		app.image_rgb[0z..ROSEVIZ_IMAGE_RGB],
		ROSEVIZ_IMAGE_W, ROSEVIZ_IMAGE_H);
	app.image_ready = app.image_tex.valid;
	app.last_image_tab = 0;

	return app.image_ready && app.cloud_points.valid;
};

export fn roseviz_app_shutdown(app: *RosevizApp) void = {
	if (app.image_ready) {
		e2_gpu_texture_destroy(&app.image_tex);
		app.image_ready = false;
	};
	if (app.cloud_ready) {
		e2_gpu_texture_destroy(&app.cloud_tex);
		app.cloud_ready = false;
	};
	e2_gpu_color_destroy(&app.cloud_points);
};

export fn roseviz_handle_input(app: *RosevizApp, rt: *E2Runtime) void = {
	if (input_key_just_pressed(&rt.input, ROSEVIZ_KEY_0)) { app.selected_tab = 0; };
	if (input_key_just_pressed(&rt.input, ROSEVIZ_KEY_1)) { app.selected_tab = 1; };
	if (input_key_just_pressed(&rt.input, ROSEVIZ_KEY_2)) { app.selected_tab = 2; };
	if (input_key_just_pressed(&rt.input, ROSEVIZ_KEY_3)) { app.selected_tab = 3; };
	if (input_key_just_pressed(&rt.input, ROSEVIZ_KEY_4)) { app.selected_tab = 4; };
	if (input_key_just_pressed(&rt.input, ROSEVIZ_KEY_5)) { app.selected_tab = 5; };
	if (input_key_just_pressed(&rt.input, ROSEVIZ_KEY_6)) { app.selected_tab = 6; };
	if (input_key_just_pressed(&rt.input, ROSEVIZ_KEY_7)) { app.selected_tab = 7; };
	if (input_key_just_pressed(&rt.input, ROSEVIZ_KEY_8)) { app.selected_tab = 8; };
	if (input_key_just_pressed(&rt.input, ROSEVIZ_KEY_9)) { app.selected_tab = 9; };
	if (input_key_just_pressed(&rt.input, KEY_A)) { app.selected_tab = ROSEVIZ_TAB_ALL; };

	if (input_key_press_count(&rt.input, KEY_UP) > 0) {
		app.selected_tile = ROSEVIZ_TILE_IMAGE;
	};
	if (input_key_press_count(&rt.input, KEY_DOWN) > 0) {
		app.selected_tile = ROSEVIZ_TILE_POINTS;
	};

	if (app.selected_tile == ROSEVIZ_TILE_POINTS) {
		util_camera_apply_orbit_controls(&app.cloud_cam, &rt.input, rt.mode == E2_MODE_TERMINAL);
	};
};

fn roseviz_update_demo_sources(app: *RosevizApp) void = {
	if (app.last_image_tab != app.selected_tab) {
		roseviz_fill_demo_image(app, app.selected_tab);
		if (!app.image_ready) {
			app.image_tex = e2_gpu_texture_create_rgb(
				app.image_rgb[0z..ROSEVIZ_IMAGE_RGB],
				ROSEVIZ_IMAGE_W, ROSEVIZ_IMAGE_H);
			app.image_ready = app.image_tex.valid;
		} else {
			e2_gpu_texture_update_rgb(&app.image_tex, app.image_rgb[0z..ROSEVIZ_IMAGE_RGB]);
		};
		app.last_image_tab = app.selected_tab;
	};

	let point_pass = util_color_pass_init();
	util_color_pass_add(&point_pass, &app.cloud_points, 3.0);
	let empty_geom = util_geom_pass_init();
	let empty_color = util_color_pass_init();
	let lights = util_light_buffer_init();
	let env = env_default();
	let free_cam = util_camera_free_from_orbit(&app.cloud_cam);
	let ok = e2_render_camera_to_buffers(&free_cam, E2_GEOM_MODE_FLAT,
		empty_geom.draws[0z..0z],
		empty_color.draws[0z..0z],
		point_pass.draws[0z..(point_pass.count: size)],
		util_light_buffer_slice(&lights), &env,
		app.cloud_rgb[0z..ROSEVIZ_CLOUD_RGB],
		app.cloud_depth[0z..ROSEVIZ_CLOUD_PIXELS],
		ROSEVIZ_CLOUD_RT_W, ROSEVIZ_CLOUD_RT_H);
	if (!ok) { return; };

	if (!app.cloud_ready) {
		app.cloud_tex = e2_gpu_texture_create_rgb(
			app.cloud_rgb[0z..ROSEVIZ_CLOUD_RGB],
			ROSEVIZ_CLOUD_RT_W, ROSEVIZ_CLOUD_RT_H);
		app.cloud_ready = app.cloud_tex.valid;
	} else {
		e2_gpu_texture_update_rgb(&app.cloud_tex, app.cloud_rgb[0z..ROSEVIZ_CLOUD_RGB]);
	};
};

fn roseviz_text_px(rt: *E2Runtime, x: i32, y: i32, s: str, r: u8, g: u8, b: u8) void = {
	let ww: i32 = 0;
	let wh: i32 = 0;
	roseviz_window_dims(rt, &ww, &wh);
	if (ww <= 0 || wh <= 0) { return; };
	let xf = (x: f32) / (ww: f32);
	let yf = (y: f32) / (wh: f32);
	e2_text_add(rt, xf, yf, s, r, g, b);
};

fn roseviz_draw_sidebar_text(rt: *E2Runtime, app: *RosevizApp) void = {
	roseviz_text_px(rt, 12, 14, "roseviz", 250u8, 250u8, 250u8);
	roseviz_text_px(rt, 12, 34, "selected tile", 180u8, 190u8, 220u8);
	roseviz_text_px(rt, 12, 54, roseviz_tile_name(app.selected_tile), 255u8, 224u8, 96u8);

	roseviz_text_px(rt, 12, 90, "topics", 180u8, 190u8, 220u8);
	roseviz_text_px(rt, 12, 110, roseviz_tile_topic(app.selected_tile), 255u8, 255u8, 255u8);
	roseviz_text_px(rt, 12, 128, roseviz_tile_topic_alt1(app.selected_tile), 170u8, 170u8, 176u8);
	roseviz_text_px(rt, 12, 146, roseviz_tile_topic_alt2(app.selected_tile), 170u8, 170u8, 176u8);

	roseviz_text_px(rt, 12, 184, "deserialize", 180u8, 190u8, 220u8);
	roseviz_text_px(rt, 12, 204, "first_numericarray", 220u8, 230u8, 240u8);
	roseviz_text_px(rt, 12, 240, "future", 180u8, 190u8, 220u8);
	roseviz_text_px(rt, 12, 260, "Ctrl+P add_topic fuzzy match", 170u8, 170u8, 176u8);
};

fn roseviz_draw_bottom_text(rt: *E2Runtime, app: *RosevizApp, wh: i32) void = {
	for (let tab: i32 = 0; tab < 10; tab += 1) {
		let rect = roseviz_tab_rect(tab, wh);
		let tbuf: [8]u8 = [0...];
		let tf = fmt::New(tbuf[0z..8z]);
		fmt::Wi64(&tf, tab: i64);
		let col: u8 = 180u8;
		if (app.selected_tab == tab) { col = 255u8; };
		roseviz_text_px(rt, rect.x + 9, rect.y + 6, fmt::ToStr(&tf), col, col, col);
	};
	let all_rect = roseviz_tab_all_rect(wh);
	let all_col: u8 = 180u8;
	if (app.selected_tab == ROSEVIZ_TAB_ALL) { all_col = 255u8; };
	roseviz_text_px(rt, all_rect.x + 9, all_rect.y + 6, "all", all_col, all_col, all_col);
};

fn roseviz_draw_tile_text(rt: *E2Runtime, image_rect: *RosevizRect, points_rect: *RosevizRect) void = {
	roseviz_text_px(rt, image_rect.x + 10, image_rect.y + 10, "image tile", 220u8, 220u8, 220u8);
	roseviz_text_px(rt, points_rect.x + 10, points_rect.y + 10, "point cloud tile", 220u8, 220u8, 220u8);
};

export fn roseviz_render_frame(rt: *E2Runtime, app: *RosevizApp) void = {
	let ww: i32 = 0;
	let wh: i32 = 0;
	roseviz_window_dims(rt, &ww, &wh);
	if (ww <= 0 || wh <= 0) { return; };

	roseviz_update_demo_sources(app);

	let sidebar = roseviz_sidebar_rect(wh);
	let bottom = roseviz_bottom_rect(ww, wh);
	let image_rect = roseviz_image_rect(ww, wh);
	let points_rect = roseviz_points_rect(ww, wh);
	let image_fit = roseviz_fit_image(&image_rect, ROSEVIZ_IMAGE_W, ROSEVIZ_IMAGE_H);

	let fill_cpu = util_cpu_color_buffer_init();
	let line_cpu = util_cpu_color_buffer_init();

	roseviz_add_rect(&fill_cpu, sidebar.x, sidebar.y, sidebar.w, sidebar.h, color_new(0.10, 0.11, 0.14, 1.0));
	roseviz_add_rect(&fill_cpu, bottom.x, bottom.y, bottom.w, bottom.h, color_new(0.09, 0.10, 0.12, 1.0));
	roseviz_add_rect(&fill_cpu, image_rect.x, image_rect.y, image_rect.w, image_rect.h, color_new(0.12, 0.12, 0.14, 1.0));
	roseviz_add_rect(&fill_cpu, points_rect.x, points_rect.y, points_rect.w, points_rect.h, color_new(0.08, 0.09, 0.11, 1.0));

	for (let tab: i32 = 0; tab < 10; tab += 1) {
		let rect = roseviz_tab_rect(tab, wh);
		let col = color_new(0.24, 0.25, 0.28, 1.0);
		if (app.selected_tab == tab) {
			col = color_new(0.72, 0.72, 0.78, 1.0);
		};
		roseviz_add_rect(&fill_cpu, rect.x, rect.y, rect.w, rect.h, col);
	};
	let all_rect = roseviz_tab_all_rect(wh);
	let all_col = color_new(0.24, 0.25, 0.28, 1.0);
	if (app.selected_tab == ROSEVIZ_TAB_ALL) {
		all_col = color_new(0.72, 0.72, 0.78, 1.0);
	};
	roseviz_add_rect(&fill_cpu, all_rect.x, all_rect.y, all_rect.w, all_rect.h, all_col);

	let image_border = color_new(0.36, 0.38, 0.45, 1.0);
	let points_border = color_new(0.36, 0.38, 0.45, 1.0);
	if (app.selected_tile == ROSEVIZ_TILE_IMAGE) {
		image_border = color_new(1.0, 0.82, 0.33, 1.0);
	};
	if (app.selected_tile == ROSEVIZ_TILE_POINTS) {
		points_border = color_new(1.0, 0.82, 0.33, 1.0);
	};

	roseviz_add_outline(&line_cpu, sidebar.x, sidebar.y, sidebar.w, sidebar.h, color_new(0.22, 0.24, 0.28, 1.0));
	roseviz_add_outline(&line_cpu, bottom.x, bottom.y, bottom.w, bottom.h, color_new(0.22, 0.24, 0.28, 1.0));
	roseviz_add_outline(&line_cpu, image_rect.x, image_rect.y, image_rect.w, image_rect.h, image_border);
	roseviz_add_outline(&line_cpu, points_rect.x, points_rect.y, points_rect.w, points_rect.h, points_border);

	let fill_gpu = util_color_upload(&fill_cpu);
	let line_gpu = util_color_upload(&line_cpu);
	let fill_pass = util_color_pass_init();
	let line_pass = util_color_pass_init();
	util_color_pass_add(&fill_pass, &fill_gpu, 1.0);
	util_color_pass_add(&line_pass, &line_gpu, 2.0);

	e2_pass_begin(rt, color_new(0.06, 0.07, 0.09, 1.0));
	e2_pass_2d_geom(rt, fill_pass.draws[0z..(fill_pass.count: size)]);
	if (app.image_ready) {
		e2_pass_2d_texture(rt, &app.image_tex,
			image_fit.x, image_fit.y, image_fit.w, image_fit.h);
	};
	if (app.cloud_ready) {
		e2_pass_2d_texture(rt, &app.cloud_tex,
			points_rect.x + 1, points_rect.y + 1,
			points_rect.w - 2, points_rect.h - 2);
	};
	e2_pass_2d_lines(rt, line_pass.draws[0z..(line_pass.count: size)]);
	e2_pass_end(rt);

	e2_gpu_color_destroy(&fill_gpu);
	e2_gpu_color_destroy(&line_gpu);

	roseviz_draw_sidebar_text(rt, app);
	roseviz_draw_bottom_text(rt, app, wh);
	roseviz_draw_tile_text(rt, &image_rect, &points_rect);
};
