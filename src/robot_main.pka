// robot_main.pka — Rover simulator with mounted RGB/depth camera.

use args;
use fb;
use strings;

fn topic_rgb_message_bytes(width: i32, height: i32, channels: i32) i32 = {
	let payload = width * height * channels;
	return payload + 4096;
};

fn topic_depth_message_bytes(width: i32, height: i32) i32 = {
	let payload = width * height * 4;
	return payload + 4096;
};

fn publish_sensor_topics(sensor_view: *CameraView) bool = {
	if (mj_shim_ros_render_publish_rgb(
		&sensor_view.sensor.rgb[0z],
		sensor_view.sensor.width,
		sensor_view.sensor.height,
		3) != 0) {
		return false;
	};
	if (mj_shim_ros_render_publish_depth(
		&sensor_view.sensor.depth[0z],
		sensor_view.sensor.width,
		sensor_view.sensor.height) != 0) {
		return false;
	};
	return true;
};

fn try_load_model(path: str) bool = {
	let path_u8 = strings::toutf8(path);
	return mj_shim_load(path_u8.data) == 0;
};

fn load_default_rover() bool = {
	if (try_load_model("trellis/examples/four_wheel_robot.xml")) {
		return true;
	};
	if (try_load_model("../trellis/examples/four_wheel_robot.xml")) {
		return true;
	};
	return false;
};

type RobotSimCli = struct {
	model_path: str,
	render_fps: i32,
	physics_hz: i32,
	valid: bool,
	show_help: bool,
};

fn robot_sim_usage() void = {
	fb::Printsln("usage: robot_sim [--terminal] [--half-cell] [--term-lines]");
	fb::Printsln("                 [--render-fps FPS] [--physics-hz HZ] [model.xml]");
	fb::Printsln("defaults: render-fps=30, physics-hz=1000");
};

fn robot_sim_is_flag(arg: str) bool = {
	let data = strings::toutf8(arg);
	return data.len >= 1z && data[0z] == ('-': u8);
};

fn robot_sim_parse_i32(arg: str) i32 = {
	let data = strings::toutf8(arg);
	if (data.len == 0z) { return 0; };
	let out: i32 = 0;
	for (let i: size = 0z; i < data.len; i += 1z) {
		let ch = data[i];
		if (ch < ('0': u8) || ch > ('9': u8)) {
			return 0;
		};
		out = (out * 10) + ((ch - ('0': u8)): i32);
	};
	return out;
};

fn robot_sim_parse_cli() RobotSimCli = {
	let cfg = RobotSimCli {
		model_path = "",
		render_fps = 30,
		physics_hz = 1000,
		valid = true,
		show_help = false,
	};
	let argc = args::Count();
	for (let i: i32 = 1; i < argc; i += 1) {
		let arg = args::At(i);
		if (arg == "--help") {
			cfg.show_help = true;
			return cfg;
		};
		if (arg == "--terminal" || arg == "--half-cell" ||
			arg == "--term-lines" || arg == "--debug-ros-rate") {
			continue;
		};
		if (arg == "--render-fps" || arg == "--fps" || arg == "--physics-hz") {
			if (i + 1 >= argc) {
				cfg.valid = false;
				return cfg;
			};
			i = i + 1;
			let value = robot_sim_parse_i32(args::At(i));
			if (value <= 0) {
				cfg.valid = false;
				return cfg;
			};
			if (arg == "--physics-hz") {
				cfg.physics_hz = value;
			} else {
				cfg.render_fps = value;
			};
			continue;
		};
		if (!robot_sim_is_flag(arg) && cfg.model_path == "") {
			cfg.model_path = arg;
			continue;
		};
		cfg.valid = false;
		return cfg;
	};
	return cfg;
};

fn body_frame_from_snapshot(pos: []f32, rot: []f32) Mat4 = {
	let m = mat4_identity();
	m.d[0z] = rot[0z];
	m.d[1z] = rot[3z];
	m.d[2z] = rot[6z];
	m.d[4z] = rot[1z];
	m.d[5z] = rot[4z];
	m.d[6z] = rot[7z];
	m.d[8z] = rot[2z];
	m.d[9z] = rot[5z];
	m.d[10z] = rot[8z];
	m.d[12z] = pos[0z];
	m.d[13z] = pos[1z];
	m.d[14z] = pos[2z];
	m.d[15z] = 1.0;
	return m;
};

def ROBOT_STATIC_PBR_MAX: size = 2z;

type StaticPbrObject = struct {
	mesh: E2GpuMesh,
	albedo: E2GpuTexture,
	normal: E2GpuTexture,
	orm: E2GpuTexture,
	model: Mat4,
	material: Material,
	valid: bool,
};

type StaticPbrSet = struct {
	objects: [ROBOT_STATIC_PBR_MAX]StaticPbrObject,
};

fn static_pbr_object_empty() StaticPbrObject = {
	return StaticPbrObject {
		mesh = E2GpuMesh { vbo = 0, ibo = 0, wire_ibo = 0,
			index_count = 0, wire_index_count = 0, valid = false },
		albedo = E2GpuTexture { handle = 0u32, width = 0, height = 0, valid = false },
		normal = E2GpuTexture { handle = 0u32, width = 0, height = 0, valid = false },
		orm = E2GpuTexture { handle = 0u32, width = 0, height = 0, valid = false },
		model = mat4_identity(),
		material = material_pbr(color_white(), 1.0, 1.0),
		valid = false,
	};
};

fn static_pbr_model(tx: f32, ty: f32, tz: f32,
	yaw_deg: f32, scale: f32) Mat4 = {
	let t = mat4_translate(tx, ty, tz);
	let r = mat4_rotate_z(yaw_deg);
	let s = mat4_scale(scale, scale, scale);
	let rs = mat4_mul(&r, &s);
	return mat4_mul(&t, &rs);
};

fn static_pbr_load(obj_path: str, albedo_path: str,
	normal_path: str, orm_path: str, model: Mat4) StaticPbrObject = {
	let out = static_pbr_object_empty();
	let obj_u8 = strings::toutf8(obj_path);
	out.mesh = util_mesh_load_obj_upload(obj_u8.data);
	if (!out.mesh.valid) {
		return out;
	};

	let mat = material_pbr(color_white(), 1.0, 1.0);
	let albedo_u8 = strings::toutf8(albedo_path);
	out.albedo = e2_gpu_texture_load_png_rgba(albedo_u8.data);
	if (out.albedo.valid) {
		mat.texture = out.albedo.handle;
	};

	let normal_u8 = strings::toutf8(normal_path);
	out.normal = e2_gpu_texture_load_png_rgb(normal_u8.data);
	if (out.normal.valid) {
		mat.normal_texture = out.normal.handle;
	};

	let orm_u8 = strings::toutf8(orm_path);
	out.orm = e2_gpu_texture_load_png_rgb(orm_u8.data);
	if (out.orm.valid) {
		mat.orm_texture = out.orm.handle;
	};

	out.model = model;
	out.material = mat;
	out.valid = true;
	return out;
};

fn static_pbr_set_empty() StaticPbrSet = {
	return StaticPbrSet {
		objects = [static_pbr_object_empty()...],
	};
};

fn static_pbr_load_rover_scene() StaticPbrSet = {
	let set = static_pbr_set_empty();
	set.objects[0z] = static_pbr_load(
		"assets/rover_scene/rock_a.obj",
		"assets/rover_scene/rock_a_albedo.png",
		"assets/rover_scene/rock_a_normal.png",
		"assets/rover_scene/rock_a_orm.png",
		static_pbr_model(1.8, 1.8, 0.18, -18.0, 0.75));
	set.objects[1z] = static_pbr_load(
		"assets/rover_scene/prop_b.obj",
		"assets/rover_scene/prop_b_albedo.png",
		"assets/rover_scene/prop_b_normal.png",
		"assets/rover_scene/prop_b_orm.png",
		static_pbr_model(-1.7, 2.6, 0.20, 34.0, 0.85));
	return set;
};

fn static_pbr_add_to_pass(set: *StaticPbrSet, buf: *E2GeomPassBuffer) void = {
	for (let i: size = 0z; i < ROBOT_STATIC_PBR_MAX; i += 1z) {
		if (set.objects[i].valid && set.objects[i].mesh.valid) {
			util_geom_pass_add(buf, &set.objects[i].mesh,
				set.objects[i].model, set.objects[i].material);
		};
	};
};

fn static_pbr_destroy(set: *StaticPbrSet) void = {
	for (let i: size = 0z; i < ROBOT_STATIC_PBR_MAX; i += 1z) {
		if (set.objects[i].albedo.valid) { e2_gpu_texture_destroy(&set.objects[i].albedo); };
		if (set.objects[i].normal.valid) { e2_gpu_texture_destroy(&set.objects[i].normal); };
		if (set.objects[i].orm.valid) { e2_gpu_texture_destroy(&set.objects[i].orm); };
		if (set.objects[i].mesh.valid) { e2_gpu_mesh_destroy(&set.objects[i].mesh); };
		set.objects[i].valid = false;
	};
};

export fn main() void = {
	let cli = robot_sim_parse_cli();
	if (cli.show_help || !cli.valid) {
		robot_sim_usage();
		return;
	};

	let mode = E2_MODE_WINDOW;
	if (args::Has("--terminal")) {
		mode = E2_MODE_TERMINAL;
	};

	let model_path = cli.model_path;
	let loaded = false;
	if (model_path != "") {
		loaded = try_load_model(model_path);
	} else {
		loaded = load_default_rover();
	};
	if (!loaded) {
		robot_sim_usage();
		return;
	};

	let requested_timestep = 1.0f64 / (cli.physics_hz: f64);
	if (mj_shim_set_timestep(requested_timestep) != 0) {
		fb::Printsln("warning: failed to set MuJoCo timestep");
	};

	let control_topic = strings::toutf8("/control");
	let left_name = strings::toutf8("rear_right_wheel");
	let right_name = strings::toutf8("rear_left_wheel");
	if (mj_shim_configure_tank_controls(
		control_topic.data,
		left_name.data,
		right_name.data,
		0.3) != 0) {
		fb::Printsln("warning: tank actuator mapping not resolved");
	};

	let rt = e2_runtime_init(mode, 800, 600);
	if (args::Has("--half-cell")) {
		rt.term_style = E2_TERM_HALF_CELL;
	};
	if (args::Has("--term-lines")) {
		rt.term_present_mode = E2_TERM_PRESENT_LINES;
	};
	rt.target_fps = 0;
	if (!e2_runtime_start(&rt)) {
		fb::Printsln("engine start failed");
		mj_shim_free();
		return;
	};
	if (!e2_init_blit_shader()) {
		fb::Printsln("warning: blit shader init failed");
	};

	let rgb_topic = strings::toutf8("/simulator/rgb");
	let depth_topic = strings::toutf8("/simulator/depth");
	let imu_topic = strings::toutf8("/simulator/imu");
	let vio_topic = strings::toutf8("/simulator/vio");
	let render_node = strings::toutf8("simulator");
	let sensor_w: i32 = 128;
	let sensor_h: i32 = 96;
	let rgb_message_bytes = topic_rgb_message_bytes(sensor_w, sensor_h, 3);
	let depth_message_bytes = topic_depth_message_bytes(sensor_w, sensor_h);
	if (mj_shim_ros_render_init(
		render_node.data,
		rgb_topic.data,
		depth_topic.data,
		rgb_message_bytes,
		depth_message_bytes,
		64) != 0) {
		fb::Printsln("warning: ROS3 render publishers unavailable");
	};
	if (mj_shim_ros_motion_init(
		render_node.data,
		imu_topic.data,
		vio_topic.data,
		1024,
		1024,
		cli.physics_hz,
		30) != 0) {
		fb::Printsln("warning: ROS3 motion publishers unavailable");
	};

	let sc = scene_new();
	scene_init(&sc);
	let static_objects = static_pbr_load_rover_scene();

	let line_cpu = util_cpu_color_buffer_init();
	util_lines_add_grid(&line_cpu, 8.0, 32, color_gray(0.20));
	util_lines_add_axes(&line_cpu, 0.75);
	let line_gpu = util_color_upload(&line_cpu);

	let geom_pass = util_geom_pass_init();
	let line_pass = util_color_pass_init();
	let lights = util_light_buffer_init();
	let env = env_default();
	let bg_color = color_new(0.93, 0.78, 0.28, 1.0);
	env.sky_color = color_new(0.78, 0.42, 0.24, 1.0);
	env.horizon_color = color_new(0.86, 0.56, 0.29, 1.0);
	env.ground_color = color_new(0.42, 0.18, 0.12, 1.0);
	env.specular_color = color_new(0.98, 0.78, 0.45, 1.0);
	env.intensity = 1.05;

	let cam = camera_default();
	cam.distance = 6.0;
	cam.yaw = 55.0;
	cam.pitch = 28.0;
	cam.target = vec3_new(0.0, 0.0, 0.9);

	let sensor_view = camera_view_new(
			vec3_new(0.0, -2.0, 1.4),
			vec3_new(0.0, 0.0, 0.8),
			70.0, 0.05, 20.0,
			sensor_w, sensor_h,
			520, 16,
			256, 192,
			CAMVIEW_MODE_RGB);

	let frame_name = strings::toutf8("frame");
	let frame_body_id = mj_shim_body_id(frame_name.data);
	let sensor_eye_local = vec3_new(0.0, 0.45, 0.20);
	let sensor_target_local = vec3_new(0.0, 1.45, 0.12);
	let body_pos: [3]f32 = [0.0...];
	let body_rot: [9]f32 = [0.0...];
	let sim_time: f64 = 0.0;
	let frame_ms: f64 = 0.0;
	let render_fps = cli.render_fps;
	let render_period_s: f64 = 1.0f64 / (render_fps: f64);
	let sensor_pub_period_s = render_period_s;
	let sensor_pub_last_tick: u64 = rose_now();
	let physics_step_s: f64 = mj_shim_timestep();
	if (physics_step_s <= 0.0) {
		physics_step_s = 1.0f64 / (cli.physics_hz: f64);
	};
	let sim_start_time = mj_shim_time();
	let realtime_start_tick = rose_now();
	let next_render_sim_time = sim_start_time;
	let debug_ros_rate = args::Has("--debug-ros-rate");
	let debug_last_tick: u64 = realtime_start_tick;
	let debug_render_count: i32 = 0;
	let debug_physics_steps: i32 = 0;
	let debug_sensor_ok_count: i32 = 0;
	let debug_publish_count: i32 = 0;
	let debug_ok_ms: f64 = 0.0;
	let debug_spin_ms: f64 = 0.0;
	let debug_sensor_ms: f64 = 0.0;
	let debug_publish_ms: f64 = 0.0;

	for (e2_runtime_should_run(&rt)) {
		let ros_ok_tick = rose_now();
		if (mj_shim_ros_ok() == 0) {
			break;
		};
		debug_ok_ms = debug_ok_ms + rose_elapsed_seconds(ros_ok_tick) * 1000.0f64;

		let ros_spin_tick = rose_now();
		mj_shim_ros_spin_once();
		debug_spin_ms = debug_spin_ms + rose_elapsed_seconds(ros_spin_tick) * 1000.0f64;

		let wall_elapsed_s = rose_elapsed_seconds(realtime_start_tick);
		let target_sim_time = sim_start_time + wall_elapsed_s;
		let step_count: i32 = 0;
		for (mj_shim_time() + (physics_step_s * 0.5f64) < target_sim_time) {
			mj_shim_step();
			step_count = step_count + 1;
			debug_physics_steps = debug_physics_steps + 1;
			if (step_count % 64 == 0) {
				mj_shim_ros_spin_once();
			};
		};

		sim_time = mj_shim_time();
		if (sim_time + 0.000001f64 < next_render_sim_time) {
			let next_step_sim_time = sim_time + physics_step_s;
			let wake_sim_time = next_step_sim_time;
			if (next_render_sim_time < wake_sim_time) {
				wake_sim_time = next_render_sim_time;
			};
			let wake_wall_s = wake_sim_time - sim_start_time;
			let sleep_s = wake_wall_s - rose_elapsed_seconds(realtime_start_tick);
			if (sleep_s > 0.0) {
				rose_sleep(sleep_s);
			};
			continue;
		};
		for (next_render_sim_time <= sim_time) {
			next_render_sim_time = next_render_sim_time + render_period_s;
		};

		let t0_tick = rose_now();
		e2_runtime_begin_frame(&rt);
		debug_render_count = debug_render_count + 1;
		camera_view_layout_top_right(&sensor_view, &rt, 16, 0.28, 0.32);

		util_camera_apply_orbit_controls(&cam, &rt.input, rt.mode == E2_MODE_TERMINAL);
		if (input_key_just_pressed(&rt.input, KEY_D)) {
			if (sensor_view.mode == CAMVIEW_MODE_DEPTH) {
				sensor_view.mode = CAMVIEW_MODE_RGB;
			} else {
				sensor_view.mode = CAMVIEW_MODE_DEPTH;
			};
		};

		mj_shim_snapshot_begin();
		sim_time = mj_shim_time();
		if (frame_body_id >= 0) {
			mj_shim_body_pos(frame_body_id, &body_pos[0z]);
			mj_shim_body_mat(frame_body_id, &body_rot[0z]);
			let frame_mat = body_frame_from_snapshot(body_pos[0z..3z], body_rot[0z..9z]);
			let sensor_eye = mat4_transform_point(&frame_mat, sensor_eye_local);
			let sensor_target = mat4_transform_point(&frame_mat, sensor_target_local);
			let frame_target = vec3_new(body_pos[0z], body_pos[1z], body_pos[2z]);
			camera_view_set_pose(&sensor_view, sensor_eye, sensor_target);
			cam.target = vec3_lerp(cam.target, frame_target, 0.08);
		};
		scene_update(&sc);
		mj_shim_snapshot_end();

		scene_geom_pass(&sc, &geom_pass);
		static_pbr_add_to_pass(&static_objects, &geom_pass);

		util_color_pass_clear(&line_pass);
		util_color_pass_add(&line_pass, &line_gpu, 1.0);

		let sensor_tick = rose_now();
		let sensor_ok = camera_view_render_bg(
			&sensor_view,
			geom_pass.draws[0z..(geom_pass.count: size)],
			util_light_buffer_slice(&lights),
			&env,
			bg_color);
		debug_sensor_ms = debug_sensor_ms + rose_elapsed_seconds(sensor_tick) * 1000.0f64;
		let sensor_ros_now = rose_now();
		let sensor_pub_elapsed_s = rose_seconds(sensor_ros_now, sensor_pub_last_tick);
		if (sensor_ok) {
			debug_sensor_ok_count = debug_sensor_ok_count + 1;
		};
		if (sensor_ok && sensor_pub_elapsed_s >= sensor_pub_period_s) {
			let publish_tick = rose_now();
			if (publish_sensor_topics(&sensor_view)) {
				sensor_pub_last_tick = sensor_ros_now;
				debug_publish_count = debug_publish_count + 1;
			};
			debug_publish_ms = debug_publish_ms + rose_elapsed_seconds(publish_tick) * 1000.0f64;
		};
		let sensor_now_tick = rose_now();
		if (debug_ros_rate && rose_seconds(sensor_now_tick, debug_last_tick) >= 1.0f64) {
			let dbuf: [192]u8 = [0...];
			let dfmt = fb::New(dbuf[0z..192z]);
			fb::Write(&dfmt, "robot_sim rate renders=");
			fb::Wi64(&dfmt, debug_render_count: i64);
			fb::Write(&dfmt, " physics_steps=");
			fb::Wi64(&dfmt, debug_physics_steps: i64);
			fb::Write(&dfmt, " sensor_ok=");
			fb::Wi64(&dfmt, debug_sensor_ok_count: i64);
			fb::Write(&dfmt, " publishes=");
			fb::Wi64(&dfmt, debug_publish_count: i64);
			fb::Write(&dfmt, " rgb_index=");
			fb::Wi64(&dfmt, mj_shim_ros_rgb_index(): i64);
			fb::Write(&dfmt, " imu_index=");
			fb::Wi64(&dfmt, mj_shim_ros_imu_index(): i64);
			fb::Write(&dfmt, " vio_index=");
			fb::Wi64(&dfmt, mj_shim_ros_vio_index(): i64);
			fb::Write(&dfmt, " ok_ms=");
			fb::Wf64(&dfmt, debug_ok_ms, 1, "fix");
			fb::Write(&dfmt, " spin_ms=");
			fb::Wf64(&dfmt, debug_spin_ms, 1, "fix");
			fb::Write(&dfmt, " sensor_ms=");
			fb::Wf64(&dfmt, debug_sensor_ms, 1, "fix");
			fb::Write(&dfmt, " publish_ms=");
			fb::Wf64(&dfmt, debug_publish_ms, 1, "fix");
			fb::Printsln(fb::ToStr(&dfmt));
			debug_last_tick = sensor_now_tick;
			debug_render_count = 0;
			debug_physics_steps = 0;
			debug_sensor_ok_count = 0;
			debug_publish_count = 0;
			debug_ok_ms = 0.0;
			debug_spin_ms = 0.0;
			debug_sensor_ms = 0.0;
			debug_publish_ms = 0.0;
		};

		e2_pass_begin(&rt, bg_color);
		let free_cam = util_camera_free_from_orbit(&cam);
		e2_pass_3d_geom(&rt, &free_cam, E2_GEOM_MODE_PBR,
			geom_pass.draws[0z..(geom_pass.count: size)],
			util_light_buffer_slice(&lights), &env);
		e2_pass_3d_lines(&rt, &free_cam, line_pass.draws[0z..(line_pass.count: size)]);
		if (sensor_ok) {
			camera_view_draw(&sensor_view, &rt);
		};
		e2_pass_end(&rt);

		util_text_add_fps(&rt, frame_ms, 0.01, 0.01);
		let tbuf: [96]u8 = [0...];
		let tfmt = fb::New(tbuf[0z..96z]);
		fb::Write(&tfmt, "sim ");
		fb::Wf64(&tfmt, sim_time, 2, "fix");
		fb::Write(&tfmt, "s camera ");
		if (sensor_view.mode == CAMVIEW_MODE_DEPTH) {
			fb::Write(&tfmt, "depth");
		} else {
			fb::Write(&tfmt, "rgb");
		};
		e2_text_add(&rt, 0.01, 0.05, fb::ToStr(&tfmt), 255, 255, 255);
		e2_pass_text(&rt);

		let pre_present_ms = rose_elapsed_seconds(t0_tick) * 1000.0f64;
		e2_runtime_present(&rt);
		if (rt.mode == E2_MODE_TERMINAL) {
			frame_ms = pre_present_ms + rt.last_term_draw_ms;
		} else {
			frame_ms = rose_elapsed_seconds(t0_tick) * 1000.0f64;
		};
	};

	camera_view_destroy(&sensor_view);
	static_pbr_destroy(&static_objects);
	scene_destroy(&sc);
	e2_gpu_color_destroy(&line_gpu);
	mj_shim_free();
	e2_runtime_shutdown(&rt);
};
