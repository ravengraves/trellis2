// roseviz_main.pka — Windowed roseviz shell scaffold for images + point clouds.

use fmt;
use clock;

@symbol("shim_has_arg") fn shim_has_arg(flag: *u8) i32;

export fn main() void = {
	let term_flag: [11]u8 = ['-', '-', 't', 'e', 'r', 'm', 'i', 'n', 'a', 'l', 0];
	let half_cell_flag: [12]u8 = ['-', '-', 'h', 'a', 'l', 'f', '-', 'c', 'e', 'l', 'l', 0];
	let term_lines_flag: [13]u8 = ['-', '-', 't', 'e', 'r', 'm', '-', 'l', 'i', 'n', 'e', 's', 0];
	let smoke_flag: [8]u8 = ['-', '-', 's', 'm', 'o', 'k', 'e', 0];
	let mode = E2_MODE_WINDOW;
	if (shim_has_arg(&term_flag[0z]) != 0) {
		mode = E2_MODE_TERMINAL;
	};
	let smoke = shim_has_arg(&smoke_flag[0z]) != 0;

	let rt = e2_runtime_init(mode, 1280, 800);
	if (shim_has_arg(&half_cell_flag[0z]) != 0) {
		rt.term_style = E2_TERM_HALF_CELL;
	};
	if (shim_has_arg(&term_lines_flag[0z]) != 0) {
		rt.term_present_mode = E2_TERM_PRESENT_LINES;
	};
	rt.target_fps = 30;
	if (!e2_runtime_start(&rt)) {
		fmt::Printsln("roseviz: engine start failed");
		return;
	};
	if (!e2_init_blit_shader()) {
		fmt::Printsln("roseviz: blit shader init failed");
		e2_runtime_shutdown(&rt);
		return;
	};

	let app = RosevizApp {
		selected_tab = 0,
		selected_tile = 0,
		last_image_tab = -1,
		image_tex = E2GpuTexture { handle = 0u32, width = 0, height = 0, valid = false },
		image_rgb = [0...],
		image_ready = false,
		cloud_tex = E2GpuTexture { handle = 0u32, width = 0, height = 0, valid = false },
		cloud_rgb = [0...],
		cloud_depth = [0.0...],
		cloud_ready = false,
		cloud_points = E2GpuColorBuffer { vbo = 0u32, vertex_count = 0, valid = false },
		cloud_cam = camera_default(),
	};
	if (!roseviz_app_init(&app)) {
		fmt::Printsln("roseviz: init failed");
		e2_runtime_shutdown(&rt);
		return;
	};

	let frame_ms: f64 = 0.0;
	let frames: i32 = 0;
	for (e2_runtime_should_run(&rt)) {
		let t0 = clock::Now();
		e2_runtime_begin_frame(&rt);
		roseviz_handle_input(&app, &rt);
		roseviz_render_frame(&rt, &app);
		util_text_add_fps(&rt, frame_ms, 0.92, 0.01);
		e2_pass_text(&rt);
		e2_runtime_present(&rt);
		frame_ms = clock::Since(t0) * 1000.0f64;
		frames = frames + 1;
		if (smoke && frames >= 2) {
			rt.running = false;
		};
	};

	roseviz_app_shutdown(&app);
	e2_runtime_shutdown(&rt);
};
