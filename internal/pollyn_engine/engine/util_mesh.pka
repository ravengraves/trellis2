// util_mesh.pka — Geometry and mesh helpers for engine userspace.

@symbol("shim_gl_load_obj_upload")
fn shim_gl_load_obj_upload(path: *u8, target_triangles: i32,
	out_vbo: *u32, out_ibo: *u32, out_wire_ibo: *u32,
	out_index_count: *i32, out_wire_index_count: *i32) i32;

def UTIL_OBJ_UPLOAD_TRIANGLES: i32 = 20000;

export fn util_mesh_upload(mesh: *Mesh) E2GpuMesh = {
	let vf: size = (mesh.vert_count * VERT_STRIDE): size;
	let ifc: size = mesh.index_count: size;
	let verts = mesh.verts[0z..vf];
	let inds = mesh.indices[0z..ifc];
	return e2_gpu_mesh_create(verts, inds);
};

export fn util_mesh_load_stl_upload(path: *u8, target_triangles: i32) E2GpuMesh = {
	let m = mesh_load_stl_decimated(path, target_triangles);
	return util_mesh_upload(&m);
};

export fn util_mesh_load_obj_upload(path: *u8) E2GpuMesh = {
	let vbo: u32 = 0u32;
	let ibo: u32 = 0u32;
	let wire_ibo: u32 = 0u32;
	let index_count: i32 = 0;
	let wire_index_count: i32 = 0;
	if (shim_gl_load_obj_upload(path, UTIL_OBJ_UPLOAD_TRIANGLES,
		&vbo, &ibo, &wire_ibo, &index_count, &wire_index_count) != 0) {
		return E2GpuMesh { vbo = 0u32, ibo = 0u32, wire_ibo = 0u32,
			index_count = 0, wire_index_count = 0, valid = false };
	};
	return E2GpuMesh {
		vbo = vbo,
		ibo = ibo,
		wire_ibo = wire_ibo,
		index_count = index_count,
		wire_index_count = wire_index_count,
		valid = (vbo != 0u32 && ibo != 0u32),
	};
};

export fn util_color_upload(buf: *E2CpuColorVertexBuffer) E2GpuColorBuffer = {
	let s = util_cpu_color_buffer_slice(buf);
	return e2_gpu_color_create(s);
};

export fn util_lines_add_axes(buf: *E2CpuColorVertexBuffer, length: f32) void = {
	util_cpu_color_buffer_add_line(buf,
		vec3_zero(), vec3_new(length, 0.0, 0.0), color_blue());
	util_cpu_color_buffer_add_line(buf,
		vec3_zero(), vec3_new(0.0, length, 0.0), color_red());
	util_cpu_color_buffer_add_line(buf,
		vec3_zero(), vec3_new(0.0, 0.0, length), color_green());
};

export fn util_lines_add_grid(buf: *E2CpuColorVertexBuffer,
	grid_size: f32, divisions: i32, c: Color) void = {
	let half = grid_size * 0.5;
	let step = grid_size / (divisions: f32);
	for (let gi: i32 = 0; gi <= divisions; gi += 1) {
		let gpos = -half + (gi: f32) * step;
		util_cpu_color_buffer_add_line(buf,
			vec3_new(-half, gpos, 0.0),
			vec3_new(half, gpos, 0.0), c);
		util_cpu_color_buffer_add_line(buf,
			vec3_new(gpos, -half, 0.0),
			vec3_new(gpos, half, 0.0), c);
	};
};
