// util_text.pka — Text helpers for engine.

use fb;

export fn util_text_add_fps(rt: *E2Runtime, frame_ms: f64,
	x_frac: f32, y_frac: f32) void = {
	let tbuf: [64]u8 = [0...];
	let tfmt = fb::New(tbuf[0z..64z]);
	fb::Write(&tfmt, "r ");
	fb::Wi64(&tfmt, frame_ms: i64);
	fb::Write(&tfmt, "ms");
	if (rt.mode == E2_MODE_TERMINAL) {
		fb::Write(&tfmt, " d ");
		fb::Wf64(&tfmt, rt.last_term_draw_ms, 2, "fix");
		fb::Write(&tfmt, "ms ");
		fb::Wi64(&tfmt, rt.last_term_changed_cells: i64);
		fb::Write(&tfmt, "/");
		fb::Wi64(&tfmt, rt.last_term_total_cells: i64);
	};
	e2_text_add(rt, x_frac, y_frac, fb::ToStr(&tfmt), 255, 255, 0);
};
