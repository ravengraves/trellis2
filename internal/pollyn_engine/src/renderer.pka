// ================================================================
// Shared constants (used by engine.pka Scene as well)
// ================================================================

export def REND_MAX_INSTANCES: size = 128z;
export def REND_MAX_LINE_VERTS: size = 1024z;

// ================================================================
// Render instance: a mesh + transform + color
// ================================================================

export type RenderInstance = struct {
	mesh: *Mesh,
	model: Mat4,
	color: Color,
	mat: Material,
};

// GPU-handle instance. Prefer this over RenderInstance for hot paths: geometry
// is already resident in VBO/IBO handles, so only uniforms/model matrices change.
export type RenderGpuInstance = struct {
	vbo: u32,
	ibo: u32,
	index_count: i32,
	model: Mat4,
	color: Color,
	mat: Material,
};

// ================================================================
// Light
// ================================================================

export type Light = struct {
	position: Vec3,
	direction: Vec3,
	color: Color,
	directional: bool,
};

export fn light_directional(dir: Vec3, col: Color) Light = {
	return Light {
		position = vec3_zero(),
		direction = vec3_normalize(dir),
		color = col,
		directional = true
	};
};

export fn light_point(pos: Vec3, col: Color) Light = {
	return Light {
		position = pos,
		direction = vec3_zero(),
		color = col,
		directional = false
	};
};

// ================================================================
// GPU-accelerated 3D rendering (all modes)
// ================================================================

export type LineVertex3D = struct {
	pos: Vec3,
	color: Color,
	thickness: f32,
};

export def REND_PBR_MAX_LIGHTS: size = 4z;
export def REND_PBR_LIGHT_STRIDE: size = 12z;
export def REND_PBR_LIGHT_FLOATS: size = REND_PBR_MAX_LIGHTS * REND_PBR_LIGHT_STRIDE;

def ENV_PACK_SIZE: size = 15z;

fn render_pack_pbr_light(dst: []f32,
	slot: i32, l: Light) void = {
	if (slot < 0 || slot >= (REND_PBR_MAX_LIGHTS: i32)) { return; };
	let base: size = (slot: size) * REND_PBR_LIGHT_STRIDE;
	dst[base] = l.position.x;
	dst[base + 1z] = l.position.y;
	dst[base + 2z] = l.position.z;
	if (l.directional) {
		dst[base + 3z] = 1.0;
	} else {
		dst[base + 3z] = 0.0;
	};
	dst[base + 4z] = l.direction.x;
	dst[base + 5z] = l.direction.y;
	dst[base + 6z] = l.direction.z;
	dst[base + 7z] = 0.0;
	dst[base + 8z] = l.color.r;
	dst[base + 9z] = l.color.g;
	dst[base + 10z] = l.color.b;
	dst[base + 11z] = 0.0;
};

export fn render_pack_pbr_lights(lights: []Light,
	out: []f32) i32 = {
	for (let i: size = 0z; i < REND_PBR_LIGHT_FLOATS; i += 1z) {
		out[i] = 0.0;
	};
	let count: i32 = lights.len: i32;
	if (count > (REND_PBR_MAX_LIGHTS: i32)) {
		count = REND_PBR_MAX_LIGHTS: i32;
	};
	for (let i: i32 = 0; i < count; i += 1) {
		render_pack_pbr_light(out, i, lights[i: size]);
	};
	return count;
};

fn render_pack_env(env: *IrradianceEnv, out: []f32) void = {
	out[0z] = env.sky_color.r;
	out[1z] = env.sky_color.g;
	out[2z] = env.sky_color.b;
	out[3z] = env.ground_color.r;
	out[4z] = env.ground_color.g;
	out[5z] = env.ground_color.b;
	out[6z] = env.horizon_color.r;
	out[7z] = env.horizon_color.g;
	out[8z] = env.horizon_color.b;
	out[9z] = env.specular_color.r;
	out[10z] = env.specular_color.g;
	out[11z] = env.specular_color.b;
	out[12z] = env.intensity;
	out[13z] = env.ibl_diffuse_mix;
	out[14z] = env.ibl_specular_mix;
};

// Legacy CPU mesh path. This uploads mesh vertex/index data during every draw.
// Prefer render_gpu_instances() or e2_pass_3d_geom() for normal rendering.
export fn render_instances(instances: *[REND_MAX_INSTANCES]RenderInstance,
                           count: i32, mvp_base: *Mat4,
                           light: Light, cam_eye: Vec3,
                           env: *IrradianceEnv) void = {
	// Pack environment into float array for shim
	let env_data: [ENV_PACK_SIZE]f32 = [0.0...];
	render_pack_env(env, env_data[0z..ENV_PACK_SIZE]);
	let light_data: [REND_PBR_LIGHT_FLOATS]f32 = [0.0...];
	render_pack_pbr_light(light_data[0z..REND_PBR_LIGHT_FLOATS], 0, light);

	let inst_i: i32 = 0;
	for (inst_i < count) {
		let sidx: size = inst_i: size;
		let inst = &instances[sidx];
		let full_mvp = mat4_mul(mvp_base, &inst.model);
		let mesh = inst.mesh;

		if (inst.mat.shading == SHADE_PBR) {
			let eye = cam_eye;
			shim_gl_begin_pbr(&full_mvp.d[0z], &inst.model.d[0z],
				light.direction.x, light.direction.y, light.direction.z,
				light.color.r, light.color.g, light.color.b,
				eye.x, eye.y, eye.z,
				inst.mat.albedo.r, inst.mat.albedo.g, inst.mat.albedo.b,
				inst.mat.metallic, inst.mat.roughness,
				&env_data[0z], inst.mat.albedo.a);
			shim_gl_set_pbr_lights(&light_data[0z], 1);
			shim_gl_set_pbr_ibl_textures(env.ibl_global_tex, env.ibl_global_blur_tex,
				env.ibl_local_tex, env.ibl_local_blur_tex);
		} else {
			shim_gl_begin_flat(&full_mvp.d[0z], &inst.model.d[0z],
				light.direction.x, light.direction.y, light.direction.z,
				light.color.r, light.color.g, light.color.b,
				inst.color.r, inst.color.g, inst.color.b, inst.color.a);
		};
		shim_gl_set_material_textures(inst.mat.texture, inst.mat.orm_texture,
			inst.mat.normal_texture);

		shim_gl_draw_mesh(&mesh.verts[0z], mesh.vert_count * VERT_STRIDE,
			&mesh.indices[0z], mesh.index_count);

		inst_i = inst_i + 1;
	};
};

// Render GPU-resident mesh instances. This is the handle-based alternative to
// render_instances() and does not re-upload geometry.
export fn render_gpu_instances(instances: *[REND_MAX_INSTANCES]RenderGpuInstance,
                               count: i32, mvp_base: *Mat4,
                               light: Light, cam_eye: Vec3,
                               env: *IrradianceEnv) void = {
	let env_data: [ENV_PACK_SIZE]f32 = [0.0...];
	render_pack_env(env, env_data[0z..ENV_PACK_SIZE]);
	let light_data: [REND_PBR_LIGHT_FLOATS]f32 = [0.0...];
	render_pack_pbr_light(light_data[0z..REND_PBR_LIGHT_FLOATS], 0, light);

	let inst_i: i32 = 0;
	for (inst_i < count) {
		let sidx: size = inst_i: size;
		let inst = &instances[sidx];
		if (inst.vbo == 0u32 || inst.ibo == 0u32 || inst.index_count <= 0) {
			inst_i = inst_i + 1;
			continue;
		};
		let full_mvp = mat4_mul(mvp_base, &inst.model);

		if (inst.mat.shading == SHADE_PBR) {
			let eye = cam_eye;
			shim_gl_begin_pbr(&full_mvp.d[0z], &inst.model.d[0z],
				light.direction.x, light.direction.y, light.direction.z,
				light.color.r, light.color.g, light.color.b,
				eye.x, eye.y, eye.z,
				inst.mat.albedo.r, inst.mat.albedo.g, inst.mat.albedo.b,
				inst.mat.metallic, inst.mat.roughness,
				&env_data[0z], inst.mat.albedo.a);
			shim_gl_set_pbr_lights(&light_data[0z], 1);
			shim_gl_set_pbr_ibl_textures(env.ibl_global_tex, env.ibl_global_blur_tex,
				env.ibl_local_tex, env.ibl_local_blur_tex);
		} else {
			shim_gl_begin_flat(&full_mvp.d[0z], &inst.model.d[0z],
				light.direction.x, light.direction.y, light.direction.z,
				light.color.r, light.color.g, light.color.b,
				inst.color.r, inst.color.g, inst.color.b, inst.color.a);
		};
		shim_gl_set_material_textures(inst.mat.texture, inst.mat.orm_texture,
			inst.mat.normal_texture);
		shim_gl_draw_mesh_handles(inst.vbo, inst.ibo, inst.index_count);

		inst_i = inst_i + 1;
	};
};

// Render lines using GPU
export fn render_lines(verts: *[REND_MAX_LINE_VERTS]LineVertex3D,
                       count: i32, mvp: *Mat4) void = {
	let i: i32 = 0;
	for (i + 1 < count) {
		let v0 = &verts[i: size];
		let v1 = &verts[(i + 1): size];
		let seg: [14]f32 = [
			v0.pos.x, v0.pos.y, v0.pos.z,
			v0.color.r, v0.color.g, v0.color.b, v0.color.a,
			v1.pos.x, v1.pos.y, v1.pos.z,
			v1.color.r, v1.color.g, v1.color.b, v1.color.a
		];
		let w = v0.thickness;
		if (w < 1.0) { w = 1.0; };
		shim_gl_draw_line_segment(&seg[0z], &mvp.d[0z], w);
		i = i + 2;
	};
};

// Convenience: create FBO, render, read back pixels, destroy FBO
export fn render_to_fb(fb: *Framebuffer, instances: *[REND_MAX_INSTANCES]RenderInstance,
                       count: i32, mvp: *Mat4, light: Light, cam_eye: Vec3,
                       env: *IrradianceEnv) void = {
	shim_gl_fbo_create(fb.width, fb.height);
	shim_gl_fbo_bind();
	let bg_r: f32 = 0.0;
	let bg_g: f32 = 0.0;
	let bg_b: f32 = 0.0;
	shim_gl_clear(bg_r, bg_g, bg_b, 1.0);
	shim_gl_enable_depth();
	shim_gl_enable_blend();
	shim_gl_viewport(0, 0, fb.width, fb.height);
	render_instances(instances, count, mvp, light, cam_eye, env);
	shim_gl_disable_blend();
	shim_gl_fbo_read_pixels_flipped(&fb.pixels[0z], fb.width, fb.height);
	shim_gl_fbo_unbind();
	shim_gl_fbo_destroy();
};

// ================================================================
// Depth rendering
// ================================================================

export @symbol("shim_gl_begin_depth") fn shim_gl_begin_depth(
	mvp: *f32, model: *f32,
	ex: f32, ey: f32, ez: f32,
	znear: f32, zfar: f32) void;
export @symbol("shim_gl_fbo_read_depth_encoded") fn shim_gl_fbo_read_depth_encoded(
	out: *f32, w: i32, h: i32, znear: f32, zfar: f32) void;

// Legacy CPU mesh depth path. Prefer render_gpu_instances_depth().
export fn render_instances_depth(instances: *[REND_MAX_INSTANCES]RenderInstance,
                                  count: i32, mvp_base: *Mat4,
                                  cam_eye: Vec3,
                                  znear: f32, zfar: f32) void = {
	let di: i32 = 0;
	for (di < count) {
		let sidx: size = di: size;
		let inst = &instances[sidx];
		let full_mvp = mat4_mul(mvp_base, &inst.model);
		let mesh = inst.mesh;

		shim_gl_begin_depth(&full_mvp.d[0z], &inst.model.d[0z],
			cam_eye.x, cam_eye.y, cam_eye.z,
			znear, zfar);
		shim_gl_draw_mesh(&mesh.verts[0z], mesh.vert_count * VERT_STRIDE,
			&mesh.indices[0z], mesh.index_count);

		di = di + 1;
	};
};

// Render GPU-resident mesh instances using depth shader only.
export fn render_gpu_instances_depth(instances: *[REND_MAX_INSTANCES]RenderGpuInstance,
                                     count: i32, mvp_base: *Mat4,
                                     cam_eye: Vec3,
                                     znear: f32, zfar: f32) void = {
	let di: i32 = 0;
	for (di < count) {
		let sidx: size = di: size;
		let inst = &instances[sidx];
		if (inst.vbo == 0u32 || inst.ibo == 0u32 || inst.index_count <= 0) {
			di = di + 1;
			continue;
		};
		let full_mvp = mat4_mul(mvp_base, &inst.model);

		shim_gl_begin_depth(&full_mvp.d[0z], &inst.model.d[0z],
			cam_eye.x, cam_eye.y, cam_eye.z,
			znear, zfar);
		shim_gl_draw_mesh_handles(inst.vbo, inst.ibo, inst.index_count);

		di = di + 1;
	};
};

// Convenience: create FBO, render GPU instances, read back pixels, destroy FBO.
export fn render_gpu_to_fb(fb: *Framebuffer,
                           instances: *[REND_MAX_INSTANCES]RenderGpuInstance,
                           count: i32, mvp: *Mat4, light: Light,
                           cam_eye: Vec3, env: *IrradianceEnv) void = {
	shim_gl_fbo_create(fb.width, fb.height);
	shim_gl_fbo_bind();
	shim_gl_clear(0.0, 0.0, 0.0, 1.0);
	shim_gl_enable_depth();
	shim_gl_enable_blend();
	shim_gl_viewport(0, 0, fb.width, fb.height);
	render_gpu_instances(instances, count, mvp, light, cam_eye, env);
	shim_gl_disable_blend();
	shim_gl_fbo_read_pixels_flipped(&fb.pixels[0z], fb.width, fb.height);
	shim_gl_fbo_unbind();
	shim_gl_fbo_destroy();
};

// Convenience: create FBO, render color + depth, read back, destroy FBO
export fn render_to_fb_with_depth(fb: *Framebuffer,
    instances: *[REND_MAX_INSTANCES]RenderInstance, count: i32,
    mvp: *Mat4, light: Light, cam_eye: Vec3,
    env: *IrradianceEnv, znear: f32, zfar: f32) void = {
	// Color pass
	shim_gl_fbo_create(fb.width, fb.height);
	shim_gl_fbo_bind();
	shim_gl_clear(0.0, 0.0, 0.0, 1.0);
	shim_gl_enable_depth();
	shim_gl_enable_blend();
	shim_gl_viewport(0, 0, fb.width, fb.height);
	render_instances(instances, count, mvp, light, cam_eye, env);
	shim_gl_disable_blend();
	shim_gl_fbo_read_pixels_flipped(&fb.pixels[0z], fb.width, fb.height);
	shim_gl_fbo_unbind();
	shim_gl_fbo_destroy();

	// Depth pass
	shim_gl_fbo_create(fb.width, fb.height);
	shim_gl_fbo_bind();
	shim_gl_clear(1.0, 1.0, 1.0, 1.0);
	shim_gl_enable_depth();
	shim_gl_viewport(0, 0, fb.width, fb.height);
		render_instances_depth(instances, count, mvp, cam_eye, znear, zfar);
	shim_gl_fbo_read_depth_encoded(&fb.depth[0z], fb.width, fb.height, znear, zfar);
	shim_gl_fbo_unbind();
	shim_gl_fbo_destroy();
	fb.has_depth = true;
};

// Render a full rig (all cameras) to an array of framebuffers
export fn render_rig(fbs: *[4]Framebuffer, rig: *CameraRig,
                     scene_instances: *[REND_MAX_INSTANCES]RenderInstance,
                     inst_count: i32, light: Light,
                     env: *IrradianceEnv, with_depth: bool) void = {
	let ri: i32 = 0;
	for (ri < rig.count) {
		let ridx: size = ri: size;
		let cam = &rig.cameras[ridx];
		let fb = &fbs[ridx];
		let vp = freecam_view_projection(cam, fb.width, fb.height);
		let eye = cam.eye;

		if (with_depth) {
			render_to_fb_with_depth(fb, scene_instances, inst_count,
				&vp, light, eye, env, cam.znear, cam.zfar);
		} else {
			render_to_fb(fb, scene_instances, inst_count,
				&vp, light, eye, env);
		};

		ri = ri + 1;
	};
};

// Convenience: render instances + lines to FB (used by tests)
export fn render_to_fb_full(fb: *Framebuffer, instances: *[REND_MAX_INSTANCES]RenderInstance,
                            inst_count: i32, line_verts: *[REND_MAX_LINE_VERTS]LineVertex3D,
                            line_count: i32, mvp: *Mat4, light: Light, cam_eye: Vec3,
                            env: *IrradianceEnv) void = {
	shim_gl_fbo_create(fb.width, fb.height);
	shim_gl_fbo_bind();
	shim_gl_clear(0.0, 0.0, 0.0, 1.0);
	shim_gl_enable_depth();
	shim_gl_enable_blend();
	shim_gl_viewport(0, 0, fb.width, fb.height);
	render_instances(instances, inst_count, mvp, light, cam_eye, env);
	shim_gl_disable_blend();
	if (line_count > 0) {
		render_lines(line_verts, line_count, mvp);
	};
	shim_gl_fbo_read_pixels_flipped(&fb.pixels[0z], fb.width, fb.height);
	shim_gl_fbo_unbind();
	shim_gl_fbo_destroy();
};
