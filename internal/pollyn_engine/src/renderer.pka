export @symbol("shim_gl_clear")          fn shim_gl_clear(r: f32, g: f32, b: f32, a: f32) void;
export @symbol("shim_gl_enable_depth")   fn shim_gl_enable_depth() void;
export @symbol("shim_gl_disable_depth")  fn shim_gl_disable_depth() void;
export @symbol("shim_gl_enable_blend")   fn shim_gl_enable_blend() void;
export @symbol("shim_gl_disable_blend")  fn shim_gl_disable_blend() void;
export @symbol("shim_gl_line_width")     fn shim_gl_line_width(w: f32) void;

