	mvp: *f32, model: *f32,
	ldx: f32, ldy: f32, ldz: f32,
	lr: f32, lg: f32, lb: f32,
	cr: f32, cg: f32, cb: f32, ca: f32) void;

// PBR shader textures are bound separately:
// - material albedo/base-color texture
// - material ORM texture (AO in R, roughness in G, metallic in B)
// - material tangent-space normal texture
// - global sharp equirectangular IBL texture
// - global blurred equirectangular IBL texture
// - local sharp equirectangular IBL texture
// - local blurred equirectangular IBL texture
// Direct lights are optional and uploaded separately with `shim_gl_set_pbr_lights`.
export @symbol("shim_gl_begin_pbr") fn shim_gl_begin_pbr(
	mvp: *f32, model: *f32,
	ldx: f32, ldy: f32, ldz: f32,
	lr: f32, lg: f32, lb: f32,
	ex: f32, ey: f32, ez: f32,
	ar: f32, ag: f32, ab: f32,
	metallic: f32, roughness: f32,
	env_data: *f32, alpha: f32) void;

export @symbol("shim_gl_begin_cell") fn shim_gl_begin_cell(
	mvp: *f32, model: *f32,
	ldx: f32, ldy: f32, ldz: f32,
	lr: f32, lg: f32, lb: f32,
	cr: f32, cg: f32, cb: f32, ca: f32) void;

export @symbol("shim_gl_begin_constant") fn shim_gl_begin_constant(
	mvp: *f32,
	cr: f32, cg: f32, cb: f32, ca: f32) void;

export @symbol("shim_gl_set_pbr_lights") fn shim_gl_set_pbr_lights(
	light_data: *f32, light_count: i32) void;

export @symbol("shim_gl_set_pbr_ibl_textures") fn shim_gl_set_pbr_ibl_textures(
	global_tex: u32, global_blur_tex: u32,
	local_tex: u32, local_blur_tex: u32) void;

export @symbol("shim_gl_set_material_textures") fn shim_gl_set_material_textures(
	albedo_tex: u32, orm_tex: u32, normal_tex: u32) void;

export @symbol("shim_gl_set_albedo_texture") fn shim_gl_set_albedo_texture(
	tex: u32) void;

export @symbol("shim_gl_draw_mesh") fn shim_gl_draw_mesh(
	verts: *f32, vert_floats: i32,
	indices: *u16, index_count: i32) void;

export @symbol("shim_gl_draw_lines_batch") fn shim_gl_draw_lines_batch(
	verts: *f32, vert_count: i32, mvp: *f32) void;

export @symbol("shim_gl_draw_line_segment") fn shim_gl_draw_line_segment(
	verts: *f32, mvp: *f32, width: f32) void;

def SHADER_MAX_BYTES: size = 16384z;

export fn renderer_init_shaders() bool = {
	return shim_gl_init_embedded_shaders() == 0;
};

