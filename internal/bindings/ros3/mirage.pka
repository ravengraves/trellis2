export @symbol("mirage_read_bin") fn c_mirage_read_bin(msg: MirageMsg,
	value: *u8, length: *i64, capacity: i64) i64;
export @symbol("pk_mirage_read_bin") fn mirage_read_bin(msg: MirageMsg,
	value: []u8, length: *i64) i64 = {
	return c_mirage_read_bin(msg, value.data, length, value.len: i64);
};

// Numeric payloads are untyped: caller supplies correctly sized/aligned storage.
// Read max_rank and max_bytes independently accept -1 to skip copying.
// Even skipped payloads are validated and consumed. Type and rank are required.
export @symbol("mirage_write_numericarray") fn mirage_write_numericarray(
	msg: MirageMsg, array_type: MirageArrayType, rank: i64, dims: *i64, data: *opaque) i64;
export @symbol("mirage_read_numericarray") fn mirage_read_numericarray(
	msg: MirageMsg, array_type: *MirageArrayType, rank: *i64, dims: *i64,
	max_rank: i64, data: *opaque, max_bytes: i64) i64;
export @symbol("mirage_write_association") fn mirage_write_association(msg: MirageMsg, length: i64) i64;
export @symbol("mirage_read_association") fn mirage_read_association(msg: MirageMsg, length: *i64) i64;
// Peek normalizes packed arrays to NUMERICARRAY and delayed rules to RULE.
export @symbol("mirage_peek_element_type") fn mirage_peek_element_type(msg: MirageMsg, element: *MirageElementType) i64;
