use args;
use fb;
use strings;

@symbol("image_view_bridge_init") fn image_view_bridge_init(
	topic: *u8,
	bbox_topic: *u8,
	width: i32,
	height: i32,
	channels: i32,
	input_buffer_size: i32,
	latest_only: i32) i32;
@symbol("image_view_bridge_shutdown") fn image_view_bridge_shutdown() void;
@symbol("image_view_bridge_poll") fn image_view_bridge_poll() void;
@symbol("image_view_bridge_seq") fn image_view_bridge_seq() u64;
@symbol("image_view_bridge_status") fn image_view_bridge_status() i32;
@symbol("image_view_bridge_copy_rgb") fn image_view_bridge_copy_rgb(
	out_rgb: *u8, max_bytes: i32,
	out_w: *i32, out_h: *i32, out_channels: *i32) i32;
@symbol("image_view_bridge_bbox_count") fn image_view_bridge_bbox_count() i32;
@symbol("image_view_bridge_copy_bbox") fn image_view_bridge_copy_bbox(
	index: i32,
	out_xmin: *f64, out_ymin: *f64, out_xmax: *f64, out_ymax: *f64,
	out_r: *i32, out_g: *i32, out_b: *i32,
	out_name: *u8, out_name_size: i32) i32;

def IMAGE_VIEW_MAX_W: i32 = 1920;
def IMAGE_VIEW_MAX_H: i32 = 1080;
def IMAGE_VIEW_MAX_RGB: size = 6220800z;
def IMAGE_VIEW_BBOX_NAME_BYTES: i32 = 64;
def IMAGE_VIEW_BBOX_NAME_BYTES_Z: size = 64z;

let image_view_rgb_buf: [IMAGE_VIEW_MAX_RGB]u8 = [0...];
let image_view_bbox_name_buf: [IMAGE_VIEW_BBOX_NAME_BYTES_Z]u8 = [0...];

type ImageViewRect = struct {
	x: i32,
	y: i32,
	w: i32,
	h: i32,
};

type ImageViewBBox = struct {
	xmin: f64,
	ymin: f64,
	xmax: f64,
	ymax: f64,
	r: i32,
	g: i32,
	b: i32,
	name_len: i32,
	valid: bool,
};

type ImageViewCli = struct {
	topic: str,
	bbox_topic: str,
	width: i32,
	height: i32,
	channels: i32,
	input_buffer_size: i32,
	latest_only: i32,
	valid: bool,
	show_help: bool,
};

fn image_view_print_usage() void = {
	fb::Printsln("usage: image_view [--terminal] [--half-cell] [--term-lines] [--smoke]");
	fb::Printsln("                  [--topic TOPIC] [--width PIXELS] [--height PIXELS]");
	fb::Printsln("                  [--channels COUNT] [--input-buffer-size BYTES]");
	fb::Printsln("                  [--latest-only 0|1] [--box-topic TOPIC] [TOPIC]");
	fb::Printsln("defaults: width/height/channels are auto-inferred when possible");
	fb::Printsln("boxes: publish List[List[xmin,ymin,xmax,ymax,r,g,b,name], ...] to --box-topic");
};

fn image_view_is_flag(arg: str) bool = {
	let data = strings::toutf8(arg);
	return data.len >= 1z && data[0z] == '-';
};

fn image_view_parse_i32(arg: str) i32 = {
	let data = strings::toutf8(arg);
	if (data.len == 0z) {
		return 0;
	};
	let sign: i32 = 1;
	let start: size = 0z;
	if (data[0z] == ('-': u8)) {
		sign = -1;
		start = 1z;
	};
	let out: i32 = 0;
	for (let i: size = start; i < data.len; i += 1z) {
		let ch = data[i];
		if (ch < ('0': u8) || ch > ('9': u8)) {
			return 0;
		};
		out = (out * 10) + ((ch - ('0': u8)): i32);
	};
	return out * sign;
};

fn image_view_parse_cli() ImageViewCli = {
	let cfg = ImageViewCli {
		topic = "/camera/rgb",
		bbox_topic = "",
		width = 0,
		height = 0,
		channels = 0,
		input_buffer_size = 8388608,
		latest_only = 1,
		valid = true,
		show_help = false,
	};
	let topic_set = false;
	let argc = args::Count();

	for (let i: i32 = 1; i < argc; i += 1) {
		let arg = args::At(i);
		if (arg == "--help") {
			cfg.show_help = true;
			return cfg;
		};
		if (arg == "--terminal" || arg == "--half-cell" ||
			arg == "--term-lines" || arg == "--smoke") {
			continue;
		};
		if (arg == "--topic" || arg == "--width" || arg == "--height" ||
			arg == "--channels" || arg == "--input-buffer-size" ||
			arg == "--latest-only" || arg == "--bbox-topic" || arg == "--box-topic") {
			if (i + 1 >= argc) {
				cfg.valid = false;
				return cfg;
			};
			i = i + 1;
			let value = args::At(i);
			if (arg == "--topic") {
				cfg.topic = value;
				topic_set = true;
			} else if (arg == "--bbox-topic" || arg == "--box-topic") {
				cfg.bbox_topic = value;
			} else if (arg == "--width") {
				cfg.width = image_view_parse_i32(value);
			} else if (arg == "--height") {
				cfg.height = image_view_parse_i32(value);
			} else if (arg == "--channels") {
				cfg.channels = image_view_parse_i32(value);
			} else if (arg == "--input-buffer-size") {
				cfg.input_buffer_size = image_view_parse_i32(value);
			} else {
				cfg.latest_only = image_view_parse_i32(value);
			};
			continue;
		};
		if (!image_view_is_flag(arg) && !topic_set) {
			cfg.topic = arg;
			topic_set = true;
			continue;
		};
		cfg.valid = false;
		return cfg;
	};

	if (cfg.input_buffer_size <= 0 ||
		(cfg.latest_only != 0 && cfg.latest_only != 1)) {
		cfg.valid = false;
	};
	if ((cfg.width < 0) || (cfg.height < 0) || (cfg.channels < 0)) {
		cfg.valid = false;
	};
	return cfg;
};

fn image_view_target_rect(rt: *E2Runtime) ImageViewRect = {
	let w = rt.fb.width;
	let h = rt.fb.height;
	if (rt.mode == E2_MODE_WINDOW) {
		w = shim_window_width();
		h = shim_window_height();
	};
	return ImageViewRect { x = 0, y = 0, w = w, h = h };
};

fn image_view_fit_image(bounds: *ImageViewRect, img_w: i32, img_h: i32) ImageViewRect = {
	let out = *bounds;
	if (bounds.w <= 0 || bounds.h <= 0 || img_w <= 0 || img_h <= 0) {
		return out;
	};

	let bounds_aspect = (bounds.w: f32) / (bounds.h: f32);
	let img_aspect = (img_w: f32) / (img_h: f32);

	if (img_aspect > bounds_aspect) {
		let fit_h = ((bounds.w: f32) / img_aspect): i32;
		out.x = bounds.x;
		out.w = bounds.w;
		out.h = fit_h;
		out.y = bounds.y + (bounds.h - fit_h) / 2;
		return out;
	};

	let fit_w = ((bounds.h: f32) * img_aspect): i32;
	out.y = bounds.y;
	out.h = bounds.h;
	out.w = fit_w;
	out.x = bounds.x + (bounds.w - fit_w) / 2;
	return out;
};

fn image_view_empty_bbox() ImageViewBBox = {
	return ImageViewBBox {
		xmin = 0.0f64,
		ymin = 0.0f64,
		xmax = 0.0f64,
		ymax = 0.0f64,
		r = 255,
		g = 224,
		b = 64,
		name_len = 0,
		valid = false,
	};
};

fn image_view_read_bbox(index: i32) ImageViewBBox = {
	let box = image_view_empty_bbox();
	let copy_rc = image_view_bridge_copy_bbox(
		index,
		&box.xmin, &box.ymin, &box.xmax, &box.ymax,
		&box.r, &box.g, &box.b,
		&image_view_bbox_name_buf[0z], IMAGE_VIEW_BBOX_NAME_BYTES);
	if (copy_rc <= 0) {
		return box;
	};
	box.name_len = copy_rc - 1;
	box.valid = true;
	return box;
};

fn image_view_clamp_f64(v: f64, lo: f64, hi: f64) f64 = {
	if (v < lo) { return lo; };
	if (v > hi) { return hi; };
	return v;
};

fn image_view_color_component(c: i32) f32 = {
	let v = c;
	if (v < 0) { v = 0; };
	if (v > 255) { v = 255; };
	return (v: f32) / 255.0;
};

fn image_view_add_outline(buf: *E2CpuColorVertexBuffer,
	x: i32, y: i32, w: i32, h: i32, c: Color) void = {
	if (w <= 1 || h <= 1) { return; };
	let p0 = vec3_new(x: f32, y: f32, 0.0);
	let p1 = vec3_new((x + w): f32, y: f32, 0.0);
	let p2 = vec3_new((x + w): f32, (y + h): f32, 0.0);
	let p3 = vec3_new(x: f32, (y + h): f32, 0.0);
	util_cpu_color_buffer_add_line(buf, p0, p1, c);
	util_cpu_color_buffer_add_line(buf, p1, p2, c);
	util_cpu_color_buffer_add_line(buf, p2, p3, c);
	util_cpu_color_buffer_add_line(buf, p3, p0, c);
};

fn image_view_bbox_screen_rect(fit: *ImageViewRect,
	img_w: i32, img_h: i32, box: *ImageViewBBox) ImageViewRect = {
	let x0 = box.xmin;
	let y0 = box.ymin;
	let x1 = box.xmax;
	let y1 = box.ymax;

	if (x0 >= 0.0f64 && y0 >= 0.0f64 && x1 >= 0.0f64 && y1 >= 0.0f64 &&
		x0 <= 1.0f64 && y0 <= 1.0f64 && x1 <= 1.0f64 && y1 <= 1.0f64) {
		x0 = x0 * (img_w: f64);
		x1 = x1 * (img_w: f64);
		y0 = y0 * (img_h: f64);
		y1 = y1 * (img_h: f64);
	};
	if (x0 > x1) {
		let tx = x0;
		x0 = x1;
		x1 = tx;
	};
	if (y0 > y1) {
		let ty = y0;
		y0 = y1;
		y1 = ty;
	};

	x0 = image_view_clamp_f64(x0, 0.0f64, img_w: f64);
	x1 = image_view_clamp_f64(x1, 0.0f64, img_w: f64);
	y0 = image_view_clamp_f64(y0, 0.0f64, img_h: f64);
	y1 = image_view_clamp_f64(y1, 0.0f64, img_h: f64);

	let sx0 = (fit.x: f64) + (x0 / (img_w: f64)) * (fit.w: f64);
	let sx1 = (fit.x: f64) + (x1 / (img_w: f64)) * (fit.w: f64);
	let sy0 = (fit.y: f64) + (y0 / (img_h: f64)) * (fit.h: f64);
	let sy1 = (fit.y: f64) + (y1 / (img_h: f64)) * (fit.h: f64);
	let rx = sx0: i32;
	let ry = sy0: i32;
	let rw = (sx1 - sx0): i32;
	let rh = (sy1 - sy0): i32;
	return ImageViewRect { x = rx, y = ry, w = rw, h = rh };
};

fn image_view_draw_bbox(rt: *E2Runtime,
	bounds: *ImageViewRect, fit: *ImageViewRect,
	img_w: i32, img_h: i32, box: *ImageViewBBox) void = {
	if (!box.valid || img_w <= 0 || img_h <= 0) { return; };
	let rect = image_view_bbox_screen_rect(fit, img_w, img_h, box);
	let col = color_new(
		image_view_color_component(box.r),
		image_view_color_component(box.g),
		image_view_color_component(box.b),
		1.0);

	let line_cpu = util_cpu_color_buffer_init();
	image_view_add_outline(&line_cpu, rect.x, rect.y, rect.w, rect.h, col);
	let line_gpu = util_color_upload(&line_cpu);
	let line_pass = util_color_pass_init();
	util_color_pass_add(&line_pass, &line_gpu, 2.0);
	e2_pass_2d_lines(rt, line_pass.draws[0z..(line_pass.count: size)]);
	e2_gpu_color_destroy(&line_gpu);

	if (box.name_len > 0) {
		let label_x = rect.x;
		let label_y = rect.y - 16;
		if (label_y < 2) {
			label_y = rect.y + 4;
		};
		let label_dx = label_x - bounds.x;
		let label_dy = label_y - bounds.y;
		let x_frac = (label_dx: f32) / (bounds.w: f32);
		let y_frac = (label_dy: f32) / (bounds.h: f32);
		let label_buf: [IMAGE_VIEW_BBOX_NAME_BYTES_Z]u8 = [0...];
		for (let i: i32 = 0; i < box.name_len && i < IMAGE_VIEW_BBOX_NAME_BYTES - 1; i += 1) {
			label_buf[i: size] = image_view_bbox_name_buf[i: size];
		};
		let label = strings::fromutf8_unsafe(label_buf[0z..(box.name_len: size)]);
		e2_text_add(rt, x_frac, y_frac, label, box.r: u8, box.g: u8, box.b: u8);
	};
};

export fn main() void = {
	let cli = image_view_parse_cli();
	if (cli.show_help) {
		image_view_print_usage();
		return;
	};
	if (!cli.valid) {
		image_view_print_usage();
		return;
	};

	let topic_u8 = strings::toutf8(cli.topic);
	let bbox_topic_u8 = strings::toutf8(cli.bbox_topic);
	let bridge_rc = image_view_bridge_init(
		topic_u8.data,
		bbox_topic_u8.data,
		cli.width,
		cli.height,
		cli.channels,
		cli.input_buffer_size,
		cli.latest_only);
	if (bridge_rc <= 0) {
		return;
	};

	let mode = E2_MODE_WINDOW;
	if (args::Has("--terminal")) {
		mode = E2_MODE_TERMINAL;
	};
	let smoke = args::Has("--smoke");

	let rt = e2_runtime_init(mode, 1280, 800);
	if (args::Has("--half-cell")) {
		rt.term_style = E2_TERM_HALF_CELL;
	};
	if (args::Has("--term-lines")) {
		rt.term_present_mode = E2_TERM_PRESENT_LINES;
	};
	rt.target_fps = 30;
	if (!e2_runtime_start(&rt)) {
		fb::Printsln("image_view: engine start failed");
		image_view_bridge_shutdown();
		return;
	};
	if (!e2_init_blit_shader()) {
		fb::Printsln("image_view: blit shader init failed");
		e2_runtime_shutdown(&rt);
		image_view_bridge_shutdown();
		return;
	};

	let tex = E2GpuTexture { handle = 0u32, width = 0, height = 0, valid = false };
	let has_frame = false;
	let last_seq = 0u64;
	let first_frame = true;
	let frames: i32 = 0;

	for (e2_runtime_should_run(&rt)) {
		e2_runtime_begin_frame(&rt);
		image_view_bridge_poll();

		let seq = image_view_bridge_seq();
		if (seq != 0u64 && seq != last_seq) {
			let out_w: i32 = 0;
			let out_h: i32 = 0;
			let out_c: i32 = 0;
			let pixels = image_view_bridge_copy_rgb(
				&image_view_rgb_buf[0z], IMAGE_VIEW_MAX_RGB: i32,
				&out_w, &out_h, &out_c);
			if (pixels > 0 && out_w > 0 && out_h > 0) {
				if (!tex.valid || tex.width != out_w || tex.height != out_h) {
					if (tex.valid) {
						e2_gpu_texture_destroy(&tex);
					};
					let handle = shim_gl_create_texture_rgb(&image_view_rgb_buf[0z], out_w, out_h);
					tex = E2GpuTexture {
						handle = handle,
						width = out_w,
						height = out_h,
						valid = handle > 0u32,
					};
				} else {
					shim_gl_update_texture_rgb(tex.handle, &image_view_rgb_buf[0z], out_w, out_h);
				};
				has_frame = tex.valid;
				last_seq = seq;
				if (first_frame) {
					fb::Printsln("image_view: received first frame");
					first_frame = false;
				};
			};
		};

		e2_pass_begin(&rt, color_new(0.08, 0.09, 0.11, 1.0));
		if (has_frame && tex.valid) {
			let bounds = image_view_target_rect(&rt);
			let fit = image_view_fit_image(&bounds, tex.width, tex.height);
			e2_pass_2d_texture(&rt, &tex, fit.x, fit.y, fit.w, fit.h);
			let box_count = image_view_bridge_bbox_count();
			for (let box_i: i32 = 0; box_i < box_count; box_i += 1) {
				let bbox = image_view_read_bbox(box_i);
				image_view_draw_bbox(&rt, &bounds, &fit, tex.width, tex.height, &bbox);
			};
		};
		e2_pass_end(&rt);

		if (!has_frame) {
			let status = image_view_bridge_status();
			if (status < 0) {
				e2_text_add(&rt, 0.03, 0.03, "decode error: check topic shape / fallback dimensions", 255u8, 180u8, 160u8);
			} else {
				e2_text_add(&rt, 0.03, 0.03, "waiting for ros3 image topic...", 220u8, 220u8, 220u8);
			};
		};
		e2_pass_text(&rt);
		e2_runtime_present(&rt);
		frames = frames + 1;
		if (smoke && frames >= 2) {
			rt.running = false;
		};
	};

	if (tex.valid) {
		e2_gpu_texture_destroy(&tex);
	};
	e2_runtime_shutdown(&rt);
	image_view_bridge_shutdown();
};
