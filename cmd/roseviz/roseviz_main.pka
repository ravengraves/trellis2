// roseviz_main.pka — Windowed roseviz shell scaffold for images + point clouds.

use args;
use fb;
use clock;
use proc;

let roseviz_main_app_words: [1048576]u64 = [0...];

fn roseviz_stop_child(pid: i32) void = {
	proc::Kill(pid, false);
	proc::Wait(pid, 500);
};

export fn main() void = {
	let mode = E2_MODE_WINDOW;
	if (args::Has("--terminal")) {
		mode = E2_MODE_TERMINAL;
	};
	let smoke = args::Has("--smoke");
	let spawn_ball = args::Has("--spawn-falling-ball");

	let rt = e2_runtime_init(mode, 1280, 800);
	if (args::Has("--half-cell")) {
		rt.term_style = E2_TERM_HALF_CELL;
	};
	if (args::Has("--term-lines")) {
		rt.term_present_mode = E2_TERM_PRESENT_LINES;
	};
	rt.target_fps = 30;
	if (!e2_runtime_start(&rt)) {
		fb::Printsln("roseviz: engine start failed");
		return;
	};
	if (!e2_init_blit_shader()) {
		fb::Printsln("roseviz: blit shader init failed");
		e2_runtime_shutdown(&rt);
		return;
	};

	let app: *RosevizApp = &roseviz_main_app_words: *RosevizApp;
	if (!roseviz_app_init(app)) {
		fb::Printsln("roseviz: init failed");
		e2_runtime_shutdown(&rt);
		return;
	};
	let sim_pid: i32 = -1;
	if (spawn_ball) {
		roseviz_use_falling_ball_preset(app);
		let sim_path = "./build/roseviz_falling_ball";
		let sim_argv: [1]str = ["falling_ball"];
		let log_path = "/tmp/roseviz_falling_ball.log";
		sim_pid = proc::MustCreateRedirect(sim_path, sim_argv[0z..1z], "", log_path, false, log_path, false);
	};

	let frame_ms: f64 = 0.0;
	let frames: i32 = 0;
	for (e2_runtime_should_run(&rt)) {
		let t0 = clock::Now();
		e2_runtime_begin_frame(&rt);
		roseviz_handle_input(app, &rt);
		roseviz_render_frame(&rt, app);
		util_text_add_fps(&rt, frame_ms, 0.92, 0.01);
		e2_pass_text(&rt);
		e2_runtime_present(&rt);
		frame_ms = clock::Since(t0) * 1000.0f64;
		frames = frames + 1;
		if (smoke && frames >= 2) {
			rt.running = false;
		};
	};

	roseviz_app_shutdown(app);
	if (sim_pid > 0) {
		roseviz_stop_child(sim_pid);
	};
	e2_runtime_shutdown(&rt);
};
