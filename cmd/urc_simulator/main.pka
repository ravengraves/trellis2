// robot_main.pka — Rover simulator with mounted RGB/depth camera.

use args;
use fb;
use strings;

fn topic_rgb_message_bytes(width: i32, height: i32, channels: i32) i32 = {
	let payload = width * height * channels;
	return payload + 4096;
};

fn topic_depth_message_bytes(width: i32, height: i32) i32 = {
	let payload = width * height * 4;
	return payload + 4096;
};

def ROBOT_SENSOR_ZNEAR: f32 = 0.5;
def ROBOT_SENSOR_ZFAR: f32 = 300.0;
def ROBOT_SENSOR_RADIATION_HITS_PER_100000: i32 = 40;
def ROBOT_SENSOR_RADIATION_MIN_VALUE: i32 = 204;
def ROBOT_SENSOR_RADIATION_RADIUS: i32 = 1;
def ROBOT_RADIATION_DENSITY: f32 = 0.0004;
def ROBOT_RADIATION_MIN_VALUE: f32 = 0.80;
def ROBOT_RADIATION_MAX_VALUE: f32 = 1.0;
def ROBOT_SENSOR_DUST_DISTANCE_M: f32 = 20.0;
def ROBOT_SENSOR_DUST_DENSITY: f32 = 0.82;
def ROBOT_SENSOR_DUST_R: i32 = 224;
def ROBOT_SENSOR_DUST_G: i32 = 186;
def ROBOT_SENSOR_DUST_B: i32 = 116;
def ROBOT_VIEW_MAX_W: i32 = 1920;
def ROBOT_VIEW_MAX_H: i32 = 1080;
def ROBOT_VIEW_MAX_PIXELS: size = 2073600z;  // 1920 * 1080
def ROBOT_VIEW_MAX_RGB: size = 6220800z;     // 1920 * 1080 * 3

type RobotViewPostStorage = struct {
	rgb: [ROBOT_VIEW_MAX_RGB]u8,
	depth: [ROBOT_VIEW_MAX_PIXELS]f32,
};

let robot_view_post_storage: RobotViewPostStorage = RobotViewPostStorage {
	rgb = [0...],
	depth = [0.0...],
};

fn publish_sensor_topics(sensor_view: *CameraView) bool = {
	if (mj_shim_ros_render_publish_rgb(
		&depth_sensor_storage.rgb[0z],
		sensor_view.sensor.width,
		sensor_view.sensor.height,
		3) != 0) {
		return false;
	};
	if (mj_shim_ros_render_publish_depth(
		&depth_sensor_storage.depth[0z],
		sensor_view.sensor.width,
		sensor_view.sensor.height) != 0) {
		return false;
	};
	return true;
};

fn robot_sensor_hash_xy(x: i32, y: i32, seed: i32, salt: i32) i32 = {
	let safe_seed = seed % 10000;
	if (safe_seed < 0) { safe_seed = 0 - safe_seed; };
	let sx = x + 1;
	let sy = y + 1;
	let v = (sx * 157 + sy * 313 + safe_seed * 911 + salt * 271 + 71) % 1000003;
	v = (v + ((sx * sx) % 1000003) * 37) % 1000003;
	v = (v + ((sy * sy) % 1000003) * 101) % 1000003;
	v = (v + ((sx * sy) % 1000003) * 53) % 1000003;
	let fold = v % 4096;
	v = (v + fold * fold * 17 + safe_seed * 97) % 1000003;
	v = (v * 73 + 1013) % 1000003;
	v = (v * 97 + 9277) % 1000003;
	v = (v * 37 + 2663) % 1000003;
	return v;
};

fn robot_clamp_u8(v: i32) u8 = {
	if (v < 0) { return 0u8; };
	if (v > 255) { return 255u8; };
	return v: u8;
};

fn robot_viewport_dims(rt: *E2Runtime, out_w: *i32, out_h: *i32) bool = {
	let w = rt.fb.width;
	let h = rt.fb.height;
	if (rt.mode == E2_MODE_WINDOW) {
		w = shim_window_width();
		h = shim_window_height();
	};
	if (w <= 0 || h <= 0) { return false; };
	if (w > ROBOT_VIEW_MAX_W || h > ROBOT_VIEW_MAX_H) { return false; };
	*out_w = w;
	*out_h = h;
	return true;
};

fn robot_apply_sensor_dust(width: i32, height: i32,
	dust_distance_m: f32, dust_density: f32) void = {
	let pixels = width * height;
	let distance = dust_distance_m;
	if (distance < 0.001) { distance = 0.001; };
	let density = dust_density;
	if (density < 0.0) { density = 0.0; };
	if (density > 1.0) { density = 1.0; };
	for (let pi: i32 = 0; pi < pixels; pi += 1) {
		let idx: size = (pi * 3): size;
		let r: i32 = depth_sensor_storage.rgb[idx]: i32;
		let g: i32 = depth_sensor_storage.rgb[idx + 1z]: i32;
		let b: i32 = depth_sensor_storage.rgb[idx + 2z]: i32;

		let d = depth_sensor_storage.depth[pi: size];
		let fog = d / distance;
		if (fog < 0.0) { fog = 0.0; };
		if (fog > 1.0) { fog = 1.0; };
		fog = fog * density;
		let keep = 1.0 - fog;
		r = ((r: f32) * keep + (ROBOT_SENSOR_DUST_R: f32) * fog): i32;
		g = ((g: f32) * keep + (ROBOT_SENSOR_DUST_G: f32) * fog): i32;
		b = ((b: f32) * keep + (ROBOT_SENSOR_DUST_B: f32) * fog): i32;

		depth_sensor_storage.rgb[idx] = robot_clamp_u8(r);
		depth_sensor_storage.rgb[idx + 1z] = robot_clamp_u8(g);
		depth_sensor_storage.rgb[idx + 2z] = robot_clamp_u8(b);
	};
};

fn robot_apply_sensor_radiation_pixel(width: i32, height: i32,
	x: i32, y: i32, channel: i32, value: i32) void = {
	if (x < 0 || x >= width || y < 0 || y >= height) { return; };
	let idx: size = ((y * width + x) * 3): size;
	let ci: size = channel: size;
	if ((depth_sensor_storage.rgb[idx + ci]: i32) < value) {
		depth_sensor_storage.rgb[idx + ci] = robot_clamp_u8(value);
	};
};

fn robot_apply_sensor_radiation(width: i32, height: i32, seed: i32,
	hits_per_100000: i32, min_value: i32, radius: i32) void = {
	let pixels = width * height;
	let hits = hits_per_100000;
	if (hits < 0) { hits = 0; };
	if (hits > 100000) { hits = 100000; };
	let minv = min_value;
	if (minv < 0) { minv = 0; };
	if (minv > 255) { minv = 255; };
	let rad = radius;
	if (rad < 0) { rad = 0; };
	if (rad > 8) { rad = 8; };
	for (let pi: i32 = 0; pi < pixels; pi += 1) {
		let x = pi % width;
		let y = pi / width;
		let rh = robot_sensor_hash_xy(x, y, seed, 3);
		if ((rh % 100000) >= hits) {
			continue;
		};
		let channel = rh % 3;
		let value = minv +
			(robot_sensor_hash_xy(x, y, seed, 4) %
				(256 - minv));
		for (let oy: i32 = 0 - rad;
			oy <= rad; oy += 1) {
			for (let ox: i32 = 0 - rad;
				ox <= rad; ox += 1) {
				robot_apply_sensor_radiation_pixel(
					width, height, x + ox, y + oy, channel, value);
			};
		};
	};
};

fn robot_apply_camera_effects(width: i32, height: i32,
	seed: i32, radiation_enabled: bool, dust_enabled: bool,
	radiation_hits_per_100000: i32, radiation_min_value: i32,
	radiation_radius: i32, dust_distance_m: f32, dust_density: f32) void = {
	if (dust_enabled) {
		robot_apply_sensor_dust(width, height, dust_distance_m, dust_density);
	};
	if (radiation_enabled) {
		robot_apply_sensor_radiation(width, height, seed,
			radiation_hits_per_100000, radiation_min_value,
			radiation_radius);
	};
};

fn robot_radiation_params(seed: f32,
	hits_per_100000: i32, min_value: i32) E2RadiationParams = {
	let params = e2_radiation_params_default();
	params.density = (hits_per_100000: f32) / 100000.0;
	params.min_value = (min_value: f32) / 255.0;
	params.max_value = ROBOT_RADIATION_MAX_VALUE;
	params.seed = seed;
	return params;
};

fn robot_dust_params(znear: f32, zfar: f32, time_sec: f32,
	dust_distance_m: f32, dust_density: f32) E2DustParams = {
	let params = e2_dust_params_default(znear, zfar);
	params.dust_color = color_new(
		(ROBOT_SENSOR_DUST_R: f32) / 255.0,
		(ROBOT_SENSOR_DUST_G: f32) / 255.0,
		(ROBOT_SENSOR_DUST_B: f32) / 255.0,
		1.0);
	params.start = znear;
	params.end = dust_distance_m;
	if (params.end > zfar) {
		params.end = zfar;
	};
	if (params.end < znear + 0.001) {
		params.end = znear + 0.001;
	};
	params.falloff_distance = params.end - params.start;
	params.density = dust_density;
	params.time_sec = time_sec;
	return params;
};

fn try_load_model(path: str) bool = {
	let path_u8 = strings::toutf8(path);
	return mj_shim_load(path_u8.data) == 0;
};

fn load_default_rover() bool = {
	if (try_load_model("models/fruits_environment.xml")) {
		return true;
	};
	return false;
};

type RobotSimCli = struct {
	model_path: str,
	render_fps: i32,
	camera_fps: i32,
	physics_hz: i32,
	radiation_enabled: bool,
	dust_enabled: bool,
	radiation_hits_per_100000: i32,
	radiation_min_value: i32,
	radiation_radius: i32,
	dust_distance_m: i32,
	dust_density_percent: i32,
	valid: bool,
	show_help: bool,
};

fn robot_sim_usage() void = {
	fb::Printsln("usage: urc_simulator [--terminal] [--half-cell] [--term-lines]");
	fb::Printsln("                 [--render-fps FPS] [--camera-fps FPS]");
	fb::Printsln("                 [--physics-hz HZ] [--radiation|--radiation-light|--radiation-heavy]");
	fb::Printsln("                 [--radiation-hits N] [--radiation-min-value N] [--radiation-radius N]");
	fb::Printsln("                 [--dust] [--dust-distance M] [--dust-density-percent P] [model.xml]");
	fb::Printsln("defaults: render-fps=30, camera-fps=6, physics-hz=1000");
};

fn robot_sim_is_flag(arg: str) bool = {
	let data = strings::toutf8(arg);
	return data.len >= 1z && data[0z] == ('-': u8);
};

fn robot_sim_parse_i32(arg: str) i32 = {
	let data = strings::toutf8(arg);
	if (data.len == 0z) { return 0; };
	let out: i32 = 0;
	for (let i: size = 0z; i < data.len; i += 1z) {
		let ch = data[i];
		if (ch < ('0': u8) || ch > ('9': u8)) {
			return 0;
		};
		out = (out * 10) + ((ch - ('0': u8)): i32);
	};
	return out;
};

fn robot_sim_parse_cli() RobotSimCli = {
	let cfg = RobotSimCli {
		model_path = "",
		render_fps = 30,
		camera_fps = 6,
		physics_hz = 1000,
		radiation_enabled = false,
		dust_enabled = false,
		radiation_hits_per_100000 = ROBOT_SENSOR_RADIATION_HITS_PER_100000,
		radiation_min_value = ROBOT_SENSOR_RADIATION_MIN_VALUE,
		radiation_radius = ROBOT_SENSOR_RADIATION_RADIUS,
		dust_distance_m = ROBOT_SENSOR_DUST_DISTANCE_M: i32,
		dust_density_percent = (ROBOT_SENSOR_DUST_DENSITY * 100.0): i32,
		valid = true,
		show_help = false,
	};
	let argc = args::Count();
	for (let i: i32 = 1; i < argc; i += 1) {
		let arg = args::At(i);
		if (arg == "--help") {
			cfg.show_help = true;
			return cfg;
		};
		if (arg == "--radiation") {
			cfg.radiation_enabled = true;
			continue;
		};
		if (arg == "--radiation-light") {
			cfg.radiation_enabled = true;
			cfg.radiation_hits_per_100000 = 20;
			cfg.radiation_min_value = 220;
			cfg.radiation_radius = 1;
			continue;
		};
		if (arg == "--radiation-heavy") {
			cfg.radiation_enabled = true;
			cfg.radiation_hits_per_100000 = 140;
			cfg.radiation_min_value = 180;
			cfg.radiation_radius = 2;
			continue;
		};
		if (arg == "--dust") {
			cfg.dust_enabled = true;
			continue;
		};
		if (arg == "--terminal" || arg == "--half-cell" ||
			arg == "--term-lines" || arg == "--debug-ros-rate") {
			continue;
		};
		if (arg == "--radiation-hits" ||
			arg == "--radiation-hits-per-100000" ||
			arg == "--radiation-min-value" ||
			arg == "--radiation-radius" ||
			arg == "--dust-distance" ||
			arg == "--dust-density-percent") {
			if (i + 1 >= argc) {
				cfg.valid = false;
				return cfg;
			};
			i = i + 1;
			let fx_value = robot_sim_parse_i32(args::At(i));
			if (fx_value < 0) {
				cfg.valid = false;
				return cfg;
			};
			if (arg == "--radiation-hits" ||
				arg == "--radiation-hits-per-100000") {
				cfg.radiation_enabled = true;
				cfg.radiation_hits_per_100000 = fx_value;
			} else if (arg == "--radiation-min-value") {
				cfg.radiation_enabled = true;
				cfg.radiation_min_value = fx_value;
			} else if (arg == "--radiation-radius") {
				cfg.radiation_enabled = true;
				cfg.radiation_radius = fx_value;
			} else if (arg == "--dust-distance") {
				cfg.dust_enabled = true;
				cfg.dust_distance_m = fx_value;
			} else if (arg == "--dust-density-percent") {
				cfg.dust_enabled = true;
				cfg.dust_density_percent = fx_value;
			};
			continue;
		};
		if (arg == "--render-fps" || arg == "--fps" ||
			arg == "--camera-fps" || arg == "--sensor-fps" ||
			arg == "--physics-hz") {
			if (i + 1 >= argc) {
				cfg.valid = false;
				return cfg;
			};
			i = i + 1;
			let value = robot_sim_parse_i32(args::At(i));
			if (value <= 0) {
				cfg.valid = false;
				return cfg;
			};
			if (arg == "--physics-hz") {
				cfg.physics_hz = value;
			} else if (arg == "--camera-fps" || arg == "--sensor-fps") {
				cfg.camera_fps = value;
			} else {
				cfg.render_fps = value;
			};
			continue;
		};
		if (!robot_sim_is_flag(arg) && cfg.model_path == "") {
			cfg.model_path = arg;
			continue;
		};
		cfg.valid = false;
		return cfg;
	};
	return cfg;
};

fn body_frame_from_snapshot(pos: []f32, rot: []f32) Mat4 = {
	let m = mat4_identity();
	m.d[0z] = rot[0z];
	m.d[1z] = rot[3z];
	m.d[2z] = rot[6z];
	m.d[4z] = rot[1z];
	m.d[5z] = rot[4z];
	m.d[6z] = rot[7z];
	m.d[8z] = rot[2z];
	m.d[9z] = rot[5z];
	m.d[10z] = rot[8z];
	m.d[12z] = pos[0z];
	m.d[13z] = pos[1z];
	m.d[14z] = pos[2z];
	m.d[15z] = 1.0;
	return m;
};

def ROBOT_VISUAL_MARKER_MAX: size = 8z;

type RobotVisualMarker = struct {
	mesh: E2GpuMesh,
	albedo: E2GpuTexture,
	model: Mat4,
	material: Material,
	valid: bool,
};

type RobotStaticEnvSet = struct {
	markers: [ROBOT_VISUAL_MARKER_MAX]RobotVisualMarker,
};

fn robot_visual_marker_empty() RobotVisualMarker = {
	return RobotVisualMarker {
		mesh = E2GpuMesh { vbo = 0u32, ibo = 0u32, wire_ibo = 0u32,
			index_count = 0, wire_index_count = 0, valid = false },
		albedo = E2GpuTexture { handle = 0u32, width = 0, height = 0, valid = false },
		model = mat4_identity(),
		material = material_pbr(color_white(), 0.0, 1.0),
		valid = false,
	};
};

fn robot_visual_marker_model(x: f32, y: f32, z: f32) Mat4 = {
	let t = mat4_translate(x, y, z);
	let r = mat4_rotate_z(-90.0);
	return mat4_mul(&t, &r);
};

fn robot_visual_marker_model_full(x: f32, y: f32, z: f32,
	yaw_deg: f32, scale: f32, center_x: f32, center_y: f32, center_z: f32) Mat4 = {
	let t = mat4_translate(x, y, z);
	let r = mat4_rotate_z(yaw_deg);
	let s = mat4_scale(scale, scale, scale);
	let c = mat4_translate(-center_x, -center_y, -center_z);
	let rs = mat4_mul(&r, &s);
	let rsc = mat4_mul(&rs, &c);
	return mat4_mul(&t, &rsc);
};

fn robot_visual_marker_load(mesh_path: str, albedo_path: str,
	x: f32, y: f32, z: f32) RobotVisualMarker = {
	let out = robot_visual_marker_empty();

	let mesh_u8 = strings::toutf8(mesh_path);
	out.mesh = util_mesh_load_obj_upload(mesh_u8.data);
	if (!out.mesh.valid) {
		return out;
	};

	let albedo_u8 = strings::toutf8(albedo_path);
	out.albedo = e2_gpu_texture_load_png_rgba(albedo_u8.data);
	if (!out.albedo.valid) {
		e2_gpu_mesh_destroy(&out.mesh);
		return robot_visual_marker_empty();
	};

	let mat = material_pbr(color_white(), 0.0, 1.0);
	mat.texture = out.albedo.handle;
	out.material = mat;
	out.model = robot_visual_marker_model(x, y, z);
	out.valid = true;
	return out;
};

fn robot_visual_marker_load_full(mesh_path: str, albedo_path: str,
	x: f32, y: f32, z: f32, yaw_deg: f32, scale: f32,
	center_x: f32, center_y: f32, center_z: f32) RobotVisualMarker = {
	let out = robot_visual_marker_load(mesh_path, albedo_path, x, y, z);
	if (out.valid) {
		out.model = robot_visual_marker_model_full(
			x, y, z, yaw_deg, scale, center_x, center_y, center_z);
	};
	return out;
};

fn robot_visual_marker_add_to_pass(marker: *RobotVisualMarker,
	buf: *E2GeomPassBuffer) void = {
	if (!marker.valid || !marker.mesh.valid) {
		return;
	};
	util_geom_pass_add(buf, &marker.mesh, marker.model, marker.material);
};

fn robot_visual_marker_destroy(marker: *RobotVisualMarker) void = {
	if (marker.albedo.valid) { e2_gpu_texture_destroy(&marker.albedo); };
	if (marker.mesh.valid) { e2_gpu_mesh_destroy(&marker.mesh); };
	marker.valid = false;
};

fn robot_static_env_set_empty() RobotStaticEnvSet = {
	return RobotStaticEnvSet {
		markers = [robot_visual_marker_empty()...],
	};
};

fn robot_static_env_load_rover_scene() RobotStaticEnvSet = {
	let set = robot_static_env_set_empty();
	set.markers[0z] = robot_visual_marker_load(
		"models/cube0/render.obj", "models/cube0/albedo.png",
		-7.5, 10.0, 0.5);
	set.markers[1z] = robot_visual_marker_load(
		"models/cube1/render.obj", "models/cube1/albedo.png",
		-2.5, 10.0, 0.667);
	set.markers[2z] = robot_visual_marker_load(
		"models/cube2/render.obj", "models/cube2/albedo.png",
		2.5, 10.0, 0.833);
	set.markers[3z] = robot_visual_marker_load(
		"models/cube3/render.obj", "models/cube3/albedo.png",
		7.5, 10.0, 1.0);
	set.markers[4z] = robot_visual_marker_load_full(
		"models/banana/render.obj", "models/banana/albedo.png",
		-7.5, 12.0, 1.840,
		0.0, 0.5,
		-0.251574, 0.769869, 1.529199);
	set.markers[5z] = robot_visual_marker_load_full(
		"models/pineapple/render.obj", "models/pineapple/albedo.png",
		-2.5, 12.0, 0.0,
		0.0, 0.5,
		-0.019354, 0.641952, 0.156276);
	set.markers[6z] = robot_visual_marker_load_full(
		"models/dragonfruit/render.obj", "models/dragonfruit/albedo.png",
		2.5, 12.0, 1.428,
		0.0, 0.5,
		-0.035571, 0.007086, 0.497614);
	set.markers[7z] = robot_visual_marker_load_full(
		"models/snakefruit/render.obj", "models/snakefruit/albedo.png",
		7.5, 12.0, 0.756,
		0.0, 0.5,
		-0.001078, -0.005285, 1.510023);
	return set;
};

fn robot_static_env_add_to_pass(set: *RobotStaticEnvSet, buf: *E2GeomPassBuffer) void = {
	for (let i: size = 0z; i < ROBOT_VISUAL_MARKER_MAX; i += 1z) {
		robot_visual_marker_add_to_pass(&set.markers[i], buf);
	};
};

fn robot_static_env_destroy(set: *RobotStaticEnvSet) void = {
	for (let i: size = 0z; i < ROBOT_VISUAL_MARKER_MAX; i += 1z) {
		robot_visual_marker_destroy(&set.markers[i]);
	};
};

export fn main() void = {
	let cli = robot_sim_parse_cli();
	if (cli.show_help || !cli.valid) {
		robot_sim_usage();
		return;
	};

	let mode = E2_MODE_WINDOW;
	if (args::Has("--terminal")) {
		mode = E2_MODE_TERMINAL;
	};

	let model_path = cli.model_path;
	let loaded = false;
	if (model_path != "") {
		loaded = try_load_model(model_path);
	} else {
		loaded = load_default_rover();
	};
	if (!loaded) {
		robot_sim_usage();
		return;
	};

	let requested_timestep = 1.0f64 / (cli.physics_hz: f64);
	if (mj_shim_set_timestep(requested_timestep) != 0) {
		fb::Printsln("warning: failed to set MuJoCo timestep");
	};

	let control_topic = strings::toutf8("/control");
	let left_name = strings::toutf8("rear_left_wheel");
	let right_name = strings::toutf8("rear_right_wheel");
	if (mj_shim_configure_tank_controls(
		control_topic.data,
		left_name.data,
		right_name.data,
		0.3) != 0) {
		fb::Printsln("warning: tank actuator mapping not resolved");
	};

	let rt = e2_runtime_init(mode, 800, 600);
	if (args::Has("--half-cell")) {
		rt.term_style = E2_TERM_HALF_CELL;
	};
	if (args::Has("--term-lines")) {
		rt.term_present_mode = E2_TERM_PRESENT_LINES;
	};
	rt.target_fps = 0;
	if (!e2_runtime_start(&rt)) {
		fb::Printsln("engine start failed");
		mj_shim_free();
		return;
	};
	if (!e2_init_blit_shader()) {
		fb::Printsln("warning: blit shader init failed");
	};
	if (cli.radiation_enabled && !e2_init_radiation_shader()) {
		fb::Printsln("warning: radiation shader init failed");
	};
	if (cli.dust_enabled && !e2_init_dust_shader()) {
		fb::Printsln("warning: dust shader init failed");
	};

	let rgb_topic = strings::toutf8("/simulator/rgb");
	let depth_topic = strings::toutf8("/simulator/depth");
	let imu_topic = strings::toutf8("/simulator/imu");
	let vio_topic = strings::toutf8("/simulator/vio");
	let render_node = strings::toutf8("simulator");
	let sensor_w: i32 = 640;
	let sensor_h: i32 = 480;
	let rgb_message_bytes = topic_rgb_message_bytes(sensor_w, sensor_h, 3);
	let depth_message_bytes = topic_depth_message_bytes(sensor_w, sensor_h);
	if (mj_shim_ros_render_init(
		render_node.data,
		rgb_topic.data,
		depth_topic.data,
		rgb_message_bytes,
		depth_message_bytes,
		cli.camera_fps) != 0) {
		fb::Printsln("warning: ROS3 render publishers unavailable");
	};
	if (mj_shim_ros_motion_init(
		render_node.data,
		imu_topic.data,
		vio_topic.data,
		1024,
		1024,
		cli.physics_hz,
		30) != 0) {
		fb::Printsln("warning: ROS3 motion publishers unavailable");
	};

	let sc = scene_new();
	scene_init(&sc);
	let static_objects = robot_static_env_load_rover_scene();

	let line_cpu = util_cpu_color_buffer_init();
	util_lines_add_grid(&line_cpu, 40.0, 80, color_gray(0.20));
	util_lines_add_axes(&line_cpu, 0.75);
	let line_gpu = util_color_upload(&line_cpu);

	let geom_pass = util_geom_pass_init();
	let line_pass = util_color_pass_init();
	let lights = util_light_buffer_init();
	let env = env_default();
	let bg_color = color_new(0.93, 0.78, 0.28, 1.0);
	env.sky_color = color_new(0.78, 0.42, 0.24, 1.0);
	env.horizon_color = color_new(0.86, 0.56, 0.29, 1.0);
	env.ground_color = color_new(0.42, 0.18, 0.12, 1.0);
	env.specular_color = color_new(0.98, 0.78, 0.45, 1.0);
	env.intensity = 1.05;

	let cam = camera_default();
	cam.distance = 6.0;
	cam.yaw = 55.0;
	cam.pitch = 28.0;
	cam.target = vec3_new(0.0, 0.0, 0.9);

	let sensor_view = camera_view_new(
			vec3_new(0.0, -2.0, 1.4),
			vec3_new(0.0, 0.0, 0.8),
			70.0, ROBOT_SENSOR_ZNEAR, ROBOT_SENSOR_ZFAR,
			sensor_w, sensor_h,
			520, 16,
			256, 192,
			CAMVIEW_MODE_RGB);
	let main_dust_color_tex = E2GpuTexture {
		handle = 0u32, width = 0, height = 0, valid = false };
	let main_dust_depth_tex = E2GpuTexture {
		handle = 0u32, width = 0, height = 0, valid = false };
	let main_dust_tex_w: i32 = 0;
	let main_dust_tex_h: i32 = 0;

	let frame_name = strings::toutf8("frame");
	let frame_body_id = mj_shim_body_id(frame_name.data);
	let sensor_eye_local = vec3_new(0.0, 0.45, 0.20);
	let sensor_target_local = vec3_new(0.0, 1.45, 0.12);
	let body_pos: [3]f32 = [0.0...];
	let body_rot: [9]f32 = [0.0...];
	let sim_time: f64 = 0.0;
	let frame_ms: f64 = 0.0;
	let render_fps = cli.render_fps;
	let render_period_s: f64 = 1.0f64 / (render_fps: f64);
	let camera_fps = cli.camera_fps;
	let camera_period_s: f64 = 1.0f64 / (camera_fps: f64);
	let physics_step_s: f64 = mj_shim_timestep();
	if (physics_step_s <= 0.0) {
		physics_step_s = 1.0f64 / (cli.physics_hz: f64);
	};
	let sim_start_time = mj_shim_time();
	let realtime_start_tick = rose_now();
	let next_render_sim_time = sim_start_time;
	let next_camera_sim_time = sim_start_time;
	let debug_ros_rate = args::Has("--debug-ros-rate");
	let debug_last_tick: u64 = realtime_start_tick;
	let debug_render_count: i32 = 0;
	let debug_physics_steps: i32 = 0;
	let debug_sensor_ok_count: i32 = 0;
	let debug_publish_count: i32 = 0;
	let debug_ok_ms: f64 = 0.0;
	let debug_spin_ms: f64 = 0.0;
	let debug_sensor_ms: f64 = 0.0;
	let debug_publish_ms: f64 = 0.0;
	let sensor_effect_seed: i32 = 1;
	let render_effect_seed: f32 = 1.0;

	for (e2_runtime_should_run(&rt)) {
		let ros_ok_tick = rose_now();
		if (mj_shim_ros_ok() == 0) {
			break;
		};
		debug_ok_ms = debug_ok_ms + rose_elapsed_seconds(ros_ok_tick) * 1000.0f64;

		let ros_spin_tick = rose_now();
		mj_shim_ros_spin_once();
		debug_spin_ms = debug_spin_ms + rose_elapsed_seconds(ros_spin_tick) * 1000.0f64;

		if (mj_shim_consume_reset_request() != 0) {
			sim_start_time = mj_shim_time();
			realtime_start_tick = rose_now();
			next_render_sim_time = sim_start_time;
			next_camera_sim_time = sim_start_time;
			debug_last_tick = realtime_start_tick;
			continue;
		};

		let wall_elapsed_s = rose_elapsed_seconds(realtime_start_tick);
		let target_sim_time = sim_start_time + wall_elapsed_s;
		let step_count: i32 = 0;
		for (mj_shim_time() + (physics_step_s * 0.5f64) < target_sim_time) {
			mj_shim_step();
			step_count = step_count + 1;
			debug_physics_steps = debug_physics_steps + 1;
			if (step_count % 64 == 0) {
				mj_shim_ros_spin_once();
			};
		};

		sim_time = mj_shim_time();
		if (sim_time + 0.000001f64 < next_render_sim_time) {
			let next_step_sim_time = sim_time + physics_step_s;
			let wake_sim_time = next_step_sim_time;
			if (next_render_sim_time < wake_sim_time) {
				wake_sim_time = next_render_sim_time;
			};
			let wake_wall_s = wake_sim_time - sim_start_time;
			let sleep_s = wake_wall_s - rose_elapsed_seconds(realtime_start_tick);
			if (sleep_s > 0.0) {
				rose_sleep(sleep_s);
			};
			continue;
		};
		for (next_render_sim_time <= sim_time) {
			next_render_sim_time = next_render_sim_time + render_period_s;
		};
		let camera_due = false;
		if (sim_time + 0.000001f64 >= next_camera_sim_time) {
			camera_due = true;
			for (next_camera_sim_time <= sim_time) {
				next_camera_sim_time = next_camera_sim_time + camera_period_s;
			};
		};

		let t0_tick = rose_now();
		e2_runtime_begin_frame(&rt);
		debug_render_count = debug_render_count + 1;
		camera_view_layout_top_right(&sensor_view, &rt, 16, 0.36, 0.36);

		util_camera_apply_orbit_controls(&cam, &rt.input, rt.mode == E2_MODE_TERMINAL);
		if (input_key_just_pressed(&rt.input, KEY_D)) {
			if (sensor_view.mode == CAMVIEW_MODE_DEPTH) {
				sensor_view.mode = CAMVIEW_MODE_RGB;
			} else {
				sensor_view.mode = CAMVIEW_MODE_DEPTH;
			};
		};

		mj_shim_snapshot_begin();
		sim_time = mj_shim_time();
		if (frame_body_id >= 0) {
			mj_shim_body_pos(frame_body_id, &body_pos[0z]);
			mj_shim_body_mat(frame_body_id, &body_rot[0z]);
			let frame_mat = body_frame_from_snapshot(body_pos[0z..3z], body_rot[0z..9z]);
			let sensor_eye = mat4_transform_point(&frame_mat, sensor_eye_local);
			let sensor_target = mat4_transform_point(&frame_mat, sensor_target_local);
			let frame_target = vec3_new(body_pos[0z], body_pos[1z], body_pos[2z]);
			camera_view_set_pose(&sensor_view, sensor_eye, sensor_target);
			cam.target = vec3_lerp(cam.target, frame_target, 0.08);
		};
		scene_update(&sc);
		mj_shim_snapshot_end();

		scene_geom_pass(&sc, &geom_pass);
		robot_static_env_add_to_pass(&static_objects, &geom_pass);

		util_color_pass_clear(&line_pass);
		util_color_pass_add(&line_pass, &line_gpu, 1.0);
		let free_cam = util_camera_free_from_orbit(&cam);

		if (camera_due) {
			let sensor_tick = rose_now();
			let sensor_ok = camera_view_render_bg(
				&sensor_view,
				geom_pass.draws[0z..(geom_pass.count: size)],
				util_light_buffer_slice(&lights),
				&env,
				bg_color);
			debug_sensor_ms = debug_sensor_ms + rose_elapsed_seconds(sensor_tick) * 1000.0f64;
			if (sensor_ok) {
				debug_sensor_ok_count = debug_sensor_ok_count + 1;
			};
			if (sensor_ok) {
				if (cli.radiation_enabled || cli.dust_enabled) {
					robot_apply_camera_effects(
						sensor_view.sensor.width,
						sensor_view.sensor.height,
						sensor_effect_seed,
						cli.radiation_enabled,
						cli.dust_enabled,
						cli.radiation_hits_per_100000,
						cli.radiation_min_value,
						cli.radiation_radius,
						cli.dust_distance_m: f32,
						(cli.dust_density_percent: f32) / 100.0);
					camera_view_refresh_texture(&sensor_view);
					sensor_effect_seed = sensor_effect_seed + 1;
					if (sensor_effect_seed > 1000000) {
						sensor_effect_seed = 1;
					};
				};
				let publish_tick = rose_now();
				if (publish_sensor_topics(&sensor_view)) {
					debug_publish_count = debug_publish_count + 1;
				};
				debug_publish_ms = debug_publish_ms + rose_elapsed_seconds(publish_tick) * 1000.0f64;
			};
		};
		let sensor_now_tick = rose_now();
		if (debug_ros_rate && rose_seconds(sensor_now_tick, debug_last_tick) >= 1.0f64) {
			let dbuf: [192]u8 = [0...];
			let dfmt = fb::New(dbuf[0z..192z]);
			fb::Write(&dfmt, "urc_simulator rate renders=");
			fb::Wi64(&dfmt, debug_render_count: i64);
			fb::Write(&dfmt, " physics_steps=");
			fb::Wi64(&dfmt, debug_physics_steps: i64);
			fb::Write(&dfmt, " sensor_ok=");
			fb::Wi64(&dfmt, debug_sensor_ok_count: i64);
			fb::Write(&dfmt, " publishes=");
			fb::Wi64(&dfmt, debug_publish_count: i64);
			fb::Write(&dfmt, " rgb_index=");
			fb::Wi64(&dfmt, mj_shim_ros_rgb_index(): i64);
			fb::Write(&dfmt, " imu_index=");
			fb::Wi64(&dfmt, mj_shim_ros_imu_index(): i64);
			fb::Write(&dfmt, " vio_index=");
			fb::Wi64(&dfmt, mj_shim_ros_vio_index(): i64);
			fb::Write(&dfmt, " ok_ms=");
			fb::Wf64(&dfmt, debug_ok_ms, 1, "fix");
			fb::Write(&dfmt, " spin_ms=");
			fb::Wf64(&dfmt, debug_spin_ms, 1, "fix");
			fb::Write(&dfmt, " sensor_ms=");
			fb::Wf64(&dfmt, debug_sensor_ms, 1, "fix");
			fb::Write(&dfmt, " publish_ms=");
			fb::Wf64(&dfmt, debug_publish_ms, 1, "fix");
			fb::Printsln(fb::ToStr(&dfmt));
			debug_last_tick = sensor_now_tick;
			debug_render_count = 0;
			debug_physics_steps = 0;
			debug_sensor_ok_count = 0;
			debug_publish_count = 0;
			debug_ok_ms = 0.0;
			debug_spin_ms = 0.0;
			debug_sensor_ms = 0.0;
			debug_publish_ms = 0.0;
		};

		let main_dust_ok = false;
		let main_view_w: i32 = 0;
		let main_view_h: i32 = 0;
		if (cli.dust_enabled &&
			robot_viewport_dims(&rt, &main_view_w, &main_view_h)) {
			main_dust_ok = e2_render_camera_to_ptr_buffers_bg(
				&free_cam,
				E2_GEOM_MODE_PBR,
				geom_pass.draws[0z..(geom_pass.count: size)],
				line_pass.draws[0z..(line_pass.count: size)],
				line_pass.draws[0z..0z],
				util_light_buffer_slice(&lights),
				&env,
				bg_color,
				&robot_view_post_storage.rgb[0z],
				ROBOT_VIEW_MAX_RGB,
				&robot_view_post_storage.depth[0z],
				ROBOT_VIEW_MAX_PIXELS,
				main_view_w,
				main_view_h);
			if (main_dust_ok &&
				(main_dust_tex_w != main_view_w || main_dust_tex_h != main_view_h)) {
				if (main_dust_color_tex.valid) {
					e2_gpu_texture_destroy(&main_dust_color_tex);
				};
				if (main_dust_depth_tex.valid) {
					e2_gpu_texture_destroy(&main_dust_depth_tex);
				};
				main_dust_tex_w = 0;
				main_dust_tex_h = 0;
			};
			if (main_dust_ok) {
				if (!main_dust_color_tex.valid) {
					main_dust_color_tex = e2_gpu_texture_create_rgb_ptr(
						&robot_view_post_storage.rgb[0z],
						main_view_w, main_view_h);
				} else {
					e2_gpu_texture_update_rgb_ptr(
						&main_dust_color_tex,
						&robot_view_post_storage.rgb[0z]);
				};
				if (!main_dust_depth_tex.valid) {
					main_dust_depth_tex = e2_gpu_depth_texture_create_ptr(
						&robot_view_post_storage.depth[0z],
						main_view_w, main_view_h,
						free_cam.znear, free_cam.zfar);
				} else {
					e2_gpu_depth_texture_update_ptr(
						&main_dust_depth_tex,
						&robot_view_post_storage.depth[0z],
						free_cam.znear, free_cam.zfar);
				};
				main_dust_tex_w = main_view_w;
				main_dust_tex_h = main_view_h;
				main_dust_ok = main_dust_color_tex.valid && main_dust_depth_tex.valid;
			};
		};

		e2_pass_begin(&rt, bg_color);
		if (main_dust_ok) {
			let dust_params = robot_dust_params(
				free_cam.znear, free_cam.zfar, sim_time: f32,
				cli.dust_distance_m: f32,
				(cli.dust_density_percent: f32) / 100.0);
			e2_pass_dust(&rt, &main_dust_color_tex, &main_dust_depth_tex, &dust_params);
		} else {
			e2_pass_3d_geom(&rt, &free_cam, E2_GEOM_MODE_PBR,
				geom_pass.draws[0z..(geom_pass.count: size)],
				util_light_buffer_slice(&lights), &env);
			e2_pass_3d_lines(&rt, &free_cam,
				line_pass.draws[0z..(line_pass.count: size)]);
		};
		if (cli.radiation_enabled) {
			let radiation_params = robot_radiation_params(render_effect_seed,
				cli.radiation_hits_per_100000, cli.radiation_min_value);
			e2_pass_radiation_overlay(&rt, &radiation_params);
			render_effect_seed = render_effect_seed + 1.0;
			if (render_effect_seed > 1000000.0) {
				render_effect_seed = 1.0;
			};
		};
		if (rt.mode != E2_MODE_WINDOW && sensor_view.initialized) {
			camera_view_draw(&sensor_view, &rt);
		};
		e2_pass_end(&rt);

		util_text_add_fps(&rt, frame_ms, 0.01, 0.01);
		let tbuf: [96]u8 = [0...];
		let tfmt = fb::New(tbuf[0z..96z]);
		fb::Write(&tfmt, "sim ");
		fb::Wf64(&tfmt, sim_time, 2, "fix");
		fb::Write(&tfmt, "s camera ");
		if (sensor_view.mode == CAMVIEW_MODE_DEPTH) {
			fb::Write(&tfmt, "depth");
		} else {
			fb::Write(&tfmt, "rgb");
		};
		e2_text_add(&rt, 0.01, 0.05, fb::ToStr(&tfmt), 255, 255, 255);
		e2_pass_text(&rt);
		if (rt.mode == E2_MODE_WINDOW && sensor_view.initialized) {
			camera_view_draw(&sensor_view, &rt);
		};

		let pre_present_ms = rose_elapsed_seconds(t0_tick) * 1000.0f64;
		e2_runtime_present(&rt);
		if (rt.mode == E2_MODE_TERMINAL) {
			frame_ms = pre_present_ms + rt.last_term_draw_ms;
		} else {
			frame_ms = rose_elapsed_seconds(t0_tick) * 1000.0f64;
		};
	};

	if (main_dust_color_tex.valid) {
		e2_gpu_texture_destroy(&main_dust_color_tex);
	};
	if (main_dust_depth_tex.valid) {
		e2_gpu_texture_destroy(&main_dust_depth_tex);
	};
	camera_view_destroy(&sensor_view);
	robot_static_env_destroy(&static_objects);
	scene_destroy(&sc);
	e2_gpu_color_destroy(&line_gpu);
	mj_shim_free();
	e2_runtime_shutdown(&rt);
};
