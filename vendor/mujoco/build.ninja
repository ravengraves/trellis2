build $out_dir/.stamp.core_deps: phony $gen_dir/ccd/config.h $lib_dir/libccd.a $lib_dir/libqhullstatic_r.a $lib_dir/libqhullcpp.a $lib_dir/libtinyxml2.a $lib_dir/libtinyobjloader.a $lib_dir/liblodepng.a

