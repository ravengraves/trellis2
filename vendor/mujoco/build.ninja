build $obj_dir/deps/qhull/libqhullcpp/QhullPoints.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/qhull/src/libqhullcpp/QhullPoints.cpp
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
  dep_cxxflags = -std=c++17
build $obj_dir/deps/qhull/libqhullcpp/QhullQh.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/qhull/src/libqhullcpp/QhullQh.cpp
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
  dep_cxxflags = -std=c++17
build $obj_dir/deps/qhull/libqhullcpp/QhullRidge.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/qhull/src/libqhullcpp/QhullRidge.cpp
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
  dep_cxxflags = -std=c++17
build $obj_dir/deps/qhull/libqhullcpp/QhullSet.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/qhull/src/libqhullcpp/QhullSet.cpp
