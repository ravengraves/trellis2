  dep_cxxflags = -std=c++17
build $obj_dir/deps/qhull/libqhullcpp/QhullStat.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/qhull/src/libqhullcpp/QhullStat.cpp
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
  dep_cxxflags = -std=c++17
build $obj_dir/deps/qhull/libqhullcpp/QhullUser.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/qhull/src/libqhullcpp/QhullUser.cpp
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
  dep_cxxflags = -std=c++17
build $obj_dir/deps/qhull/libqhullcpp/QhullVertex.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/qhull/src/libqhullcpp/QhullVertex.cpp
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
  dep_cxxflags = -std=c++17
build $obj_dir/deps/qhull/libqhullcpp/QhullVertexSet.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/qhull/src/libqhullcpp/QhullVertexSet.cpp
