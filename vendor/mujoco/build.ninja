build $obj_dir/deps/qhull/libqhullcpp/QhullFacet.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/qhull/src/libqhullcpp/QhullFacet.cpp
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
  dep_cxxflags = -std=c++17
build $obj_dir/deps/qhull/libqhullcpp/QhullFacetList.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/qhull/src/libqhullcpp/QhullFacetList.cpp
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
  dep_cxxflags = -std=c++17
build $obj_dir/deps/qhull/libqhullcpp/QhullFacetSet.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/qhull/src/libqhullcpp/QhullFacetSet.cpp
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
  dep_cxxflags = -std=c++17
build $obj_dir/deps/qhull/libqhullcpp/QhullHyperplane.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/qhull/src/libqhullcpp/QhullHyperplane.cpp
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
