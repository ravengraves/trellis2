ninja_required_version = 1.7

mujoco_dir = .
out_dir = build
obj_dir = $out_dir/obj
lib_dir = $out_dir/lib
gen_dir = $out_dir/generated

cc = cc
cxx = c++
ar = ar

common_opt = -O3 -fPIC -fdata-sections -ffunction-sections
core_defs = -DCCD_STATIC_DEFINE -DMUJOCO_DLL_EXPORTS -DMUJOCO_TINYOBJLOADER_IMPL -D_GNU_SOURCE -DmjUSEPLATFORMSIMD -DNDEBUG
core_warn = -Werror -Wall -Wimplicit-fallthrough -Wunused -Wno-int-in-bool-context -Wno-sign-compare -Wno-unknown-pragmas -Wimplicit-fallthrough=5 -Wno-maybe-uninitialized
core_incs = -I$mujoco_dir/include -I$mujoco_dir/src -I$mujoco_dir/dependencies/ccd/src -I$gen_dir -I$mujoco_dir/dependencies/lodepng -I$mujoco_dir/dependencies/qhull/src/libqhull_r -I$mujoco_dir/dependencies/tinyobjloader -I$mujoco_dir/dependencies/tinyxml2
core_cflags = -std=c11 -fvisibility=hidden
core_cxxflags = -std=c++17 -fvisibility=hidden -fvisibility-inlines-hidden

dep_defs = -DNDEBUG
dep_cflags =
dep_cxxflags =
dep_incs =

rule core_cc_compile
  command = bash -c 'mkdir -p "$$(dirname "$out")" && $cc $core_defs $common_opt $core_warn $core_cflags $core_incs -MMD -MF "$out.d" -c "$in" -o "$out"'
  depfile = $out.d
  deps = gcc
  description = CC $out

rule core_cxx_compile
  command = bash -c 'mkdir -p "$$(dirname "$out")" && $cxx $core_defs $common_opt $core_warn $core_cxxflags $core_incs -MMD -MF "$out.d" -c "$in" -o "$out"'
  depfile = $out.d
  deps = gcc
  description = CXX $out

rule dep_cc_compile
  command = bash -c 'mkdir -p "$$(dirname "$out")" && $cc $dep_defs $common_opt $dep_cflags $dep_incs -MMD -MF "$out.d" -c "$in" -o "$out"'
  depfile = $out.d
  deps = gcc
  description = DEP-CC $out

rule dep_cxx_compile
  command = bash -c 'mkdir -p "$$(dirname "$out")" && $cxx $dep_defs $common_opt $dep_cxxflags $dep_incs -MMD -MF "$out.d" -c "$in" -o "$out"'
  depfile = $out.d
  deps = gcc
  description = DEP-CXX $out

rule archive
  command = bash -c 'mkdir -p "$$(dirname "$out")" && rm -f "$out" && $ar rcs "$out" $in'
  description = AR $out

rule gen_ccd_config
  command = bash -c 'mkdir -p "$$(dirname "$out")" && printf "#ifndef __CCD_CONFIG_H__\n#define __CCD_CONFIG_H__\n\n#define CCD_SINGLE\n/* #undef CCD_DOUBLE */\n\n#endif /* __CCD_CONFIG_H__ */\n" > "$out"'
  description = GEN $out

build $gen_dir/ccd/config.h: gen_ccd_config

# ccd
build $obj_dir/deps/ccd/ccd.c.o: dep_cc_compile $mujoco_dir/dependencies/ccd/src/ccd.c | $gen_dir/ccd/config.h
  dep_incs = -I$mujoco_dir/dependencies/ccd/src -I$gen_dir
  dep_cflags = -fvisibility=hidden
  dep_defs = -DCCD_STATIC_DEFINE -DNDEBUG
build $obj_dir/deps/ccd/mpr.c.o: dep_cc_compile $mujoco_dir/dependencies/ccd/src/mpr.c | $gen_dir/ccd/config.h
  dep_incs = -I$mujoco_dir/dependencies/ccd/src -I$gen_dir
  dep_cflags = -fvisibility=hidden
  dep_defs = -DCCD_STATIC_DEFINE -DNDEBUG
build $obj_dir/deps/ccd/polytope.c.o: dep_cc_compile $mujoco_dir/dependencies/ccd/src/polytope.c | $gen_dir/ccd/config.h
  dep_incs = -I$mujoco_dir/dependencies/ccd/src -I$gen_dir
  dep_cflags = -fvisibility=hidden
  dep_defs = -DCCD_STATIC_DEFINE -DNDEBUG
build $obj_dir/deps/ccd/support.c.o: dep_cc_compile $mujoco_dir/dependencies/ccd/src/support.c | $gen_dir/ccd/config.h
  dep_incs = -I$mujoco_dir/dependencies/ccd/src -I$gen_dir
  dep_cflags = -fvisibility=hidden
  dep_defs = -DCCD_STATIC_DEFINE -DNDEBUG
build $obj_dir/deps/ccd/vec3.c.o: dep_cc_compile $mujoco_dir/dependencies/ccd/src/vec3.c | $gen_dir/ccd/config.h
  dep_incs = -I$mujoco_dir/dependencies/ccd/src -I$gen_dir
  dep_cflags = -fvisibility=hidden
  dep_defs = -DCCD_STATIC_DEFINE -DNDEBUG
build $lib_dir/libccd.a: archive $obj_dir/deps/ccd/ccd.c.o $obj_dir/deps/ccd/mpr.c.o $obj_dir/deps/ccd/polytope.c.o $obj_dir/deps/ccd/support.c.o $obj_dir/deps/ccd/vec3.c.o

# tinyxml2
build $obj_dir/deps/tinyxml2/tinyxml2.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/tinyxml2/tinyxml2.cpp
  dep_incs = -I$mujoco_dir/dependencies/tinyxml2
  dep_cxxflags = -std=c++17
build $lib_dir/libtinyxml2.a: archive $obj_dir/deps/tinyxml2/tinyxml2.cpp.o

# tinyobjloader
build $obj_dir/deps/tinyobjloader/tiny_obj_loader.cc.o: dep_cxx_compile $mujoco_dir/dependencies/tinyobjloader/tiny_obj_loader.cc
  dep_incs = -I$mujoco_dir/dependencies/tinyobjloader
  dep_cxxflags = -std=c++17
build $lib_dir/libtinyobjloader.a: archive $obj_dir/deps/tinyobjloader/tiny_obj_loader.cc.o

# lodepng
build $obj_dir/deps/lodepng/lodepng.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/lodepng/lodepng.cpp
  dep_incs = -I$mujoco_dir/dependencies/lodepng
  dep_cxxflags = -std=c++17
build $lib_dir/liblodepng.a: archive $obj_dir/deps/lodepng/lodepng.cpp.o

# qhullstatic_r
build $obj_dir/deps/qhull/libqhull_r/global_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/global_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/stat_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/stat_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/geom2_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/geom2_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/poly2_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/poly2_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/merge_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/merge_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/libqhull_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/libqhull_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/geom_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/geom_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/poly_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/poly_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/qset_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/qset_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/mem_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/mem_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/random_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/random_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/usermem_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/usermem_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/userprintf_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/userprintf_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/io_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/io_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/user_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/user_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/accessors_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/accessors_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/rboxlib_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/rboxlib_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $obj_dir/deps/qhull/libqhull_r/userprintf_rbox_r.c.o: dep_cc_compile $mujoco_dir/dependencies/qhull/src/libqhull_r/userprintf_rbox_r.c
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
build $lib_dir/libqhullstatic_r.a: archive $obj_dir/deps/qhull/libqhull_r/global_r.c.o $obj_dir/deps/qhull/libqhull_r/stat_r.c.o $obj_dir/deps/qhull/libqhull_r/geom2_r.c.o $obj_dir/deps/qhull/libqhull_r/poly2_r.c.o $obj_dir/deps/qhull/libqhull_r/merge_r.c.o $obj_dir/deps/qhull/libqhull_r/libqhull_r.c.o $obj_dir/deps/qhull/libqhull_r/geom_r.c.o $obj_dir/deps/qhull/libqhull_r/poly_r.c.o $obj_dir/deps/qhull/libqhull_r/qset_r.c.o $obj_dir/deps/qhull/libqhull_r/mem_r.c.o $obj_dir/deps/qhull/libqhull_r/random_r.c.o $obj_dir/deps/qhull/libqhull_r/usermem_r.c.o $obj_dir/deps/qhull/libqhull_r/userprintf_r.c.o $obj_dir/deps/qhull/libqhull_r/io_r.c.o $obj_dir/deps/qhull/libqhull_r/user_r.c.o $obj_dir/deps/qhull/libqhull_r/accessors_r.c.o $obj_dir/deps/qhull/libqhull_r/rboxlib_r.c.o $obj_dir/deps/qhull/libqhull_r/userprintf_rbox_r.c.o

# qhullcpp
build $obj_dir/deps/qhull/libqhullcpp/Coordinates.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/qhull/src/libqhullcpp/Coordinates.cpp
  dep_incs = -I$mujoco_dir/dependencies/qhull/src
  dep_cxxflags = -std=c++17
build $obj_dir/deps/qhull/libqhullcpp/PointCoordinates.cpp.o: dep_cxx_compile $mujoco_dir/dependencies/qhull/src/libqhullcpp/PointCoordinates.cpp
