build $obj_dir/engine_support.c.o: core_cc_compile $mujoco_dir/src/engine/engine_support.c | $out_dir/.stamp.core_deps
build $obj_dir/engine_util_blas.c.o: core_cc_compile $mujoco_dir/src/engine/engine_util_blas.c | $out_dir/.stamp.core_deps
