build test_physics: phony $builddir/test_physics
build test_camera_intrinsics: phony $builddir/test_camera_intrinsics
build test_object_draw_colors: phony $builddir/test_object_draw_colors
build test_alpha_mask: phony $builddir/test_alpha_mask
build test_pbr_ibl: phony $builddir/test_pbr_ibl
build test_pbr_multi_light: phony $builddir/test_pbr_multi_light
build test_pbr_normal_map: phony $builddir/test_pbr_normal_map
build test_pbr_orm: phony $builddir/test_pbr_orm
build test_pbr_terminal_room: phony $builddir/test_pbr_terminal_room
build test_render: phony $builddir/test_render
build test_cv: phony $builddir/test_cv
build test_depth: phony $builddir/test_depth
build test_texture2d: phony $builddir/test_texture2d
build test_roseviz_ui: phony $builddir/test_roseviz_ui
build test_roseviz_bridge: phony $builddir/test_roseviz_bridge
build test_roseviz_palette: phony $builddir/test_roseviz_palette
build test_roseviz_sidebar: phony $builddir/test_roseviz_sidebar
build test_roseviz_decode: phony $builddir/test_roseviz_decode
build test_roseviz_layout: phony $builddir/test_roseviz_layout
build test_roseviz_tf: phony $builddir/test_roseviz_tf
build test_roseviz_sim: phony $builddir/test_roseviz_sim
build trellis2: phony $builddir/trellis2
build robot_sim: phony $builddir/robot_sim
build roseviz: phony $builddir/roseviz
build roseviz_falling_ball: phony $builddir/roseviz_falling_ball
build check: phony $builddir/.test_physics.ok $builddir/.test_camera_intrinsics.ok $builddir/.test_object_draw_colors.ok $builddir/.test_alpha_mask.ok $builddir/.test_pbr_ibl.ok $builddir/.test_pbr_multi_light.ok $builddir/.test_pbr_normal_map.ok $builddir/.test_pbr_orm.ok $builddir/.test_render.ok $builddir/.test_cv.ok $builddir/.test_depth.ok $builddir/.test_texture2d.ok $builddir/.test_roseviz_ui.ok

