platform = libc
builddir = build

# MuJoCo paths (vendored via trellis)
mujoco_dir = ../../simulator/trellis/vendor/mujoco
mujoco_inc = -I$mujoco_dir/include
mujoco_lib = $mujoco_dir/build/lib/libmujoco.a
mujoco_extra = $mujoco_dir/build/lib/libtinyxml2.a $mujoco_dir/build/lib/liblodepng.a $mujoco_dir/build/lib/libqhullstatic_r.a $mujoco_dir/build/lib/libqhullcpp.a $mujoco_dir/build/lib/libccd.a $mujoco_dir/build/lib/libtinyobjloader.a

# Libraries
gl_libs = -lrt -lglfw -lGLESv2 -lEGL -lm -lpthread -ldl -lstdc++
rose_inc = -I../../rose/ros3/include -I../../rose/mirage/include -I../../rose/quicksand/include
rose_libs = ../../rose/ros3/build/ros3_so.o ../../rose/mirage/build/libmirage.a ../../rose/quicksand/build/libquicksand.a

# Pollyn Engine sources vendored into trellis2/
src_math3d = pollyn_engine/src/math3d.pka
src_color = pollyn_engine/src/color.pka
src_mesh = pollyn_engine/src/mesh.pka
src_material = pollyn_engine/src/material.pka
src_camera = pollyn_engine/src/camera.pka
src_input = pollyn_engine/src/input.pka
src_terminal = pollyn_engine/src/terminal.pka
src_text = pollyn_engine/src/text.pka
src_overlay2d = pollyn_engine/src/overlay2d.pka
src_cv = pollyn_engine/src/cv.pka
src_renderer = pollyn_engine/src/renderer.pka
src_engine_core = pollyn_engine/engine/core_engine.pka
src_engine_util_buffers = pollyn_engine/engine/util_buffers.pka
src_engine_util_mesh = pollyn_engine/engine/util_mesh.pka
src_engine_util_camera = pollyn_engine/engine/util_camera.pka
src_engine_util_text = pollyn_engine/engine/util_text.pka
src_engine_util_lights = pollyn_engine/engine/util_lights.pka

pka_srcs_engine = $src_math3d $src_color $src_mesh $src_material $src_camera $src_input $src_terminal $src_text $src_overlay2d $src_cv $src_renderer $src_engine_core $src_engine_util_buffers $src_engine_util_mesh $src_engine_util_camera $src_engine_util_text $src_engine_util_lights

# GL + MuJoCo shims
gl_shim = pollyn_engine/shim/pollyn_shim.c
mj_shim = shim/mujoco_shim.c
robot_shim = shim/mujoco_robot_shim.c

# Trellis2 Pika sources (paths relative to trellis2/ for ninja deps)
src_mujoco = src/mujoco.pka
src_scene = src/scene.pka
src_depth_sensor = src/depth_sensor.pka
src_camera_view = src/camera_view.pka
src_robot_sim = src/robot_sim.pka
src_robot_main = src/robot_main.pka
src_main = src/main.pka
src_roseviz_app = cmd/roseviz/roseviz_app.pka
src_roseviz_main = cmd/roseviz/roseviz_main.pka
src_roseviz_bridge = cmd/roseviz/roseviz_bridge.c
src_roseviz_falling_ball = cmd/roseviz/roseviz_falling_ball.c
src_image_view_main = cmd/image_view/image_view_main.pka
src_image_view_bridge = cmd/image_view/image_view_bridge.c

# Same paths relative to compiler/ for pikacc command
t2_math3d = ../../simulator/trellis2/pollyn_engine/src/math3d.pka
t2_color = ../../simulator/trellis2/pollyn_engine/src/color.pka
t2_mesh = ../../simulator/trellis2/pollyn_engine/src/mesh.pka
t2_material = ../../simulator/trellis2/pollyn_engine/src/material.pka
t2_camera = ../../simulator/trellis2/pollyn_engine/src/camera.pka
t2_input = ../../simulator/trellis2/pollyn_engine/src/input.pka
t2_terminal = ../../simulator/trellis2/pollyn_engine/src/terminal.pka
t2_text = ../../simulator/trellis2/pollyn_engine/src/text.pka
t2_overlay2d = ../../simulator/trellis2/pollyn_engine/src/overlay2d.pka
t2_cv = ../../simulator/trellis2/pollyn_engine/src/cv.pka
t2_renderer = ../../simulator/trellis2/pollyn_engine/src/renderer.pka
t2_engine_core = ../../simulator/trellis2/pollyn_engine/engine/core_engine.pka
t2_engine_util_buffers = ../../simulator/trellis2/pollyn_engine/engine/util_buffers.pka
t2_engine_util_mesh = ../../simulator/trellis2/pollyn_engine/engine/util_mesh.pka
t2_engine_util_camera = ../../simulator/trellis2/pollyn_engine/engine/util_camera.pka
t2_engine_util_text = ../../simulator/trellis2/pollyn_engine/engine/util_text.pka
t2_engine_util_lights = ../../simulator/trellis2/pollyn_engine/engine/util_lights.pka
t2_mujoco = ../../simulator/trellis2/src/mujoco.pka
t2_scene = ../../simulator/trellis2/src/scene.pka
t2_depth_sensor = ../../simulator/trellis2/src/depth_sensor.pka
t2_camera_view = ../../simulator/trellis2/src/camera_view.pka
t2_robot_sim = ../../simulator/trellis2/src/robot_sim.pka
t2_robot_main = ../../simulator/trellis2/src/robot_main.pka
t2_main = ../../simulator/trellis2/src/main.pka
t2_roseviz_app = ../../simulator/trellis2/cmd/roseviz/roseviz_app.pka
t2_roseviz_main = ../../simulator/trellis2/cmd/roseviz/roseviz_main.pka
t2_roseviz_bridge = ../../simulator/trellis2/cmd/roseviz/roseviz_bridge.c
t2_roseviz_falling_ball = ../../simulator/trellis2/cmd/roseviz/roseviz_falling_ball.c
t2_image_view_main = ../../simulator/trellis2/cmd/image_view/image_view_main.pka
t2_image_view_bridge = ../../simulator/trellis2/cmd/image_view/image_view_bridge.c
t2_test_physics = ../../simulator/trellis2/test/test_physics.pka
t2_test_camera_intrinsics = ../../simulator/trellis2/test/test_camera_intrinsics.pka
t2_test_object_draw_colors = ../../simulator/trellis2/test/test_object_draw_colors.pka
t2_test_alpha_mask = ../../simulator/trellis2/test/test_alpha_mask.pka
t2_test_pbr_ibl = ../../simulator/trellis2/test/test_pbr_ibl.pka
t2_test_pbr_multi_light = ../../simulator/trellis2/test/test_pbr_multi_light.pka
t2_test_pbr_normal_map = ../../simulator/trellis2/test/test_pbr_normal_map.pka
t2_test_pbr_orm = ../../simulator/trellis2/test/test_pbr_orm.pka
t2_test_pbr_terminal_room = ../../simulator/trellis2/test/test_pbr_terminal_room.pka
t2_test_render = ../../simulator/trellis2/test/test_render.pka
t2_test_cv = ../../simulator/trellis2/test/test_cv.pka
t2_test_depth = ../../simulator/trellis2/test/test_depth.pka
t2_test_texture2d = ../../simulator/trellis2/test/test_texture2d.pka
t2_test_roseviz_ui = ../../simulator/trellis2/test/test_roseviz_ui.pka
t2_test_roseviz_bridge = ../../simulator/trellis2/test/test_roseviz_bridge.pka
t2_test_roseviz_palette = ../../simulator/trellis2/test/test_roseviz_palette.pka
t2_test_roseviz_sidebar = ../../simulator/trellis2/test/test_roseviz_sidebar.pka
t2_test_roseviz_decode = ../../simulator/trellis2/test/test_roseviz_decode.pka
t2_test_roseviz_layout = ../../simulator/trellis2/test/test_roseviz_layout.pka
t2_test_roseviz_tf = ../../simulator/trellis2/test/test_roseviz_tf.pka
t2_test_roseviz_sim = ../../simulator/trellis2/test/test_roseviz_sim.pka
t2_gl_shim = ../../simulator/trellis2/pollyn_engine/shim/pollyn_shim.c
t2_mj_shim = ../../simulator/trellis2/shim/mujoco_shim.c
t2_robot_shim = ../../simulator/trellis2/shim/mujoco_robot_shim.c

pka_srcs_engine_compiler = $t2_math3d $t2_color $t2_mesh $t2_material $t2_camera $t2_input $t2_terminal $t2_text $t2_overlay2d $t2_cv $t2_renderer $t2_engine_core $t2_engine_util_buffers $t2_engine_util_mesh $t2_engine_util_camera $t2_engine_util_text $t2_engine_util_lights

# Shader dir
shader_dir = pollyn_engine/shaders
shader_inc = -I../../simulator/trellis2/pollyn_engine/shim

rule pikacc
  command = cd /home/alec/code/pika/pika && python3 ../../simulator/trellis2/pollyn_engine/shaders/embed.py && PATH="$$PWD/bin:$$PATH" LIBS="$libs" CFLAGS_EXTRA="$shader_inc $cflags" bin/pikacc.sh $srcs --platform $platform -o ../../simulator/trellis2/$out
  description = PIKACC $out

rule pikacc_sh
  command = cd /home/alec/code/pika/pika && python3 ../../simulator/trellis2/pollyn_engine/shaders/embed.py && PATH="$$PWD/bin:$$PATH" LIBS="$libs" CFLAGS_EXTRA="$shader_inc $cflags" bin/pikacc.sh $srcs --platform $platform -o ../../simulator/trellis2/$out
  description = PIKACC_SH $out

rule run
  command = cd /home/alec/code/simulator/trellis2 && $cmd && touch $out
  description = RUN $cmd

rule ccbin
  command = clang $cflags -o $out $in $libs
  description = CC $out

# --- Targets ---

# Link order: static libs first, then system libs (for symbol resolution)
all_libs = $mujoco_lib $mujoco_extra $gl_libs
robot_libs = $mujoco_lib $mujoco_extra $rose_libs $gl_libs
roseviz_libs = $rose_libs $gl_libs
bridge_libs = $rose_libs -lrt -lm -lpthread -ldl

build $builddir/.rose_deps.ok: run
  cmd = make -C ../../rose/mirage CC=clang && make -C ../../rose/quicksand CC=clang && make -C ../../rose/ros3 CC=clang build/ros3_so.o build/rosecore build/rosetopic build/test_net_pub

build $builddir/roseviz_falling_ball: ccbin $src_roseviz_falling_ball | $builddir/.rose_deps.ok
  libs = $bridge_libs
  cflags = $rose_inc -O3 -std=c11 -Wall -Wextra -Werror

# Physics test
build $builddir/test_physics: pikacc $src_math3d $src_color $src_mesh $src_material $src_camera $src_input $src_terminal $src_text $src_overlay2d $src_cv $src_renderer $src_engine_core $src_engine_util_buffers $src_engine_util_mesh $src_engine_util_camera $src_engine_util_text $src_engine_util_lights $src_mujoco test/test_physics.pka $gl_shim $mj_shim
  srcs = $pka_srcs_engine_compiler $t2_mujoco $t2_test_physics $t2_gl_shim $t2_mj_shim
  libs = $all_libs
  cflags = $mujoco_inc

# Camera intrinsics unit test
build $builddir/test_camera_intrinsics: pikacc $src_math3d $src_camera test/test_camera_intrinsics.pka
  srcs = $t2_math3d $t2_camera $t2_test_camera_intrinsics
  libs =
  cflags =

build $builddir/.test_camera_intrinsics.ok: run | $builddir/test_camera_intrinsics
  cmd = ./$builddir/test_camera_intrinsics

# Object draw color test (needs GL via xvfb)
build $builddir/test_object_draw_colors: pikacc_sh $src_math3d $src_color $src_mesh $src_material $src_camera $src_input $src_terminal $src_text $src_overlay2d $src_cv $src_renderer $src_engine_core $src_engine_util_buffers $src_engine_util_mesh $src_engine_util_camera $src_engine_util_text $src_engine_util_lights test/test_object_draw_colors.pka $gl_shim | $shader_dir/flat.vert $shader_dir/flat.frag $shader_dir/pbr.vert $shader_dir/pbr.frag $shader_dir/line.vert $shader_dir/line.frag $shader_dir/depth.vert $shader_dir/depth.frag $shader_dir/constant.vert $shader_dir/constant.frag $shader_dir/text.vert $shader_dir/text.frag
  srcs = $pka_srcs_engine_compiler $t2_test_object_draw_colors $t2_gl_shim
  libs = $gl_libs
  cflags = -I../trellis2/pollyn_engine/shim

build $builddir/.test_object_draw_colors.ok: run | $builddir/test_object_draw_colors
  cmd = LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -a -s "-screen 0 640x480x24" ./$builddir/test_object_draw_colors

# Alpha-mask special-pass test (needs GL via xvfb)
build $builddir/test_alpha_mask: pikacc_sh $src_math3d $src_color $src_mesh $src_material $src_camera $src_input $src_terminal $src_text $src_overlay2d $src_cv $src_renderer $src_engine_core $src_engine_util_buffers $src_engine_util_mesh $src_engine_util_camera $src_engine_util_text $src_engine_util_lights test/test_alpha_mask.pka $gl_shim | $shader_dir/flat.vert $shader_dir/flat.frag $shader_dir/pbr.vert $shader_dir/pbr.frag $shader_dir/line.vert $shader_dir/line.frag $shader_dir/depth.vert $shader_dir/depth.frag $shader_dir/constant.vert $shader_dir/constant.frag $shader_dir/text.vert $shader_dir/text.frag
  srcs = $pka_srcs_engine_compiler $t2_test_alpha_mask $t2_gl_shim
  libs = $gl_libs
  cflags = -I../trellis2/pollyn_engine/shim

build $builddir/.test_alpha_mask.ok: run | $builddir/test_alpha_mask
  cmd = LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -a -s "-screen 0 640x480x24" ./$builddir/test_alpha_mask

# PBR normal-map test (needs GL via xvfb)
build $builddir/test_pbr_normal_map: pikacc_sh $src_math3d $src_color $src_mesh $src_material $src_camera $src_input $src_terminal $src_text $src_overlay2d $src_cv $src_renderer $src_engine_core $src_engine_util_buffers $src_engine_util_mesh $src_engine_util_camera $src_engine_util_text $src_engine_util_lights test/test_pbr_normal_map.pka $gl_shim | $shader_dir/flat.vert $shader_dir/flat.frag $shader_dir/pbr.vert $shader_dir/pbr.frag $shader_dir/line.vert $shader_dir/line.frag $shader_dir/depth.vert $shader_dir/depth.frag $shader_dir/constant.vert $shader_dir/constant.frag $shader_dir/text.vert $shader_dir/text.frag
  srcs = $pka_srcs_engine_compiler $t2_test_pbr_normal_map $t2_gl_shim
  libs = $gl_libs
  cflags = -I../trellis2/pollyn_engine/shim

build $builddir/.test_pbr_normal_map.ok: run | $builddir/test_pbr_normal_map
  cmd = LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -a -s "-screen 0 640x480x24" ./$builddir/test_pbr_normal_map

# PBR IBL test (needs GL via xvfb)
build $builddir/test_pbr_ibl: pikacc_sh $src_math3d $src_color $src_mesh $src_material $src_camera $src_input $src_terminal $src_text $src_overlay2d $src_cv $src_renderer $src_engine_core $src_engine_util_buffers $src_engine_util_mesh $src_engine_util_camera $src_engine_util_text $src_engine_util_lights test/test_pbr_ibl.pka $gl_shim | $shader_dir/flat.vert $shader_dir/flat.frag $shader_dir/pbr.vert $shader_dir/pbr.frag $shader_dir/line.vert $shader_dir/line.frag $shader_dir/depth.vert $shader_dir/depth.frag $shader_dir/constant.vert $shader_dir/constant.frag $shader_dir/text.vert $shader_dir/text.frag
  srcs = $pka_srcs_engine_compiler $t2_test_pbr_ibl $t2_gl_shim
  libs = $gl_libs
  cflags = -I../trellis2/pollyn_engine/shim

build $builddir/.test_pbr_ibl.ok: run | $builddir/test_pbr_ibl
  cmd = LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -a -s "-screen 0 640x480x24" ./$builddir/test_pbr_ibl

# PBR multi-light test (needs GL via xvfb)
build $builddir/test_pbr_multi_light: pikacc_sh $src_math3d $src_color $src_mesh $src_material $src_camera $src_input $src_terminal $src_text $src_overlay2d $src_cv $src_renderer $src_engine_core $src_engine_util_buffers $src_engine_util_mesh $src_engine_util_camera $src_engine_util_text $src_engine_util_lights test/test_pbr_multi_light.pka $gl_shim | $shader_dir/flat.vert $shader_dir/flat.frag $shader_dir/pbr.vert $shader_dir/pbr.frag $shader_dir/line.vert $shader_dir/line.frag $shader_dir/depth.vert $shader_dir/depth.frag $shader_dir/constant.vert $shader_dir/constant.frag $shader_dir/text.vert $shader_dir/text.frag
  srcs = $pka_srcs_engine_compiler $t2_test_pbr_multi_light $t2_gl_shim
  libs = $gl_libs
  cflags = -I../trellis2/pollyn_engine/shim

build $builddir/.test_pbr_multi_light.ok: run | $builddir/test_pbr_multi_light
  cmd = LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -a -s "-screen 0 640x480x24" ./$builddir/test_pbr_multi_light

# PBR ORM test (needs GL via xvfb)
build $builddir/test_pbr_orm: pikacc_sh $src_math3d $src_color $src_mesh $src_material $src_camera $src_input $src_terminal $src_text $src_overlay2d $src_cv $src_renderer $src_engine_core $src_engine_util_buffers $src_engine_util_mesh $src_engine_util_camera $src_engine_util_text $src_engine_util_lights test/test_pbr_orm.pka $gl_shim | $shader_dir/flat.vert $shader_dir/flat.frag $shader_dir/pbr.vert $shader_dir/pbr.frag $shader_dir/line.vert $shader_dir/line.frag $shader_dir/depth.vert $shader_dir/depth.frag $shader_dir/constant.vert $shader_dir/constant.frag $shader_dir/text.vert $shader_dir/text.frag $shader_dir/blit.vert $shader_dir/blit.frag
  srcs = $pka_srcs_engine_compiler $t2_test_pbr_orm $t2_gl_shim
  libs = $gl_libs
  cflags = -I../trellis2/pollyn_engine/shim

build $builddir/.test_pbr_orm.ok: run | $builddir/test_pbr_orm
  cmd = LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -a -s "-screen 0 640x480x24" ./$builddir/test_pbr_orm

# Terminal PBR room demo/test (prints ANSI half-block output; manual run)
build $builddir/test_pbr_terminal_room: pikacc_sh $src_math3d $src_color $src_mesh $src_material $src_camera $src_input $src_terminal $src_text $src_overlay2d $src_cv $src_renderer $src_engine_core $src_engine_util_buffers $src_engine_util_mesh $src_engine_util_camera $src_engine_util_text $src_engine_util_lights test/test_pbr_terminal_room.pka $gl_shim | $shader_dir/flat.vert $shader_dir/flat.frag $shader_dir/pbr.vert $shader_dir/pbr.frag $shader_dir/line.vert $shader_dir/line.frag $shader_dir/depth.vert $shader_dir/depth.frag $shader_dir/constant.vert $shader_dir/constant.frag $shader_dir/text.vert $shader_dir/text.frag $shader_dir/blit.vert $shader_dir/blit.frag
  srcs = $pka_srcs_engine_compiler $t2_test_pbr_terminal_room $t2_gl_shim
  libs = $gl_libs
  cflags = -I../trellis2/pollyn_engine/shim

# Render test (needs GL via xvfb)
build $builddir/test_render: pikacc $src_math3d $src_color $src_mesh $src_material $src_camera $src_input $src_terminal $src_text $src_overlay2d $src_cv $src_renderer $src_engine_core $src_engine_util_buffers $src_engine_util_mesh $src_engine_util_camera $src_engine_util_text $src_engine_util_lights $src_mujoco $src_scene test/test_render.pka $gl_shim $mj_shim | $shader_dir/flat.vert $shader_dir/flat.frag $shader_dir/pbr.vert $shader_dir/pbr.frag $shader_dir/line.vert $shader_dir/line.frag $shader_dir/depth.vert $shader_dir/depth.frag $shader_dir/constant.vert $shader_dir/constant.frag $shader_dir/text.vert $shader_dir/text.frag
  srcs = $pka_srcs_engine_compiler $t2_mujoco $t2_scene $t2_test_render $t2_gl_shim $t2_mj_shim
  libs = $all_libs
  cflags = $mujoco_inc

# Full viewer
build $builddir/trellis2: pikacc $src_math3d $src_color $src_mesh $src_material $src_camera $src_input $src_terminal $src_text $src_overlay2d $src_cv $src_renderer $src_engine_core $src_engine_util_buffers $src_engine_util_mesh $src_engine_util_camera $src_engine_util_text $src_engine_util_lights $src_mujoco $src_scene $src_depth_sensor $src_camera_view $src_main $gl_shim $mj_shim | $shader_dir/flat.vert $shader_dir/flat.frag $shader_dir/pbr.vert $shader_dir/pbr.frag $shader_dir/line.vert $shader_dir/line.frag $shader_dir/depth.vert $shader_dir/depth.frag $shader_dir/constant.vert $shader_dir/constant.frag $shader_dir/text.vert $shader_dir/text.frag $shader_dir/blit.vert $shader_dir/blit.frag
  srcs = $pka_srcs_engine_compiler $t2_mujoco $t2_scene $t2_depth_sensor $t2_camera_view $t2_main $t2_gl_shim $t2_mj_shim
  libs = $all_libs
  cflags = $mujoco_inc

# Threaded rover simulator
build $builddir/robot_sim: pikacc $src_math3d $src_color $src_mesh $src_material $src_camera $src_input $src_terminal $src_text $src_overlay2d $src_cv $src_renderer $src_engine_core $src_engine_util_buffers $src_engine_util_mesh $src_engine_util_camera $src_engine_util_text $src_engine_util_lights $src_mujoco $src_scene $src_depth_sensor $src_camera_view $src_robot_sim $src_robot_main $gl_shim $robot_shim | $shader_dir/flat.vert $shader_dir/flat.frag $shader_dir/pbr.vert $shader_dir/pbr.frag $shader_dir/line.vert $shader_dir/line.frag $shader_dir/depth.vert $shader_dir/depth.frag $shader_dir/constant.vert $shader_dir/constant.frag $shader_dir/text.vert $shader_dir/text.frag $shader_dir/blit.vert $shader_dir/blit.frag $builddir/.rose_deps.ok
  srcs = $pka_srcs_engine_compiler $t2_mujoco $t2_scene $t2_depth_sensor $t2_camera_view $t2_robot_sim $t2_robot_main $t2_gl_shim $t2_robot_shim
  libs = $robot_libs
  cflags = $mujoco_inc $rose_inc -I../../simulator/trellis2/pollyn_engine/shim

# Roseviz shell (images + point clouds only)
build $builddir/roseviz: pikacc $src_math3d $src_color $src_mesh $src_material $src_camera $src_input $src_terminal $src_text $src_overlay2d $src_cv $src_renderer $src_engine_core $src_engine_util_buffers $src_engine_util_mesh $src_engine_util_camera $src_engine_util_text $src_engine_util_lights $src_roseviz_app $src_roseviz_main $src_roseviz_bridge $gl_shim | $shader_dir/flat.vert $shader_dir/flat.frag $shader_dir/pbr.vert $shader_dir/pbr.frag $shader_dir/line.vert $shader_dir/line.frag $shader_dir/depth.vert $shader_dir/depth.frag $shader_dir/constant.vert $shader_dir/constant.frag $shader_dir/text.vert $shader_dir/text.frag $shader_dir/blit.vert $shader_dir/blit.frag $builddir/.rose_deps.ok $builddir/roseviz_falling_ball
  srcs = $pka_srcs_engine_compiler $t2_roseviz_app $t2_roseviz_main $t2_roseviz_bridge $t2_gl_shim
  libs = $roseviz_libs
  cflags = $rose_inc

# Simple ROS3 image viewer
