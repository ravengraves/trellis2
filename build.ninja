# Direct build recipes, following Pika's small Ninja workflow.
# Tool/dependency overrides are environment variables, e.g. PIKACC=/path/pikacc.
# Console recipes run sequentially, including shader and vendor updates.
rule shell
  command = $cmd
  pool = console

pikacc = $${PIKACC:-pikacc}
python = $${PYTHON:-python3}
ninja = $${NINJA:-ninja}
rose_prefix = $${ROSE_PREFIX:-/usr/local}
mujoco_dir = $${MUJOCO_DIR:-vendor/mujoco}
mujoco_lib_dir = $${MUJOCO_LIB_DIR:-$mujoco_dir/build/lib}
cflags = $${CFLAGS:--O3 -std=c11 -Wall -Wextra -Werror}
pikaflags = $${PIKAFLAGS--R}
gl_libs = $${GL_LIBS:--lglfw -lGLESv2 -lEGL}
system_libs = -lrt -lm -lpthread -ldl -lstdc++
rose_cflags = $${ROSE_CFLAGS:--I"$rose_prefix/include"}
rose_libs = $${ROSE_LIBS:--L"$rose_prefix/lib" -Wl,-rpath,"$rose_prefix/lib" -lros3 -lmirage -lquicksand}
engine_cflags = -Iinternal/pollyn_engine/shim -Iinternal/pollyn_engine/vendor
mujoco_cflags = -I"$mujoco_dir/include"
mujoco_libs = "$mujoco_lib_dir/libmujoco.a" "$mujoco_lib_dir/libtinyxml2.a" "$mujoco_lib_dir/liblodepng.a" "$mujoco_lib_dir/libqhullstatic_r.a" "$mujoco_lib_dir/libqhullcpp.a" "$mujoco_lib_dir/libccd.a" "$mujoco_lib_dir/libtinyobjloader.a"
engine = $
  internal/pollyn_engine/src/math3d.pka $
  internal/pollyn_engine/src/color.pka $
  internal/pollyn_engine/src/mesh.pka $
  internal/pollyn_engine/src/material.pka $
  internal/pollyn_engine/src/camera.pka $
  internal/pollyn_engine/src/input.pka $
  internal/pollyn_engine/src/terminal.pka $
  internal/pollyn_engine/src/text.pka $
  internal/pollyn_engine/src/overlay2d.pka $
  internal/pollyn_engine/src/cv.pka $
  internal/pollyn_engine/src/renderer.pka $
  internal/pollyn_engine/engine/core_engine.pka $
  internal/pollyn_engine/engine/util_buffers.pka $
  internal/pollyn_engine/engine/util_mesh.pka $
  internal/pollyn_engine/engine/util_camera.pka $
  internal/pollyn_engine/engine/util_text.pka $
  internal/pollyn_engine/engine/util_lights.pka
scene = $
  cmd/urc_simulator/mujoco.pka $
  cmd/urc_simulator/scene.pka $
  cmd/urc_simulator/env_asset.pka $
  cmd/urc_simulator/depth_sensor.pka $
  cmd/urc_simulator/camera_view.pka
bindings = $
  internal/bindings/ros3/ros3.pka $
  internal/bindings/ros3/mirage.pka
engine_shim = internal/pollyn_engine/shim/pollyn_shim.c
cc = $${CC:-cc}

# Real timestamps preserve source changes when a restat dependency stays unchanged.
rule source_stamp
  command = mkdir -p build && touch $out
  description = DEPS $out

# Shared source dependency groups.
build build/engine.stamp: source_stamp $
  internal/pollyn_engine/src/math3d.pka $
  internal/pollyn_engine/src/color.pka $
  internal/pollyn_engine/src/mesh.pka $
  internal/pollyn_engine/src/material.pka $
  internal/pollyn_engine/src/camera.pka $
  internal/pollyn_engine/src/input.pka $
  internal/pollyn_engine/src/terminal.pka $
  internal/pollyn_engine/src/text.pka $
  internal/pollyn_engine/src/overlay2d.pka $
  internal/pollyn_engine/src/cv.pka $
  internal/pollyn_engine/src/renderer.pka $
  internal/pollyn_engine/engine/core_engine.pka $
  internal/pollyn_engine/engine/util_buffers.pka $
  internal/pollyn_engine/engine/util_mesh.pka $
  internal/pollyn_engine/engine/util_camera.pka $
  internal/pollyn_engine/engine/util_text.pka $
  internal/pollyn_engine/engine/util_lights.pka $
  $engine_shim $
  internal/pollyn_engine/shim/shaders.h $
  internal/pollyn_engine/vendor/stb_image.h
build build/scene.stamp: source_stamp $
  cmd/urc_simulator/mujoco.pka $
  cmd/urc_simulator/scene.pka $
  cmd/urc_simulator/env_asset.pka $
  cmd/urc_simulator/depth_sensor.pka $
  cmd/urc_simulator/camera_view.pka
build build/bindings.stamp: source_stamp $
  internal/bindings/ros3/ros3.pka $
  internal/bindings/ros3/mirage.pka

# Shared compiler arguments.
physics_flags = $engine_cflags $mujoco_cflags $mujoco_libs $gl_libs

rule pika
  command = mkdir -p build && $pikacc $sources $pikaflags --cc "$cc" --platform libc -o $out -- $cc_args $system_libs
  pool = console

# Check the nested build each time; only changed libraries invalidate consumers.
rule mujoco_build
  command = mkdir -p build && $ninja -C "$mujoco_dir" -j2 mujoco && $
    sha256sum $mujoco_libs > build/mujoco.stamp.tmp && $
    (cmp -s build/mujoco.stamp.tmp build/mujoco.stamp || cp build/mujoco.stamp.tmp build/mujoco.stamp) && $
    rm build/mujoco.stamp.tmp
  restat = 1
  pool = console

build mujoco build/mujoco.stamp: mujoco_build

rule bridge
  command = mkdir -p build && $cc $cflags $includes -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  pool = console

shader_dir = internal/pollyn_engine/shaders
build internal/pollyn_engine/shim/shaders.h: shell $shader_dir/embed.py $
  $shader_dir/flat.vert $shader_dir/flat.frag $
  $shader_dir/pbr.vert $shader_dir/pbr.frag $
  $shader_dir/cell.vert $shader_dir/cell.frag $
  $shader_dir/wire.vert $shader_dir/wire.frag $
  $shader_dir/line.vert $shader_dir/line.frag $
  $shader_dir/depth.vert $shader_dir/depth.frag $
  $shader_dir/constant.vert $shader_dir/constant.frag $
  $shader_dir/text.vert $shader_dir/text.frag $
  $shader_dir/blit.vert $shader_dir/blit.frag $
  $shader_dir/dust.vert $shader_dir/dust.frag $
  $shader_dir/radiation.vert $shader_dir/radiation.frag $
  $shader_dir/laser_glare.vert $shader_dir/laser_glare.frag
  cmd = $python internal/pollyn_engine/shaders/embed.py

build shaders: phony internal/pollyn_engine/shim/shaders.h

build build/robot_shim.o: bridge internal/shim/mujoco_robot_shim.c
  includes = $rose_cflags $mujoco_cflags
build robot_bridge: phony build/robot_shim.o

# Applications.
build build/urc_simulator: pika build/engine.stamp build/scene.stamp internal/bindings/ros3/ros3.pka cmd/urc_simulator/robot_sim.pka cmd/urc_simulator/main.pka | build/mujoco.stamp build/robot_shim.o
  sources = $engine $scene internal/bindings/ros3/ros3.pka cmd/urc_simulator/robot_sim.pka cmd/urc_simulator/main.pka $engine_shim
  cc_args = $engine_cflags $mujoco_cflags $rose_cflags build/robot_shim.o $mujoco_libs $rose_libs $gl_libs
build urc_simulator: phony build/urc_simulator

build build/trellis2: pika build/engine.stamp build/scene.stamp cmd/urc_simulator/viewer_main.pka internal/shim/mujoco_shim.c | build/mujoco.stamp
  sources = $engine $scene cmd/urc_simulator/viewer_main.pka $engine_shim internal/shim/mujoco_shim.c
  cc_args = $physics_flags
build trellis2: phony build/trellis2

build build/image_view: pika build/engine.stamp cmd/image_view/image_view_main.pka cmd/image_view/image_view_bridge.c
  sources = $engine cmd/image_view/image_view_main.pka cmd/image_view/image_view_bridge.c $engine_shim
  cc_args = $engine_cflags $rose_cflags $rose_libs $gl_libs
build image_view: phony build/image_view

build build/vjoy: pika build/engine.stamp build/bindings.stamp cmd/vjoy/vjoy_main.pka
  sources = $engine $bindings cmd/vjoy/vjoy_main.pka $engine_shim
  cc_args = $engine_cflags $rose_cflags $rose_libs $gl_libs
build vjoy: phony build/vjoy

# Application group.
build all: phony $
  urc_simulator $
  trellis2 $
  image_view $
  vjoy

subninja test/build.ninja

default urc_simulator
