// test_depth.pka — Depth sensor tests for MuJoCo scene rendering.

use fb;
use fmt;

export fn main() void = {
	fmt::Printsln("=== test_depth ===");

	// --- Setup ---
	let path: [20]u8 = ['m', 'o', 'd', 'e', 'l', 's', '/', 'b', 'a', 'l', 'l', '.', 'x', 'm', 'l', 0, 0, 0, 0, 0];
	let rc = mj_shim_load(&path[0z]);
	assert(rc == 0, "model load");

	let rt = e2_runtime_init(E2_MODE_HEADLESS, 64, 48);
	assert(e2_runtime_start(&rt), "engine start");

	let sc = scene_new();
	scene_init(&sc);
	scene_update(&sc);

	let geom_pass = util_geom_pass_init();
	scene_geom_pass(&sc, &geom_pass);

	let lights = util_light_buffer_init();
	let env = env_default();

	let tbuf: [256]u8 = [0...];
	let tf = fmt::New(tbuf[0z..256z]);

	fmt::Clear(&tf);
	fmt::Write(&tf, "  geom draws: ");
	fmt::Wi64(&tf, geom_pass.count: i64);
	fmt::Println(&tf);

	// --- Direct call to e2_render_camera_to_buffers (bypass DepthSensor) ---
	// Camera close to ball at (0, 0, 2), world radius 0.1
	let cam = freecam_new(
		vec3_new(0.0, -1.5, 2.0),
		vec3_new(0.0, 0.0, 2.0),
		60.0, 0.1, 20.0);

	let out_rgb: [18432]u8 = [0...];   // 64*48*3 (unused, but needed)
	let out_depth: [6144]f32 = [0.0...]; // 64*48 * 2 (extra)
	let empty = util_color_pass_init();

	let ok = e2_render_camera_to_buffers(&cam, E2_GEOM_MODE_PBR,
		geom_pass.draws[0z..(geom_pass.count: size)],
		empty.draws[0z..0z],
		empty.draws[0z..0z],
		util_light_buffer_slice(&lights),
		&env,
		out_rgb[0z..],
		out_depth[0z..],
		64, 48);
	assert(ok, "camera render ok");

	// --- Print depth at center and a grid of pixels ---
	let cx: i32 = 32;
	let cy: i32 = 24;
	let center_d = out_depth[(cy * 64 + cx): size];

	fmt::Clear(&tf);
	fmt::Write(&tf, "  center(32,24) depth: ");
	fmt::Wf64(&tf, center_d: f64, 4);
	fmt::Println(&tf);

	// Print depth at 5x5 grid around center
	for (let dy: i32 = -2; dy <= 2; dy += 1) {
		fmt::Clear(&tf);
		fmt::Write(&tf, "  row ");
		fmt::Wi64(&tf, (cy + dy): i64);
		fmt::Write(&tf, ": ");
		for (let dx: i32 = -6; dx <= 6; dx += 3) {
			let px = cx + dx;
			let py = cy + dy;
			let d = out_depth[(py * 64 + px): size];
			fmt::Wf64(&tf, d: f64, 2);
			fmt::Write(&tf, " ");
		};
		fmt::Println(&tf);
	};

	// Count non-zero and near depth pixels
	let total: i32 = 64 * 48;
	let depth_lighting_a: [6144]f32 = [0.0...];
	for (let i: i32 = 0; i < total; i += 1) {
		depth_lighting_a[i: size] = out_depth[i: size];
	};
	let nonzero: i32 = 0;
	let near5: i32 = 0;
	let min_d: f32 = 20.0;
	for (let i: i32 = 0; i < total; i += 1) {
		let dv = out_depth[i: size];
		if (dv > 0.001) { nonzero = nonzero + 1; };
		if (dv > 0.001 && dv < 5.0) { near5 = near5 + 1; };
		if (dv > 0.001 && dv < min_d) { min_d = dv; };
	};

	fmt::Clear(&tf);
	fmt::Write(&tf, "  nonzero: ");
	fmt::Wi64(&tf, nonzero: i64);
	fmt::Write(&tf, " near(<5): ");
	fmt::Wi64(&tf, near5: i64);
	fmt::Write(&tf, " min: ");
	fmt::Wf64(&tf, min_d: f64, 4);
	fmt::Println(&tf);

	// Count non-black RGB pixels (verify something was rendered)
	let rgb_nonblack: i32 = 0;
	for (let ri: i32 = 0; ri < total; ri += 1) {
		let idx: size = (ri * 3): size;
		if (out_rgb[idx] > 10u8 || out_rgb[idx + 1z] > 10u8 || out_rgb[idx + 2z] > 10u8) {
			rgb_nonblack = rgb_nonblack + 1;
		};
	};
	fmt::Clear(&tf);
	fmt::Write(&tf, "  rgb non-black: ");
	fmt::Wi64(&tf, rgb_nonblack: i64);
	fmt::Println(&tf);

	// --- Assertions ---
	assert(nonzero > 0, "some depth pixels rendered");
	assert(min_d < 10.0, "min depth is a real surface");

	// --- Test ball depth: center should see ball (depth ~1.4) ---
	// Ball world radius = 0.5 * 0.2 = 0.1, camera dist 1.5, surface at 1.4
	assert(center_d > 0.1, "center depth above znear");
	fmt::Printsln("  depth rendering works: OK");

	let alt_lights = util_light_buffer_init();
	util_light_buffer_clear(&alt_lights);
	util_light_buffer_add(&alt_lights,
		light_directional(vec3_new(1.0, 0.3, -0.2), color_new(0.2, 0.7, 1.0, 1.0)));
	let alt_env = env_default();
	alt_env.sky_color = color_new(1.0, 0.0, 0.0, 1.0);
	alt_env.horizon_color = color_new(0.0, 1.0, 0.0, 1.0);
	alt_env.ground_color = color_new(0.0, 0.0, 1.0, 1.0);
	let out_depth_alt: [6144]f32 = [0.0...];
	let ok_light = e2_render_camera_to_buffers(&cam, E2_GEOM_MODE_PBR,
		geom_pass.draws[0z..(geom_pass.count: size)],
		empty.draws[0z..0z],
		empty.draws[0z..0z],
		util_light_buffer_slice(&alt_lights),
		&alt_env,
		out_rgb[0z..],
		out_depth_alt[0z..],
		64, 48);
	assert(ok_light, "alt light render ok");
	let max_depth_delta: f32 = 0.0;
	for (let i: i32 = 0; i < total; i += 1) {
		let depth_delta = out_depth_alt[i: size] - depth_lighting_a[i: size];
		let adelta = depth_delta;
		if (adelta < 0.0) { adelta = 0.0 - adelta; };
		if (adelta > max_depth_delta) {
			max_depth_delta = adelta;
		};
	};
	fmt::Clear(&tf);
	fmt::Write(&tf, "  max depth delta under lighting change: ");
	fmt::Wf64(&tf, max_depth_delta: f64, 6, "dec");
	fmt::Println(&tf);
	assert(max_depth_delta < 0.001,
		"depth rendering stays independent of lighting and environment");

	// ========== Now test with DepthSensor API ==========
	let sensor = depth_sensor_new(
		vec3_new(0.0, -1.5, 2.0),
		vec3_new(0.0, 0.0, 2.0),
		60.0, 0.1, 20.0, 64, 48);

	scene_geom_pass(&sc, &geom_pass);
	let draws = geom_pass.draws[0z..(geom_pass.count: size)];
	let ok2 = depth_sensor_render(&sensor, draws,
		util_light_buffer_slice(&lights), &env);
	assert(ok2, "sensor render ok");

	let sensor_center = depth_sensor_center_depth(&sensor);
	let sensor_valid = depth_sensor_count_valid(&sensor);

	fmt::Clear(&tf);
	fmt::Write(&tf, "  sensor center: ");
	fmt::Wf64(&tf, sensor_center: f64, 4);
	fmt::Write(&tf, " valid: ");
	fmt::Wi64(&tf, sensor_valid: i64);
	fmt::Println(&tf);

	// --- Test physics: ball falls and depth changes ---
	for (let s1: i32 = 0; s1 < 500; s1 += 1) {
		mj_shim_step();
	};
	scene_update(&sc);
	scene_geom_pass(&sc, &geom_pass);
	let draws1 = geom_pass.draws[0z..(geom_pass.count: size)];
	let ok3 = depth_sensor_render(&sensor, draws1,
		util_light_buffer_slice(&lights), &env);
	assert(ok3, "post-physics render ok");

	let post_center = depth_sensor_center_depth(&sensor);
	fmt::Clear(&tf);
	fmt::Write(&tf, "  post-fall center: ");
	fmt::Wf64(&tf, post_center: f64, 4);
	fmt::Println(&tf);

	let delta = post_center - sensor_center;
	if (delta < 0.0) { delta = 0.0 - delta; };
	assert(delta > 0.05, "depth changed after physics");
	fmt::Printsln("  test_depth_changes_with_physics: OK");

	// --- Ground sensor ---
	let ground_sensor = depth_sensor_new(
		vec3_new(0.0, -2.0, 1.0),
		vec3_new(0.0, 0.0, 0.0),
		60.0, 0.1, 20.0, 64, 48);
	scene_geom_pass(&sc, &geom_pass);
	let draws2 = geom_pass.draws[0z..(geom_pass.count: size)];
	let ok4 = depth_sensor_render(&ground_sensor, draws2,
		util_light_buffer_slice(&lights), &env);
	assert(ok4, "ground sensor render ok");

	let ground_center = depth_sensor_center_depth(&ground_sensor);
	let ground_valid = depth_sensor_count_valid(&ground_sensor);
	fmt::Clear(&tf);
	fmt::Write(&tf, "  ground center: ");
	fmt::Wf64(&tf, ground_center: f64, 3);
	fmt::Write(&tf, " valid: ");
	fmt::Wi64(&tf, ground_valid: i64);
	fmt::Println(&tf);

	assert(ground_valid > 50, "ground has depth coverage");
	assert(ground_center > 0.5, "ground depth plausible");
	fmt::Printsln("  test_ground_depth: OK");

	// --- Cleanup ---
	scene_destroy(&sc);
	mj_shim_free();
	e2_runtime_shutdown(&rt);
	fmt::Printsln("=== test_depth passed ===");
};
