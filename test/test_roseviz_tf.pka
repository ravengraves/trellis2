use fb;
use proc;

let roseviz_tf_test_app_words: [1048576]u64 = [0...];

export fn main() void = {
	fb::Printsln("=== test_roseviz_tf ===");

	let rt = e2_runtime_init(E2_MODE_HEADLESS, 1280, 800);
	assert(e2_runtime_start(&rt), "engine start");
	assert(e2_init_blit_shader(), "blit shader");

	let app: *RosevizApp = &roseviz_tf_test_app_words: *RosevizApp;
	assert(roseviz_app_init(app), "app init");

	for (let i: i32 = 0; i < 120; i += 1) {
		roseviz_render_frame(&rt, app);
		if (app.tf_line_count > 0 && app.tf_error_code == ROSEVIZ_ERR_NONE) {
			break;
		};
		proc::MilliSleep(20);
	};
	assert(app.tf_line_count > 0, "basic tf overlay renders");
	assert(app.tf_error_code == ROSEVIZ_ERR_NONE, "basic tf valid");

	let cycle_topic: [15]u8 = ['/', 'd', 'e', 'm', 'o', '/', 't', 'f', '/', 'c', 'y', 'c', 'l', 'e', 0];
	roseviz_bind_transform_topic(app, cycle_topic[0z..15z], 14);
	for (let i: i32 = 0; i < 120; i += 1) {
		roseviz_render_frame(&rt, app);
		if (app.tf_error_code != ROSEVIZ_ERR_NONE) {
			break;
		};
		proc::MilliSleep(20);
	};
	assert(app.tf_error_code == ROSEVIZ_ERR_TF_CYCLE, "cycle tf is detected");

	roseviz_app_shutdown(app);
	e2_runtime_shutdown(&rt);
	fb::Printsln("=== test_roseviz_tf passed ===");
};
