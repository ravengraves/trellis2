use fb;
use proc;

let roseviz_layout_test_app_words: [1048576]u64 = [0...];

fn wait_for_renders(rt: *E2Runtime, app: *RosevizApp, tile_a: *RosevizTile, tile_b: *RosevizTile) bool = {
	for (let i: i32 = 0; i < 120; i += 1) {
		roseviz_render_frame(rt, app);
		if (tile_a.render_count > 0 && tile_b.render_count > 0) {
			return true;
		};
		proc::MilliSleep(20);
	};
	return false;
};

export fn main() void = {
	fb::Printsln("=== test_roseviz_layout ===");

	let rt = e2_runtime_init(E2_MODE_HEADLESS, 1280, 800);
	assert(e2_runtime_start(&rt), "engine start");
	assert(e2_init_blit_shader(), "blit shader");

	let app: *RosevizApp = &roseviz_layout_test_app_words: *RosevizApp;
	assert(roseviz_app_init(app), "app init");

	let ws0 = &app.workspaces[0z];
	ws0.focus_leaf = 2;
	roseviz_workspace_split_focused(ws0, ROSEVIZ_SPLIT_VERTICAL);
	assert(ws0.tile_count == 3, "split adds tile");
	ws0.tiles[2z].kind = ROSEVIZ_TILE_POINTS;
	ws0.tiles[2z].enabled = true;
	ws0.tiles[2z].cam = camera_default();
	ws0.tiles[2z].cam.distance = 2.4;
	ws0.tiles[2z].cam.yaw = -40.0;
	ws0.tiles[2z].cam.pitch = 18.0;
	roseviz_set_default_deser(&ws0.tiles[2z]);
	let points_topic: [19]u8 = ['/', 'd', 'e', 'm', 'o', '/', 'p', 'o', 'i', 'n', 't', 's', '/', 'l', 'i', 'd', 'a', 'r', 0];
	roseviz_bind_topic_to_tile(&ws0.tiles[2z], points_topic[0z..19z], 18);

	assert(wait_for_renders(&rt, app, &ws0.tiles[1z], &ws0.tiles[2z]), "visible point tiles both render");
	assert(app.workspaces[1z].tiles[1z].render_count == 0, "hidden workspace does not render");

	let old_render_a = ws0.tiles[1z].render_count;
	let old_render_b = ws0.tiles[2z].render_count;
	app.selected_tab = 1;
	for (let i: i32 = 0; i < 30; i += 1) {
		roseviz_render_frame(&rt, app);
		proc::MilliSleep(10);
	};
	assert(ws0.tiles[1z].render_count == old_render_a, "hidden workspace point tile stays idle");
	assert(ws0.tiles[2z].render_count == old_render_b, "second hidden point tile stays idle");
	assert(app.workspaces[1z].tiles[1z].render_count > 0, "active workspace renders");

	roseviz_app_shutdown(app);
	e2_runtime_shutdown(&rt);
	fb::Printsln("=== test_roseviz_layout passed ===");
};
