// test_roseviz_ui.pka — Headless smoke test for roseviz shell rendering.

use fmt;

fn count_nonblack_region(fb: *Framebuffer,
	x0: i32, y0: i32, w: i32, h: i32) i32 = {
	let n: i32 = 0;
	let x1 = x0 + w;
	let y1 = y0 + h;
	for (let py: i32 = y0; py < y1; py += 1) {
		for (let px: i32 = x0; px < x1; px += 1) {
			if (px < 0 || px >= fb.width || py < 0 || py >= fb.height) {
				continue;
			};
			let idx: size = ((py * fb.width + px) * 3): size;
			if (fb.pixels[idx] != 0u8 || fb.pixels[idx + 1z] != 0u8 || fb.pixels[idx + 2z] != 0u8) {
				n = n + 1;
			};
		};
	};
	return n;
};

fn sum_rgb_region(fb: *Framebuffer, x0: i32, y0: i32, w: i32, h: i32) i32 = {
	let total: i32 = 0;
	let x1 = x0 + w;
	let y1 = y0 + h;
	for (let py: i32 = y0; py < y1; py += 1) {
		for (let px: i32 = x0; px < x1; px += 1) {
			if (px < 0 || px >= fb.width || py < 0 || py >= fb.height) {
				continue;
			};
			let idx: size = ((py * fb.width + px) * 3): size;
			total = total +
				(fb.pixels[idx]: i32) +
				(fb.pixels[idx + 1z]: i32) +
				(fb.pixels[idx + 2z]: i32);
		};
	};
	return total;
};

export fn main() void = {
	fmt::Printsln("=== test_roseviz_ui ===");

	let rt = e2_runtime_init(E2_MODE_HEADLESS, 1280, 800);
	assert(e2_runtime_start(&rt), "engine start");
	assert(e2_init_blit_shader(), "blit shader");

	let app = RosevizApp {
		selected_tab = 0,
		selected_tile = 0,
		last_image_tab = -1,
		image_tex = E2GpuTexture { handle = 0u32, width = 0, height = 0, valid = false },
		image_rgb = [0...],
		image_ready = false,
		cloud_tex = E2GpuTexture { handle = 0u32, width = 0, height = 0, valid = false },
		cloud_rgb = [0...],
		cloud_depth = [0.0...],
		cloud_ready = false,
		cloud_points = E2GpuColorBuffer { vbo = 0u32, vertex_count = 0, valid = false },
		cloud_cam = camera_default(),
	};
	assert(roseviz_app_init(&app), "app init");

	app.selected_tab = 3;
	app.selected_tile = ROSEVIZ_TILE_POINTS;
	roseviz_render_frame(&rt, &app);

	let sidebar_w = 220;
	let bottom_h = 30;
	let gap = 8;
	let tab_w = 28;
	let tab_gap = 4;
	let main_x = sidebar_w + gap;
	let main_h = rt.fb.height - bottom_h - gap * 2;
	let image_h = (main_h * 11) / 20;
	let points_y = gap + image_h + gap;
	let points_h = main_h - image_h - gap;

	let sidebar_pixels = count_nonblack_region(&rt.fb, 0, 0, sidebar_w, rt.fb.height - bottom_h);
	let image_pixels = count_nonblack_region(&rt.fb, main_x, gap, rt.fb.width - main_x, image_h);
	let cloud_pixels = count_nonblack_region(&rt.fb, main_x, points_y, rt.fb.width - main_x, points_h);

	let tab_y = rt.fb.height - bottom_h + 16;
	let active_x = 8 + 3 * (tab_w + tab_gap) + 4;
	let inactive_x = 8 + 0 * (tab_w + tab_gap) + 4;
	let active_sum = sum_rgb_region(&rt.fb, active_x, tab_y, 4, 4);
	let inactive_sum = sum_rgb_region(&rt.fb, inactive_x, tab_y, 4, 4);

	e2_pass_text(&rt);

	let tbuf: [128]u8 = [0...];
	let tf = fmt::New(tbuf[0z..128z]);
	fmt::Write(&tf, "  sidebar=");
	fmt::Wi64(&tf, sidebar_pixels: i64);
	fmt::Write(&tf, " image=");
	fmt::Wi64(&tf, image_pixels: i64);
	fmt::Write(&tf, " cloud=");
	fmt::Wi64(&tf, cloud_pixels: i64);
	fmt::Println(&tf);

	fmt::Clear(&tf);
	fmt::Write(&tf, "  tab sums active=");
	fmt::Wi64(&tf, active_sum: i64);
	fmt::Write(&tf, " inactive=");
	fmt::Wi64(&tf, inactive_sum: i64);
	fmt::Println(&tf);

	assert(sidebar_pixels > 5000, "sidebar renders");
	assert(image_pixels > 2000, "image tile renders");
	assert(cloud_pixels > 1500, "point cloud tile renders");
	assert(active_sum > inactive_sum, "selected tab brighter");

	roseviz_app_shutdown(&app);
	e2_runtime_shutdown(&rt);
	fmt::Printsln("=== test_roseviz_ui passed ===");
};
