// test_roseviz_ui.pka — Headless smoke test for roseviz shell rendering.

use fb;

let roseviz_ui_test_app_words: [1048576]u64 = [0...];

fn copy_region_rgb(fb: *Framebuffer, x0: i32, y0: i32, w: i32, h: i32,
	dst: []u8) i32 = {
	let n: i32 = 0;
	let x1 = x0 + w;
	let y1 = y0 + h;
	for (let py: i32 = y0; py < y1; py += 1) {
		for (let px: i32 = x0; px < x1; px += 1) {
			if (px < 0 || px >= fb.width || py < 0 || py >= fb.height) {
				continue;
			};
			if ((n + 3) > dst.len: i32) { return n; };
			let src_idx: size = ((py * fb.width + px) * 3): size;
			dst[n: size] = fb.pixels[src_idx];
			dst[(n + 1): size] = fb.pixels[src_idx + 1z];
			dst[(n + 2): size] = fb.pixels[src_idx + 2z];
			n = n + 3;
		};
	};
	return n;
};

fn diff_region_rgb(fb: *Framebuffer, x0: i32, y0: i32, w: i32, h: i32,
	src: []u8, src_n: i32) i32 = {
	let total: i32 = 0;
	let n: i32 = 0;
	let x1 = x0 + w;
	let y1 = y0 + h;
	for (let py: i32 = y0; py < y1; py += 1) {
		for (let px: i32 = x0; px < x1; px += 1) {
			if (px < 0 || px >= fb.width || py < 0 || py >= fb.height) {
				continue;
			};
			if ((n + 3) > src_n) { return total; };
			let cur_idx: size = ((py * fb.width + px) * 3): size;
			let dr = fb.pixels[cur_idx]: i32 - src[n: size]: i32;
			let dg = fb.pixels[cur_idx + 1z]: i32 - src[(n + 1): size]: i32;
			let db = fb.pixels[cur_idx + 2z]: i32 - src[(n + 2): size]: i32;
			if (dr < 0) { total = total - dr; } else { total = total + dr; };
			if (dg < 0) { total = total - dg; } else { total = total + dg; };
			if (db < 0) { total = total - db; } else { total = total + db; };
			n = n + 3;
		};
	};
	return total;
};

fn count_nonblack_region(fb: *Framebuffer,
	x0: i32, y0: i32, w: i32, h: i32) i32 = {
	let n: i32 = 0;
	let x1 = x0 + w;
	let y1 = y0 + h;
	for (let py: i32 = y0; py < y1; py += 1) {
		for (let px: i32 = x0; px < x1; px += 1) {
			if (px < 0 || px >= fb.width || py < 0 || py >= fb.height) {
				continue;
			};
			let idx: size = ((py * fb.width + px) * 3): size;
			if (fb.pixels[idx] != 0u8 || fb.pixels[idx + 1z] != 0u8 || fb.pixels[idx + 2z] != 0u8) {
				n = n + 1;
			};
		};
	};
	return n;
};

fn sum_rgb_region(fb: *Framebuffer, x0: i32, y0: i32, w: i32, h: i32) i32 = {
	let total: i32 = 0;
	let x1 = x0 + w;
	let y1 = y0 + h;
	for (let py: i32 = y0; py < y1; py += 1) {
		for (let px: i32 = x0; px < x1; px += 1) {
			if (px < 0 || px >= fb.width || py < 0 || py >= fb.height) {
				continue;
			};
			let idx: size = ((py * fb.width + px) * 3): size;
			total = total +
				(fb.pixels[idx]: i32) +
				(fb.pixels[idx + 1z]: i32) +
				(fb.pixels[idx + 2z]: i32);
		};
	};
	return total;
};

export fn main() void = {
	fb::Printsln("=== test_roseviz_ui ===");

	let rt = e2_runtime_init(E2_MODE_HEADLESS, 1280, 800);
	assert(e2_runtime_start(&rt), "engine start");
	assert(e2_init_blit_shader(), "blit shader");

	let app: *RosevizApp = &roseviz_ui_test_app_words: *RosevizApp;
	assert(roseviz_app_init(app), "app init");

	app.selected_tab = 3;
	app.workspaces[3z].focus_leaf = 2;
	roseviz_render_frame(&rt, app);

	let sidebar_w = 240;
	let bottom_h = 30;
	let gap = 8;
	let main_x = sidebar_w + gap;
	let main_h = rt.fb.height - bottom_h - gap * 2;
	let image_h = (main_h * 550) / 1000;
	let points_y = gap + image_h + gap;
	let points_h = main_h - image_h - gap;
	let bottom_pixels = count_nonblack_region(&rt.fb, 0, rt.fb.height - bottom_h, rt.fb.width, bottom_h);
	let bottom_copy: [131072]u8 = [0...];
	let bottom_n = copy_region_rgb(&rt.fb, 0, rt.fb.height - bottom_h, rt.fb.width, bottom_h,
		bottom_copy[0z..131072z]);

	let sidebar_pixels = count_nonblack_region(&rt.fb, 0, 0, sidebar_w, rt.fb.height - bottom_h);
	let image_pixels = count_nonblack_region(&rt.fb, main_x, gap, rt.fb.width - main_x, image_h);
	let cloud_pixels = count_nonblack_region(&rt.fb, main_x, points_y, rt.fb.width - main_x, points_h);
	app.selected_tab = 0;
	roseviz_render_frame(&rt, app);
	let bottom_diff = diff_region_rgb(&rt.fb, 0, rt.fb.height - bottom_h, rt.fb.width, bottom_h,
		bottom_copy[0z..131072z], bottom_n);

	e2_pass_text(&rt);

	let tbuf: [128]u8 = [0...];
	let tf = fb::New(tbuf[0z..128z]);
	fb::Write(&tf, "  sidebar=");
	fb::Wi64(&tf, sidebar_pixels: i64);
	fb::Write(&tf, " image=");
	fb::Wi64(&tf, image_pixels: i64);
	fb::Write(&tf, " cloud=");
	fb::Wi64(&tf, cloud_pixels: i64);
	fb::Println(&tf);

	fb::Clear(&tf);
	fb::Write(&tf, "  bottom=");
	fb::Wi64(&tf, bottom_pixels: i64);
	fb::Write(&tf, " diff=");
	fb::Wi64(&tf, bottom_diff: i64);
	fb::Println(&tf);

	assert(sidebar_pixels > 15000, "sidebar renders");
	assert(image_pixels > 1000, "image tile renders");
	assert(cloud_pixels > 800, "point cloud tile renders");
	assert(bottom_pixels > 3500, "bottom bar renders");
	assert(bottom_diff > 100000, "selected tab changes bottom bar");

	roseviz_app_shutdown(app);
	e2_runtime_shutdown(&rt);
	fb::Printsln("=== test_roseviz_ui passed ===");
};
