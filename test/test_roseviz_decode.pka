use fb;
use proc;

let roseviz_decode_test_app_words: [1048576]u64 = [0...];

fn wait_for_tile_error(rt: *E2Runtime, app: *RosevizApp, tile: *RosevizTile, target_error: i32) bool = {
	for (let i: i32 = 0; i < 120; i += 1) {
		roseviz_render_frame(rt, app);
		if (tile.error_code == target_error) {
			return true;
		};
		proc::MilliSleep(20);
	};
	return false;
};

export fn main() void = {
	fb::Printsln("=== test_roseviz_decode ===");

	let rt = e2_runtime_init(E2_MODE_HEADLESS, 1280, 800);
	assert(e2_runtime_start(&rt), "engine start");
	assert(e2_init_blit_shader(), "blit shader");

	let app: *RosevizApp = &roseviz_decode_test_app_words: *RosevizApp;
	assert(roseviz_app_init(app), "app init");

	let points_topic: [19]u8 = ['/', 'd', 'e', 'm', 'o', '/', 'p', 'o', 'i', 'n', 't', 's', '/', 'l', 'i', 'd', 'a', 'r', 0];
	roseviz_bind_topic_to_tile(&app.workspaces[0z].tiles[0z], points_topic[0z..19z], 18);
	assert(wait_for_tile_error(&rt, app, &app.workspaces[0z].tiles[0z], ROSEVIZ_ERR_DECODE), "wrong topic causes decode error");

	let bad_deser: [4]u8 = ['b', 'a', 'd', 0];
	app.workspaces[0z].tiles[0z].deser_len = roseviz_copy_topic(app.workspaces[0z].tiles[0z].deser[0z..ROSEVIZ_DESER_BYTES], bad_deser[0z..4z], 3);
	roseviz_render_frame(&rt, app);
	assert(app.workspaces[0z].tiles[0z].error_code == ROSEVIZ_ERR_DESER, "bad deserialize string shows red error");

	roseviz_app_shutdown(app);
	e2_runtime_shutdown(&rt);
	fb::Printsln("=== test_roseviz_decode passed ===");
};
