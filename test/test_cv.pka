// test_cv.pka — Computer vision tests for MuJoCo scene rendering.
// Renders multiple frames across physics steps. Uses color thresholding
// and centroid tracking to verify:
//   1. Red ball and blue box visible with correct dominant colors
//   2. Ball centroid moves downward as it falls under gravity
//   3. Blue box centroid remains stationary across frames
//   4. Ball settles near ground level after many physics steps
//   5. Region color at each object centroid matches model spec

use fb;
use fmt;

// --- Centroid helpers: weighted center of color-dominant pixels ---

fn centroid_red_x(pfb: *Framebuffer) i32 = {
	let s: i64 = 0;
	let n: i64 = 0;
	for (let py: i32 = 0; py < pfb.height; py += 1) {
		for (let px: i32 = 0; px < pfb.width; px += 1) {
			let pi: size = ((py * pfb.width + px) * 3): size;
			let r: i32 = pfb.pixels[pi]: i32;
			let g: i32 = pfb.pixels[pi + 1z]: i32;
			let b: i32 = pfb.pixels[pi + 2z]: i32;
			if (r > 30 && r > g && r > b) {
				s = s + (px: i64);
				n = n + 1;
			};
		};
	};
	if (n == 0) { return -1; };
	return (s / n): i32;
};

fn centroid_red_y(pfb: *Framebuffer) i32 = {
	let s: i64 = 0;
	let n: i64 = 0;
	for (let py: i32 = 0; py < pfb.height; py += 1) {
		for (let px: i32 = 0; px < pfb.width; px += 1) {
			let pi: size = ((py * pfb.width + px) * 3): size;
			let r: i32 = pfb.pixels[pi]: i32;
			let g: i32 = pfb.pixels[pi + 1z]: i32;
			let b: i32 = pfb.pixels[pi + 2z]: i32;
			if (r > 30 && r > g && r > b) {
				s = s + (py: i64);
				n = n + 1;
			};
		};
	};
	if (n == 0) { return -1; };
	return (s / n): i32;
};

fn centroid_blue_x(pfb: *Framebuffer) i32 = {
	let s: i64 = 0;
	let n: i64 = 0;
	for (let py: i32 = 0; py < pfb.height; py += 1) {
		for (let px: i32 = 0; px < pfb.width; px += 1) {
			let pi: size = ((py * pfb.width + px) * 3): size;
			let r: i32 = pfb.pixels[pi]: i32;
			let g: i32 = pfb.pixels[pi + 1z]: i32;
			let b: i32 = pfb.pixels[pi + 2z]: i32;
			if (b > 30 && b > r && b > g) {
				s = s + (px: i64);
				n = n + 1;
			};
		};
	};
	if (n == 0) { return -1; };
	return (s / n): i32;
};

fn centroid_blue_y(pfb: *Framebuffer) i32 = {
	let s: i64 = 0;
	let n: i64 = 0;
	for (let py: i32 = 0; py < pfb.height; py += 1) {
		for (let px: i32 = 0; px < pfb.width; px += 1) {
			let pi: size = ((py * pfb.width + px) * 3): size;
			let r: i32 = pfb.pixels[pi]: i32;
			let g: i32 = pfb.pixels[pi + 1z]: i32;
			let b: i32 = pfb.pixels[pi + 2z]: i32;
			if (b > 30 && b > r && b > g) {
				s = s + (py: i64);
				n = n + 1;
			};
		};
	};
	if (n == 0) { return -1; };
	return (s / n): i32;
};

export fn main() void = {
	fmt::Printsln("=== test_cv ===");

	// --- Setup: load model, init headless engine, create scene ---
	let path: [20]u8 = ['m', 'o', 'd', 'e', 'l', 's', '/', 'b', 'a', 'l', 'l', '.', 'x', 'm', 'l', 0, 0, 0, 0, 0];
	let rc = mj_shim_load(&path[0z]);
	assert(rc == 0, "model load");

	let rt = e2_runtime_init(E2_MODE_HEADLESS, 256, 192);
	assert(e2_runtime_start(&rt), "engine start");

	let sc = scene_new();
	scene_init(&sc);

	let geom_pass = util_geom_pass_init();
	let lights = util_light_buffer_init();
	let env = env_default();

	// Camera: front-on, slightly elevated, sees ball above and box to right
	let cam_orbit = camera_default();
	cam_orbit.distance = 5.0;
	cam_orbit.pitch = 20.0;
	cam_orbit.target = vec3_new(0.3, 0.0, 0.8);
	let cam = freecam_from_orbit(&cam_orbit);

	let tbuf: [256]u8 = [0...];
	let tf = fmt::New(tbuf[0z..256z]);

	// ========== Frame 0: initial state (ball at z=2, before physics) ==========
	scene_update(&sc);
	scene_geom_pass(&sc, &geom_pass);
	e2_pass_begin(&rt, color_new(0.05, 0.05, 0.08, 1.0));
	e2_pass_3d_geom(&rt, &cam, E2_GEOM_MODE_PBR,
		geom_pass.draws[0z..(geom_pass.count: size)],
		util_light_buffer_slice(&lights), &env);
	e2_pass_end(&rt);

	let f0_red_n = cv_count_red_dominant(&rt.fb, 30);
	let f0_blue_n = cv_count_blue_dominant(&rt.fb, 30);
	let f0_rx = centroid_red_x(&rt.fb);
	let f0_ry = centroid_red_y(&rt.fb);
	let f0_bx = centroid_blue_x(&rt.fb);
	let f0_by = centroid_blue_y(&rt.fb);

	fmt::Clear(&tf);
	fmt::Write(&tf, "  f0: red=");
	fmt::Wi64(&tf, f0_red_n: i64);
	fmt::Write(&tf, " blue=");
	fmt::Wi64(&tf, f0_blue_n: i64);
	fmt::Write(&tf, " red_ctr=(");
	fmt::Wi64(&tf, f0_rx: i64);
	fmt::Write(&tf, ",");
	fmt::Wi64(&tf, f0_ry: i64);
	fmt::Write(&tf, ") blue_ctr=(");
	fmt::Wi64(&tf, f0_bx: i64);
	fmt::Write(&tf, ",");
	fmt::Wi64(&tf, f0_by: i64);
	fmt::Write(&tf, ")");
	fmt::Println(&tf);

	// --- Test 1: colors present in initial frame ---
	assert(f0_red_n > 10, "red ball visible");
	assert(f0_blue_n > 10, "blue box visible");
	assert(f0_rx >= 0, "red centroid X found");
	assert(f0_ry >= 0, "red centroid Y found");
	assert(f0_bx >= 0, "blue centroid X found");
	assert(f0_by >= 0, "blue centroid Y found");
	fmt::Printsln("  test_colors_present: OK");

	// --- Test 2: scene has substantial content (ground plane + objects) ---
	let f0_bright = cv_count_bright(&rt.fb, 25);
	fmt::Clear(&tf);
	fmt::Write(&tf, "  f0: bright_pixels=");
	fmt::Wi64(&tf, f0_bright: i64);
	fmt::Println(&tf);
	assert(f0_bright > 2000, "scene has ground plane and objects");
	fmt::Printsln("  test_scene_rendered: OK");

	// --- Test 3: verify color at object centroids matches model ---
	// Ball is red (0.8, 0.2, 0.2): region at centroid should be R-dominant
	let ball_color = cv_region_avg(&rt.fb,
		f0_rx - 3, f0_ry - 3, f0_rx + 3, f0_ry + 3);
	assert(ball_color.r > ball_color.g, "ball centroid: R > G");
	assert(ball_color.r > ball_color.b, "ball centroid: R > B");

	// Box is blue (0.2, 0.4, 0.8): region at centroid should be B-dominant
	let box_color = cv_region_avg(&rt.fb,
		f0_bx - 3, f0_by - 3, f0_bx + 3, f0_by + 3);
	assert(box_color.b > box_color.r, "box centroid: B > R");
	assert(box_color.b > box_color.g, "box centroid: B > G");

	fmt::Clear(&tf);
	fmt::Write(&tf, "  ball_rgb=(");
	fmt::Wf64(&tf, ball_color.r: f64, 2);
	fmt::Write(&tf, ",");
	fmt::Wf64(&tf, ball_color.g: f64, 2);
	fmt::Write(&tf, ",");
	fmt::Wf64(&tf, ball_color.b: f64, 2);
	fmt::Write(&tf, ") box_rgb=(");
	fmt::Wf64(&tf, box_color.r: f64, 2);
	fmt::Write(&tf, ",");
	fmt::Wf64(&tf, box_color.g: f64, 2);
	fmt::Write(&tf, ",");
	fmt::Wf64(&tf, box_color.b: f64, 2);
	fmt::Write(&tf, ")");
	fmt::Println(&tf);
	fmt::Printsln("  test_centroid_colors: OK");

	// ========== Step physics 200 times (0.4s — ball falling) ==========
	for (let s1: i32 = 0; s1 < 200; s1 += 1) {
		mj_shim_step();
	};

	// ========== Frame 1: ball has fallen partway (z ≈ 1.2) ==========
	scene_update(&sc);
	scene_geom_pass(&sc, &geom_pass);
	e2_pass_begin(&rt, color_new(0.05, 0.05, 0.08, 1.0));
	e2_pass_3d_geom(&rt, &cam, E2_GEOM_MODE_PBR,
		geom_pass.draws[0z..(geom_pass.count: size)],
		util_light_buffer_slice(&lights), &env);
	e2_pass_end(&rt);

	let f1_red_n = cv_count_red_dominant(&rt.fb, 30);
	let f1_ry = centroid_red_y(&rt.fb);
	let f1_bx = centroid_blue_x(&rt.fb);
	let f1_by = centroid_blue_y(&rt.fb);

	fmt::Clear(&tf);
	fmt::Write(&tf, "  f1: red=");
	fmt::Wi64(&tf, f1_red_n: i64);
	fmt::Write(&tf, " red_cy=");
	fmt::Wi64(&tf, f1_ry: i64);
	fmt::Write(&tf, " blue_ctr=(");
	fmt::Wi64(&tf, f1_bx: i64);
	fmt::Write(&tf, ",");
	fmt::Wi64(&tf, f1_by: i64);
	fmt::Write(&tf, ")");
	fmt::Println(&tf);

	// --- Test 4: ball fell — red centroid Y increased (lower on screen) ---
	// In pixel coords, Y=0 is top. Ball dropping means higher Y.
	assert(f1_ry > f0_ry, "ball fell: red centroid moved down");
	assert(f1_red_n > 5, "ball still visible after falling");
	fmt::Printsln("  test_ball_falls: OK");

	// --- Test 5: box stationary — blue centroid stable across frames ---
	let dx1 = f1_bx - f0_bx;
	if (dx1 < 0) { dx1 = 0 - dx1; };
	let dy1 = f1_by - f0_by;
	if (dy1 < 0) { dy1 = 0 - dy1; };

	fmt::Clear(&tf);
	fmt::Write(&tf, "  box drift: dx=");
	fmt::Wi64(&tf, dx1: i64);
	fmt::Write(&tf, " dy=");
	fmt::Wi64(&tf, dy1: i64);
	fmt::Println(&tf);

	assert(dx1 < 3, "box stable X");
	assert(dy1 < 3, "box stable Y");
	fmt::Printsln("  test_box_stationary: OK");

	// ========== Step physics 500 more (1.4s total — ball settled on ground) ==========
	for (let s2: i32 = 0; s2 < 500; s2 += 1) {
		mj_shim_step();
	};

	// ========== Frame 2: ball on ground (z ≈ 0.2) ==========
	scene_update(&sc);
	scene_geom_pass(&sc, &geom_pass);
	e2_pass_begin(&rt, color_new(0.05, 0.05, 0.08, 1.0));
	e2_pass_3d_geom(&rt, &cam, E2_GEOM_MODE_PBR,
		geom_pass.draws[0z..(geom_pass.count: size)],
		util_light_buffer_slice(&lights), &env);
	e2_pass_end(&rt);

	let f2_red_n = cv_count_red_dominant(&rt.fb, 30);
	let f2_rx = centroid_red_x(&rt.fb);
	let f2_ry = centroid_red_y(&rt.fb);

	fmt::Clear(&tf);
	fmt::Write(&tf, "  f2: red=");
	fmt::Wi64(&tf, f2_red_n: i64);
	fmt::Write(&tf, " red_ctr=(");
	fmt::Wi64(&tf, f2_rx: i64);
	fmt::Write(&tf, ",");
	fmt::Wi64(&tf, f2_ry: i64);
	fmt::Write(&tf, ")");
	fmt::Println(&tf);

	// --- Test 6: ball settled lower than initial position ---
	assert(f2_ry > f0_ry, "ball settled lower than start");
	fmt::Printsln("  test_ball_settled: OK");

	// --- Test 7: settled ball centroid region is still red ---
	let settled_color = cv_region_avg(&rt.fb,
		f2_rx - 3, f2_ry - 3, f2_rx + 3, f2_ry + 3);
	assert(settled_color.r > settled_color.g, "settled ball: R > G");
	assert(settled_color.r > settled_color.b, "settled ball: R > B");

	fmt::Clear(&tf);
	fmt::Write(&tf, "  settled_rgb=(");
	fmt::Wf64(&tf, settled_color.r: f64, 2);
	fmt::Write(&tf, ",");
	fmt::Wf64(&tf, settled_color.g: f64, 2);
	fmt::Write(&tf, ",");
	fmt::Wf64(&tf, settled_color.b: f64, 2);
	fmt::Write(&tf, ")");
	fmt::Println(&tf);
	fmt::Printsln("  test_settled_color: OK");

	// --- Cleanup ---
	scene_destroy(&sc);
	mj_shim_free();
	e2_runtime_shutdown(&rt);
	fmt::Printsln("=== test_cv passed ===");
};
