use fb;
use proc;

@symbol("roseviz_bridge_init") fn roseviz_bridge_init() i32;
@symbol("roseviz_bridge_shutdown") fn roseviz_bridge_shutdown() void;
@symbol("roseviz_bridge_poll") fn roseviz_bridge_poll() void;
@symbol("roseviz_bridge_track_topic") fn roseviz_bridge_track_topic(topic: *u8) i32;
@symbol("roseviz_bridge_topic_count") fn roseviz_bridge_topic_count() i32;
@symbol("roseviz_bridge_slot_payload_size") fn roseviz_bridge_slot_payload_size(slot: i32) i32;
@symbol("roseviz_bridge_decode_slot_image_rgb") fn roseviz_bridge_decode_slot_image_rgb(
	slot: i32, out_rgb: *u8, max_bytes: i32, out_w: *i32, out_h: *i32, out_channels: *i32) i32;
@symbol("roseviz_bridge_decode_slot_points_xyz") fn roseviz_bridge_decode_slot_points_xyz(
	slot: i32, out_xyz: *f32, max_points: i32) i32;

export fn main() void = {
	fb::Printsln("=== test_roseviz_bridge ===");
	assert(roseviz_bridge_init() != 0, "bridge init");

	let image_topic: [19]u8 = ['/', 'd', 'e', 'm', 'o', '/', 'c', 'a', 'm', 'e', 'r', 'a', '/', 'f', 'r', 'o', 'n', 't', 0];
	let points_topic: [19]u8 = ['/', 'd', 'e', 'm', 'o', '/', 'p', 'o', 'i', 'n', 't', 's', '/', 'l', 'i', 'd', 'a', 'r', 0];
	let image_slot = roseviz_bridge_track_topic(&image_topic[0z]);
	let points_slot = roseviz_bridge_track_topic(&points_topic[0z]);
	assert(image_slot >= 0, "image slot");
	assert(points_slot >= 0, "points slot");

	let catalog_count: i32 = 0;
	let image_bytes: i32 = 0;
	let point_bytes: i32 = 0;
	for (let i: i32 = 0; i < 120; i += 1) {
		roseviz_bridge_poll();
		catalog_count = roseviz_bridge_topic_count();
		image_bytes = roseviz_bridge_slot_payload_size(image_slot);
		point_bytes = roseviz_bridge_slot_payload_size(points_slot);
		if (catalog_count >= 2 && image_bytes > 0 && point_bytes > 0) {
			break;
		};
		proc::MilliSleep(25);
	};

	let tbuf: [128]u8 = [0...];
	let tf = fb::New(tbuf[0z..128z]);
	fb::Write(&tf, "  catalog=");
	fb::Wi64(&tf, catalog_count: i64);
	fb::Write(&tf, " image_bytes=");
	fb::Wi64(&tf, image_bytes: i64);
	fb::Write(&tf, " point_bytes=");
	fb::Wi64(&tf, point_bytes: i64);
	fb::Println(&tf);

	assert(catalog_count >= 2, "topic discovery");
	assert(image_bytes > 0, "image payload");
	assert(point_bytes > 0, "point payload");

	let image_rgb: [4608]u8 = [0...];
	let points_xyz: [576]f32 = [0.0...];
	let image_w: i32 = 0;
	let image_h: i32 = 0;
	let image_c: i32 = 0;
	let image_pixels = roseviz_bridge_decode_slot_image_rgb(
		image_slot, &image_rgb[0z], 4608, &image_w, &image_h, &image_c);
	let point_count = roseviz_bridge_decode_slot_points_xyz(points_slot, &points_xyz[0z], 192);
	assert(image_pixels == 1536, "image decode pixel count");
	assert(image_w == 48, "image width");
	assert(image_h == 32, "image height");
	assert(image_c == 3, "image channels");
	assert(point_count == 192, "point count");
	assert(image_rgb[0z] != 0u8 || image_rgb[1z] != 0u8 || image_rgb[2z] != 0u8, "image contents");
	assert(points_xyz[0z] < 0.0f32, "point x");

	roseviz_bridge_shutdown();
	fb::Printsln("=== test_roseviz_bridge passed ===");
};
