use fb;
use math;
use proc;

let roseviz_sim_test_app_words: [1048576]u64 = [0...];

fn sim_ball_z(app: *RosevizApp) f32 = {
	if (app.tf_raw_count < 2) {
		return -1000.0;
	};
	return app.tf_raw[9z];
};

fn wait_for_sim_data(rt: *E2Runtime, app: *RosevizApp) bool = {
	let ws = &app.workspaces[0z];
	for (let i: i32 = 0; i < 200; i += 1) {
		roseviz_render_frame(rt, app);
			if (ws.tiles[0z].seq > 0u64 && app.tf_seq > 0u64 && app.tf_raw_count >= 2) {
				return true;
			};
			proc::MilliSleep(20);
		};
	return false;
};

fn wait_for_ball_change(rt: *E2Runtime, app: *RosevizApp, prev_z: f32) bool = {
	for (let i: i32 = 0; i < 120; i += 1) {
		roseviz_render_frame(rt, app);
			if (math::abs(sim_ball_z(app) - prev_z) > 0.0005) {
				return true;
			};
			proc::MilliSleep(20);
		};
	return false;
};

fn wait_for_ball_stable(rt: *E2Runtime, app: *RosevizApp) bool = {
	let prev = sim_ball_z(app);
	let same_count: i32 = 0;
	for (let i: i32 = 0; i < 120; i += 1) {
		roseviz_render_frame(rt, app);
		let cur = sim_ball_z(app);
		if (math::abs(cur - prev) <= 0.0005) {
			same_count = same_count + 1;
			if (same_count >= 12) {
				return true;
			};
		} else {
			same_count = 0;
			};
			prev = cur;
			proc::MilliSleep(20);
		};
	return false;
};

fn wait_for_ball_above(rt: *E2Runtime, app: *RosevizApp, min_z: f32) bool = {
	for (let i: i32 = 0; i < 120; i += 1) {
		roseviz_render_frame(rt, app);
			if (sim_ball_z(app) > min_z) {
				return true;
			};
			proc::MilliSleep(20);
		};
	return false;
};

fn stop_process(pid: i32) void = {
	let kill_rc = proc::Kill(pid, false);
	proc::Wait(pid, 500);
};

fn press_key(rt: *E2Runtime, app: *RosevizApp, key: i32) void = {
	rt.input.event_count = 1;
	rt.input.events[0z] = InputEvent { etype = EVT_KEY_PRESS, key = key, mods = 0, x = 0.0, y = 0.0 };
	roseviz_handle_input(app, rt);
	rt.input.event_count = 0;
};

export fn main() void = {
	fb::Printsln("=== test_roseviz_sim ===");

	let rt = e2_runtime_init(E2_MODE_HEADLESS, 1280, 800);
	assert(e2_runtime_start(&rt), "engine start");
	assert(e2_init_blit_shader(), "blit shader");

	let app: *RosevizApp = &roseviz_sim_test_app_words: *RosevizApp;
	assert(roseviz_app_init(app), "app init");
	roseviz_use_falling_ball_preset(app);
	app.sim_running = false;

	let sim_path = "./build/roseviz_falling_ball";
	let sim_argv: [2]str = ["falling_ball", "--paused"];
	let log_path = "/tmp/roseviz_falling_ball_test.log";
	let pid = proc::CreateRedirectAssert(sim_path, sim_argv[0z..2z], "", log_path, false, log_path, false);
	assert(pid > 0, "spawn sim");

	assert(wait_for_sim_data(&rt, app), "sim topics render");
	let z0 = sim_ball_z(app);
	assert(z0 > 0.5, "initial ball height");

	press_key(&rt, app, KEY_S);
	assert(wait_for_ball_change(&rt, app, z0), "single step changes ball height");
	let z1 = sim_ball_z(app);
	assert(z1 < z0, "step falls down");

	press_key(&rt, app, ROSEVIZ_KEY_P);
	assert(wait_for_ball_change(&rt, app, z1), "play continues simulation");

	press_key(&rt, app, ROSEVIZ_KEY_P);
	assert(wait_for_ball_stable(&rt, app), "pause stabilizes simulation");

	let reset_ok = false;
	for (let i: i32 = 0; i < 6; i += 1) {
		press_key(&rt, app, KEY_R);
		if (wait_for_ball_above(&rt, app, 1.2)) {
			reset_ok = true;
			break;
		};
	};
	assert(reset_ok, "reset restores height");

	stop_process(pid);
	roseviz_app_shutdown(app);
	e2_runtime_shutdown(&rt);
	fb::Printsln("=== test_roseviz_sim passed ===");
};
