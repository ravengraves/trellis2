// math3d.pka — 3D math for Pollyn Engine
// Vec3 and Mat4 operations (column-major matrices for OpenGL)

use math;

// ================================================================
// Vec3
// ================================================================

export type Vec3 = struct { x: f32, y: f32, z: f32 };

export fn vec3_new(x: f32, y: f32, z: f32) Vec3 = {
	return Vec3 { x = x, y = y, z = z };
};

export fn vec3_zero() Vec3 = {
	return Vec3 { x = 0.0, y = 0.0, z = 0.0 };
};

export fn vec3_add(a: Vec3, b: Vec3) Vec3 = {
	return Vec3 { x = a.x + b.x, y = a.y + b.y, z = a.z + b.z };
};

export fn vec3_sub(a: Vec3, b: Vec3) Vec3 = {
	return Vec3 { x = a.x - b.x, y = a.y - b.y, z = a.z - b.z };
};

export fn vec3_scale(v: Vec3, s: f32) Vec3 = {
	return Vec3 { x = v.x * s, y = v.y * s, z = v.z * s };
};

export fn vec3_dot(a: Vec3, b: Vec3) f32 = {
	return a.x * b.x + a.y * b.y + a.z * b.z;
};

export fn vec3_cross(a: Vec3, b: Vec3) Vec3 = {
	return Vec3 {
		x = a.y * b.z - a.z * b.y,
		y = a.z * b.x - a.x * b.z,
		z = a.x * b.y - a.y * b.x
	};
};

export fn vec3_length(v: Vec3) f32 = {
	return math::sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
};

export fn vec3_normalize(v: Vec3) Vec3 = {
	let mag = vec3_length(v);
	if (mag < 0.0001) {
		return Vec3 { x = 0.0, y = 0.0, z = 0.0 };
	};
	let inv = math::recip(mag);
	return Vec3 { x = v.x * inv, y = v.y * inv, z = v.z * inv };
};

export fn vec3_negate(v: Vec3) Vec3 = {
	return Vec3 { x = -v.x, y = -v.y, z = -v.z };
};

export fn vec3_lerp(a: Vec3, b: Vec3, t: f32) Vec3 = {
	return Vec3 {
		x = a.x + (b.x - a.x) * t,
		y = a.y + (b.y - a.y) * t,
		z = a.z + (b.z - a.z) * t
	};
};

// ================================================================
// Mat4 (column-major: m[col*4 + row])
// ================================================================

export type Mat4 = struct { d: [16]f32 };

export fn mat4_identity() Mat4 = {
	let m = Mat4 { d = [0.0...] };
	m.d[0]  = 1.0;
	m.d[5]  = 1.0;
	m.d[10] = 1.0;
	m.d[15] = 1.0;
	return m;
};

export fn mat4_zero() Mat4 = {
	return Mat4 { d = [0.0...] };
};

// Column-major access: element at row r, col c
fn mat4_get(m: *Mat4, r: i32, c: i32) f32 = {
	return m.d[(c * 4 + r): size];
};

fn mat4_set(m: *Mat4, r: i32, c: i32, v: f32) void = {
	m.d[(c * 4 + r): size] = v;
};

export fn mat4_mul(a: *Mat4, b: *Mat4) Mat4 = {
	let out = mat4_zero();
	for (let c: i32 = 0; c < 4; c += 1) {
		for (let r: i32 = 0; r < 4; r += 1) {
			let sum: f32 = 0.0;
			for (let k: i32 = 0; k < 4; k += 1) {
				sum = sum + mat4_get(a, r, k) * mat4_get(b, k, c);
			};
			mat4_set(&out, r, c, sum);
		};
	};
	return out;
};

export fn mat4_perspective(fovy_deg: f32, aspect: f32, znear: f32, zfar: f32) Mat4 = {
	let m = mat4_zero();
	let fovy_rad = fovy_deg * (math::PI / 180.0);
	let half_tan = math::tan(fovy_rad * 0.5);
	let f = math::recip(half_tan);

	mat4_set(&m, 0, 0, f / aspect);
	mat4_set(&m, 1, 1, f);
	mat4_set(&m, 2, 2, (zfar + znear) / (znear - zfar));
	mat4_set(&m, 3, 2, -1.0);
	mat4_set(&m, 2, 3, (2.0 * zfar * znear) / (znear - zfar));
	return m;
};

export fn mat4_lookat(eye: Vec3, center: Vec3, up: Vec3) Mat4 = {
	let f = vec3_normalize(vec3_sub(center, eye));
	let s = vec3_normalize(vec3_cross(f, up));
	let u = vec3_cross(s, f);

	let m = mat4_identity();
	mat4_set(&m, 0, 0, s.x);
	mat4_set(&m, 0, 1, s.y);
	mat4_set(&m, 0, 2, s.z);
	mat4_set(&m, 1, 0, u.x);
	mat4_set(&m, 1, 1, u.y);
	mat4_set(&m, 1, 2, u.z);
	mat4_set(&m, 2, 0, -f.x);
	mat4_set(&m, 2, 1, -f.y);
	mat4_set(&m, 2, 2, -f.z);
	mat4_set(&m, 0, 3, -(s.x * eye.x + s.y * eye.y + s.z * eye.z));
	mat4_set(&m, 1, 3, -(u.x * eye.x + u.y * eye.y + u.z * eye.z));
	mat4_set(&m, 2, 3,  (f.x * eye.x + f.y * eye.y + f.z * eye.z));
	return m;
};

export fn mat4_translate(tx: f32, ty: f32, tz: f32) Mat4 = {
	let m = mat4_identity();
	mat4_set(&m, 0, 3, tx);
	mat4_set(&m, 1, 3, ty);
	mat4_set(&m, 2, 3, tz);
	return m;
};

export fn mat4_scale(sx: f32, sy: f32, sz: f32) Mat4 = {
	let m = mat4_zero();
	m.d[0]  = sx;
	m.d[5]  = sy;
	m.d[10] = sz;
	m.d[15] = 1.0;
	return m;
};

export fn mat4_rotate_y(angle_deg: f32) Mat4 = {
	let m = mat4_identity();
	let rad = angle_deg * (math::PI / 180.0);
	let sc = math::sincos(rad);
	mat4_set(&m, 0, 0, sc.c);
	mat4_set(&m, 0, 2, sc.s);
	mat4_set(&m, 2, 0, -sc.s);
	mat4_set(&m, 2, 2, sc.c);
	return m;
};

export fn mat4_rotate_x(angle_deg: f32) Mat4 = {
	let m = mat4_identity();
	let rad = angle_deg * (math::PI / 180.0);
	let sc = math::sincos(rad);
	mat4_set(&m, 1, 1, sc.c);
	mat4_set(&m, 1, 2, -sc.s);
	mat4_set(&m, 2, 1, sc.s);
	mat4_set(&m, 2, 2, sc.c);
	return m;
};

export fn mat4_rotate_z(angle_deg: f32) Mat4 = {
	let m = mat4_identity();
	let rad = angle_deg * (math::PI / 180.0);
	let sc = math::sincos(rad);
	mat4_set(&m, 0, 0, sc.c);
	mat4_set(&m, 0, 1, -sc.s);
	mat4_set(&m, 1, 0, sc.s);
	mat4_set(&m, 1, 1, sc.c);
	return m;
};

export fn mat4_rotate_axis(axis: Vec3, angle_deg: f32) Mat4 = {
	let a = vec3_normalize(axis);
	let rad = angle_deg * (math::PI / 180.0);
	let sc = math::sincos(rad);
	let c = sc.c;
	let s = sc.s;
	let t = 1.0 - c;

	let m = mat4_identity();
	mat4_set(&m, 0, 0, t * a.x * a.x + c);
	mat4_set(&m, 0, 1, t * a.x * a.y - s * a.z);
	mat4_set(&m, 0, 2, t * a.x * a.z + s * a.y);
	mat4_set(&m, 1, 0, t * a.x * a.y + s * a.z);
	mat4_set(&m, 1, 1, t * a.y * a.y + c);
	mat4_set(&m, 1, 2, t * a.y * a.z - s * a.x);
	mat4_set(&m, 2, 0, t * a.x * a.z - s * a.y);
	mat4_set(&m, 2, 1, t * a.y * a.z + s * a.x);
	mat4_set(&m, 2, 2, t * a.z * a.z + c);
	return m;
};

// Transform a vec3 by a mat4 (w=1 for points, ignoring perspective divide)
export fn mat4_transform_point(m: *Mat4, v: Vec3) Vec3 = {
	return Vec3 {
		x = mat4_get(m, 0, 0) * v.x + mat4_get(m, 0, 1) * v.y + mat4_get(m, 0, 2) * v.z + mat4_get(m, 0, 3),
		y = mat4_get(m, 1, 0) * v.x + mat4_get(m, 1, 1) * v.y + mat4_get(m, 1, 2) * v.z + mat4_get(m, 1, 3),
		z = mat4_get(m, 2, 0) * v.x + mat4_get(m, 2, 1) * v.y + mat4_get(m, 2, 2) * v.z + mat4_get(m, 2, 3)
	};
};

// Transform direction (w=0)
export fn mat4_transform_dir(m: *Mat4, v: Vec3) Vec3 = {
	return Vec3 {
		x = mat4_get(m, 0, 0) * v.x + mat4_get(m, 0, 1) * v.y + mat4_get(m, 0, 2) * v.z,
		y = mat4_get(m, 1, 0) * v.x + mat4_get(m, 1, 1) * v.y + mat4_get(m, 1, 2) * v.z,
		z = mat4_get(m, 2, 0) * v.x + mat4_get(m, 2, 1) * v.y + mat4_get(m, 2, 2) * v.z
	};
};

// Full transform with perspective divide (for projection)
export fn mat4_project(m: *Mat4, v: Vec3) Vec3 = {
	let x = mat4_get(m, 0, 0) * v.x + mat4_get(m, 0, 1) * v.y + mat4_get(m, 0, 2) * v.z + mat4_get(m, 0, 3);
	let y = mat4_get(m, 1, 0) * v.x + mat4_get(m, 1, 1) * v.y + mat4_get(m, 1, 2) * v.z + mat4_get(m, 1, 3);
	let z = mat4_get(m, 2, 0) * v.x + mat4_get(m, 2, 1) * v.y + mat4_get(m, 2, 2) * v.z + mat4_get(m, 2, 3);
	let w = mat4_get(m, 3, 0) * v.x + mat4_get(m, 3, 1) * v.y + mat4_get(m, 3, 2) * v.z + mat4_get(m, 3, 3);
	if (w != 0.0) {
		let inv_w = math::recip(w);
		return Vec3 { x = x * inv_w, y = y * inv_w, z = z * inv_w };
	};
	return Vec3 { x = x, y = y, z = z };
};
