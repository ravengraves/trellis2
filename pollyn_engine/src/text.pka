// text.pka — Bitmap text rendering for Pollyn Engine
// 8x8 bitmap font for screen-space text on both GL and terminal.

use strings;

// 8x8 font: ASCII 32-126, stored as 8 bytes per glyph (each byte = one row)
// This is a minimal built-in font covering printable ASCII.
// Each bit in a row byte: 1=pixel on, MSB=leftmost pixel

def FONT_FIRST: i32 = 32;
def FONT_LAST: i32 = 126;
def FONT_W: i32 = 8;
def FONT_H: i32 = 8;
def FONT_ROW_COUNT: i32 = (FONT_LAST - FONT_FIRST + 1) * FONT_H;
def TEXT_DEFAULT_ROWS: f32 = 80.0;
def TEXT_DEFAULT_CELL_ASPECT: f32 = 0.625;

// Subset of a CP437-style 8x8 font.
// 95 chars * 8 bytes = 760 bytes

let FONT_DATA: [_]u8 = [
	// 32 SPACE
	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
	// 33 !
	0x18, 0x18, 0x18, 0x18, 0x18, 0x00, 0x18, 0x00,
	// 34 "
	0x6C, 0x6C, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
	// 35 #
	0x6C, 0xFE, 0x6C, 0x6C, 0xFE, 0x6C, 0x00, 0x00,
	// 36 $
	0x18, 0x7E, 0x58, 0x7E, 0x1A, 0x7E, 0x18, 0x00,
	// 37 %
	0x62, 0x64, 0x08, 0x10, 0x26, 0x46, 0x00, 0x00,
	// 38 &
	0x38, 0x6C, 0x38, 0x76, 0xDC, 0x76, 0x00, 0x00,
	// 39 '
	0x18, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
	// 40 (
	0x0C, 0x18, 0x30, 0x30, 0x30, 0x18, 0x0C, 0x00,
	// 41 )
	0x30, 0x18, 0x0C, 0x0C, 0x0C, 0x18, 0x30, 0x00,
	// 42 *
	0x00, 0x66, 0x3C, 0xFF, 0x3C, 0x66, 0x00, 0x00,
	// 43 +
	0x00, 0x18, 0x18, 0x7E, 0x18, 0x18, 0x00, 0x00,
	// 44 ,
	0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x30,
	// 45 -
	0x00, 0x00, 0x00, 0x7E, 0x00, 0x00, 0x00, 0x00,
	// 46 .
	0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x00,
	// 47 /
	0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x00,
	// 48 0
	0x7C, 0xC6, 0xCE, 0xD6, 0xE6, 0xC6, 0x7C, 0x00,
	// 49 1
	0x18, 0x38, 0x18, 0x18, 0x18, 0x18, 0x7E, 0x00,
	// 50 2
	0x7C, 0xC6, 0x06, 0x3C, 0x60, 0xC0, 0xFE, 0x00,
	// 51 3
	0x7C, 0xC6, 0x06, 0x3C, 0x06, 0xC6, 0x7C, 0x00,
	// 52 4
	0x0C, 0x1C, 0x3C, 0x6C, 0xFE, 0x0C, 0x0C, 0x00,
	// 53 5
	0xFE, 0xC0, 0xFC, 0x06, 0x06, 0xC6, 0x7C, 0x00,
	// 54 6
	0x7C, 0xC0, 0xFC, 0xC6, 0xC6, 0xC6, 0x7C, 0x00,
	// 55 7
	0xFE, 0x06, 0x0C, 0x18, 0x30, 0x30, 0x30, 0x00,
	// 56 8
	0x7C, 0xC6, 0xC6, 0x7C, 0xC6, 0xC6, 0x7C, 0x00,
	// 57 9
	0x7C, 0xC6, 0xC6, 0x7E, 0x06, 0x06, 0x7C, 0x00,
	// 58 :
	0x00, 0x18, 0x18, 0x00, 0x18, 0x18, 0x00, 0x00,
	// 59 ;
	0x00, 0x18, 0x18, 0x00, 0x18, 0x18, 0x30, 0x00,
	// 60 <
	0x06, 0x0C, 0x18, 0x30, 0x18, 0x0C, 0x06, 0x00,
	// 61 =
	0x00, 0x00, 0x7E, 0x00, 0x7E, 0x00, 0x00, 0x00,
	// 62 >
	0x60, 0x30, 0x18, 0x0C, 0x18, 0x30, 0x60, 0x00,
	// 63 ?
	0x7C, 0xC6, 0x0C, 0x18, 0x18, 0x00, 0x18, 0x00,
	// 64 @
	0x7C, 0xC6, 0xDE, 0xDE, 0xDE, 0xC0, 0x78, 0x00,
	// 65 A
	0x38, 0x6C, 0xC6, 0xFE, 0xC6, 0xC6, 0xC6, 0x00,
	// 66 B
	0xFC, 0xC6, 0xC6, 0xFC, 0xC6, 0xC6, 0xFC, 0x00,
	// 67 C
	0x7C, 0xC6, 0xC0, 0xC0, 0xC0, 0xC6, 0x7C, 0x00,
	// 68 D
	0xF8, 0xCC, 0xC6, 0xC6, 0xC6, 0xCC, 0xF8, 0x00,
	// 69 E
	0xFE, 0xC0, 0xC0, 0xF8, 0xC0, 0xC0, 0xFE, 0x00,
	// 70 F
	0xFE, 0xC0, 0xC0, 0xF8, 0xC0, 0xC0, 0xC0, 0x00,
	// 71 G
	0x7C, 0xC6, 0xC0, 0xCE, 0xC6, 0xC6, 0x7E, 0x00,
	// 72 H
	0xC6, 0xC6, 0xC6, 0xFE, 0xC6, 0xC6, 0xC6, 0x00,
	// 73 I
	0x7E, 0x18, 0x18, 0x18, 0x18, 0x18, 0x7E, 0x00,
	// 74 J
	0x06, 0x06, 0x06, 0x06, 0xC6, 0xC6, 0x7C, 0x00,
	// 75 K
	0xC6, 0xCC, 0xD8, 0xF0, 0xD8, 0xCC, 0xC6, 0x00,
	// 76 L
	0xC0, 0xC0, 0xC0, 0xC0, 0xC0, 0xC0, 0xFE, 0x00,
	// 77 M
	0xC6, 0xEE, 0xFE, 0xD6, 0xC6, 0xC6, 0xC6, 0x00,
	// 78 N
	0xC6, 0xE6, 0xF6, 0xDE, 0xCE, 0xC6, 0xC6, 0x00,
	// 79 O
	0x7C, 0xC6, 0xC6, 0xC6, 0xC6, 0xC6, 0x7C, 0x00,
	// 80 P
	0xFC, 0xC6, 0xC6, 0xFC, 0xC0, 0xC0, 0xC0, 0x00,
	// 81 Q
	0x7C, 0xC6, 0xC6, 0xC6, 0xD6, 0xDE, 0x7C, 0x06,
	// 82 R
	0xFC, 0xC6, 0xC6, 0xFC, 0xD8, 0xCC, 0xC6, 0x00,
	// 83 S
	0x7C, 0xC6, 0xC0, 0x7C, 0x06, 0xC6, 0x7C, 0x00,
	// 84 T
	0xFE, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x00,
	// 85 U
	0xC6, 0xC6, 0xC6, 0xC6, 0xC6, 0xC6, 0x7C, 0x00,
	// 86 V
	0xC6, 0xC6, 0xC6, 0xC6, 0x6C, 0x38, 0x10, 0x00,
	// 87 W
	0xC6, 0xC6, 0xC6, 0xD6, 0xFE, 0xEE, 0xC6, 0x00,
	// 88 X
	0xC6, 0x6C, 0x38, 0x38, 0x6C, 0xC6, 0xC6, 0x00,
	// 89 Y
	0xC6, 0xC6, 0x6C, 0x38, 0x18, 0x18, 0x18, 0x00,
	// 90 Z
	0xFE, 0x06, 0x0C, 0x18, 0x30, 0x60, 0xFE, 0x00,
	// 91 [
	0x3C, 0x30, 0x30, 0x30, 0x30, 0x30, 0x3C, 0x00,
	// 92 backslash
	0x80, 0x40, 0x20, 0x10, 0x08, 0x04, 0x02, 0x00,
	// 93 ]
	0x3C, 0x0C, 0x0C, 0x0C, 0x0C, 0x0C, 0x3C, 0x00,
	// 94 ^
	0x10, 0x38, 0x6C, 0x00, 0x00, 0x00, 0x00, 0x00,
	// 95 _
	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xFE, 0x00,
	// 96 `
	0x30, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
	// 97 a
	0x00, 0x00, 0x7C, 0x06, 0x7E, 0xC6, 0x7E, 0x00,
	// 98 b
	0xC0, 0xC0, 0xFC, 0xC6, 0xC6, 0xC6, 0xFC, 0x00,
	// 99 c
	0x00, 0x00, 0x7C, 0xC6, 0xC0, 0xC6, 0x7C, 0x00,
	// 100 d
	0x06, 0x06, 0x7E, 0xC6, 0xC6, 0xC6, 0x7E, 0x00,
	// 101 e
	0x00, 0x00, 0x7C, 0xC6, 0xFE, 0xC0, 0x7C, 0x00,
	// 102 f
	0x1C, 0x36, 0x30, 0x7C, 0x30, 0x30, 0x30, 0x00,
	// 103 g
	0x00, 0x00, 0x7E, 0xC6, 0xC6, 0x7E, 0x06, 0x7C,
	// 104 h
	0xC0, 0xC0, 0xFC, 0xC6, 0xC6, 0xC6, 0xC6, 0x00,
	// 105 i
	0x18, 0x00, 0x38, 0x18, 0x18, 0x18, 0x3C, 0x00,
	// 106 j
	0x06, 0x00, 0x06, 0x06, 0x06, 0xC6, 0x7C, 0x00,
	// 107 k
	0xC0, 0xC0, 0xCC, 0xD8, 0xF0, 0xD8, 0xCC, 0x00,
	// 108 l
	0x38, 0x18, 0x18, 0x18, 0x18, 0x18, 0x3C, 0x00,
	// 109 m
	0x00, 0x00, 0xEC, 0xFE, 0xD6, 0xC6, 0xC6, 0x00,
	// 110 n
	0x00, 0x00, 0xFC, 0xC6, 0xC6, 0xC6, 0xC6, 0x00,
	// 111 o
	0x00, 0x00, 0x7C, 0xC6, 0xC6, 0xC6, 0x7C, 0x00,
	// 112 p
	0x00, 0x00, 0xFC, 0xC6, 0xC6, 0xFC, 0xC0, 0xC0,
	// 113 q
	0x00, 0x00, 0x7E, 0xC6, 0xC6, 0x7E, 0x06, 0x06,
	// 114 r
	0x00, 0x00, 0xDC, 0xE6, 0xC0, 0xC0, 0xC0, 0x00,
	// 115 s
	0x00, 0x00, 0x7E, 0xC0, 0x7C, 0x06, 0xFC, 0x00,
	// 116 t
	0x30, 0x30, 0x7C, 0x30, 0x30, 0x36, 0x1C, 0x00,
	// 117 u
	0x00, 0x00, 0xC6, 0xC6, 0xC6, 0xC6, 0x7E, 0x00,
	// 118 v
	0x00, 0x00, 0xC6, 0xC6, 0x6C, 0x38, 0x10, 0x00,
	// 119 w
	0x00, 0x00, 0xC6, 0xC6, 0xD6, 0xFE, 0x6C, 0x00,
	// 120 x
	0x00, 0x00, 0xC6, 0x6C, 0x38, 0x6C, 0xC6, 0x00,
	// 121 y
	0x00, 0x00, 0xC6, 0xC6, 0xC6, 0x7E, 0x06, 0x7C,
	// 122 z
	0x00, 0x00, 0xFE, 0x0C, 0x38, 0x60, 0xFE, 0x00,
	// 123 {
	0x0E, 0x18, 0x18, 0x70, 0x18, 0x18, 0x0E, 0x00,
	// 124 |
	0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x00,
	// 125 }
	0x70, 0x18, 0x18, 0x0E, 0x18, 0x18, 0x70, 0x00,
	// 126 ~
	0x76, 0xDC, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
];

// Draw a single character glyph into the framebuffer
export fn text_draw_char(fb: *Framebuffer, ch: i32, px: i32, py: i32,
                         r: u8, g: u8, b: u8) void = {
	text_draw_char_scaled(fb, ch, px, py, FONT_W, FONT_H, r, g, b);
};

export fn text_draw_char_scaled(fb: *Framebuffer, ch: i32, px: i32, py: i32,
	glyph_w: i32, glyph_h: i32, r: u8, g: u8, b: u8) void = {
	if (ch < FONT_FIRST || ch > FONT_LAST) { return; };
	if (glyph_w <= 0 || glyph_h <= 0) { return; };
	let glyph_idx: size = ((ch - FONT_FIRST) * FONT_H): size;

	for (let row: i32 = 0; row < glyph_h; row += 1) {
		let src_row = (row * FONT_H) / glyph_h;
		let bits: u8 = FONT_DATA[glyph_idx + (src_row: size)];
		for (let col: i32 = 0; col < glyph_w; col += 1) {
			let src_col = (col * FONT_W) / glyph_w;
			if ((bits & (0x80u8 >> (src_col: u8))) != 0u8) {
				fb_set_pixel(fb, px + col, py + row, -1000.0, r, g, b, 255);
			};
		};
	};
};

// Draw a string into the framebuffer
export fn text_draw_str(fb: *Framebuffer, s: str, px: i32, py: i32,
                        r: u8, g: u8, b: u8) void = {
	text_draw_str_scaled(fb, s, px, py, FONT_W, FONT_H, r, g, b);
};

export fn text_draw_str_scaled(fb: *Framebuffer, s: str, px: i32, py: i32,
	glyph_w: i32, glyph_h: i32, r: u8, g: u8, b: u8) void = {
	let data = strings::toutf8(s);
	let cx = px;
	let tdi: size = 0z;
	for (tdi < data.len) {
		text_draw_char_scaled(fb, data[tdi]: i32, cx, py, glyph_w, glyph_h, r, g, b);
		cx = cx + glyph_w;
		tdi = tdi + 1z;
	};
};

export fn text_target_glyph_h_f32(target_h: i32) f32 = {
	if (target_h <= 0) { return 1.0; };
	let glyph_h = (target_h: f32) / TEXT_DEFAULT_ROWS;
	if (glyph_h < 1.0) { return 1.0; };
	return glyph_h;
};

export fn text_target_glyph_w_f32(target_h: i32) f32 = {
	return text_target_glyph_h_f32(target_h) * TEXT_DEFAULT_CELL_ASPECT;
};

export fn text_target_glyph_h_i32(target_h: i32) i32 = {
	let glyph_h = text_target_glyph_h_f32(target_h): i32;
	if (glyph_h < 1) { return 1; };
	return glyph_h;
};

export fn text_target_glyph_w_i32(target_h: i32) i32 = {
	let glyph_w = text_target_glyph_w_f32(target_h): i32;
	if (glyph_w < 1) { return 1; };
	return glyph_w;
};

// ================================================================
// Renderer-agnostic text overlay queue
// ================================================================

def MAX_TEXT_ITEMS: size = 64z;
def MAX_TEXT_LEN: size = 256z;

export type TextOverlayItem = struct {
	x_frac: f32,
	y_frac: f32,
	r: u8,
	g: u8,
	b: u8,
	text: [MAX_TEXT_LEN]u8,
	text_len: i32,
};

export type TextOverlay = struct {
	items: [MAX_TEXT_ITEMS]TextOverlayItem,
	count: i32,
};

fn text_overlay_default_item() TextOverlayItem = {
	return TextOverlayItem {
		x_frac = 0.0,
		y_frac = 0.0,
		r = 255,
		g = 255,
		b = 255,
		text = [0...],
		text_len = 0
	};
};

fn clamp01(v: f32) f32 = {
	if (v < 0.0) { return 0.0; };
	if (v > 1.0) { return 1.0; };
	return v;
};

export fn text_overlay_init() TextOverlay = {
	return TextOverlay {
		items = [text_overlay_default_item()...],
		count = 0
	};
};

export fn text_overlay_clear(overlay: *TextOverlay) void = {
	overlay.count = 0;
};

export fn text_overlay_add(overlay: *TextOverlay,
		x_frac: f32, y_frac: f32,
		s: str, r: u8, g: u8, b: u8) void = {
	if (overlay.count >= (MAX_TEXT_ITEMS: i32)) { return; };

	let idx: size = overlay.count: size;
	overlay.items[idx].x_frac = clamp01(x_frac);
	overlay.items[idx].y_frac = clamp01(y_frac);
	overlay.items[idx].r = r;
	overlay.items[idx].g = g;
	overlay.items[idx].b = b;

	let data = strings::toutf8(s);
	let copy_len: i32 = data.len: i32;
	if (copy_len > (MAX_TEXT_LEN: i32) - 1) {
		copy_len = (MAX_TEXT_LEN: i32) - 1;
	};
	for (let i: i32 = 0; i < copy_len; i += 1) {
		overlay.items[idx].text[i: size] = data[i: size];
	};
	overlay.items[idx].text[copy_len: size] = 0;
	overlay.items[idx].text_len = copy_len;

	overlay.count = overlay.count + 1;
};

@symbol("shim_gl_draw_text_bytes")
fn shim_gl_draw_text_bytes(data: *u8, len: i32,
	start_x: f32, start_y: f32, origin_x: f32,
	w: i32, h: i32, glyph_w: f32, glyph_h: f32,
	r: f32, g: f32, b: f32) void;

@symbol("shim_gl_text_set_font")
fn shim_gl_text_set_font(font_rows: *u8, row_count: i32,
	glyph_w: i32, glyph_h: i32,
	first_cp: i32, last_cp: i32) i32;

export fn text_overlay_render_window(overlay: *TextOverlay, w: i32, h: i32) void = {
	if (w <= 0 || h <= 0) { return; };
	shim_gl_text_set_font(&FONT_DATA[0z], FONT_ROW_COUNT,
		FONT_W, FONT_H, FONT_FIRST, FONT_LAST);
	let glyph_w = text_target_glyph_w_f32(h);
	let glyph_h = text_target_glyph_h_f32(h);

	for (let i: i32 = 0; i < overlay.count; i += 1) {
		let item = &overlay.items[i: size];
		if (item.text_len <= 0) { continue; };

		let sx = item.x_frac * (w: f32);
		let sy = item.y_frac * (h: f32);
		let rf = (item.r: f32) / 255.0;
		let gf = (item.g: f32) / 255.0;
		let bf = (item.b: f32) / 255.0;

		shim_gl_draw_text_bytes(&item.text[0z], item.text_len,
			sx, sy, sx, w, h, glyph_w, glyph_h,
			rf, gf, bf);
	};
};

export fn text_overlay_render_terminal(overlay: *TextOverlay, cols: i32, rows: i32) void = {
	if (cols <= 0 || rows <= 0) { return; };

	for (let i: i32 = 0; i < overlay.count; i += 1) {
		let item = &overlay.items[i: size];
		if (item.text_len <= 0) { continue; };

		let sc = (item.x_frac * (cols: f32)): i32;
		let sr = (item.y_frac * (rows: f32)): i32;
		if (sc < 0) { sc = 0; };
		if (sr < 0) { sr = 0; };
		if (sc >= cols) { sc = cols - 1; };
		if (sr >= rows) { sr = rows - 1; };

		let line = item.text[0z..(item.text_len: size)];
		term_text_draw_wrapped_bytes(line,
			sc, sr, item.r, item.g, item.b,
			cols, rows);
	};
};
