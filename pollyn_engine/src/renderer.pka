	verts: *f32, mvp: *f32, width: f32) void;

def SHADER_MAX_BYTES: size = 16384z;

export fn shader_read_into(path: str, out: []u8) bool = {
	if (!file::Exists(path)) { return false; };
	let size_i64 = file::Size(path);
	if (size_i64 <= 0) { return false; };
	let size_bytes: size = size_i64: size;
	if (size_bytes + 1z > out.len) { return false; };

	let fd = file::MustOpen(path, "r");
	let read_n = file::MustRead(fd, out[0z..size_bytes]);

	file::Close(fd);
	if (read_n != size_i64) { return false; };
	out[size_bytes] = 0u8;
	return true;
};

export fn renderer_init_shaders() bool = {
	let flat_vs_src: [SHADER_MAX_BYTES]u8 = [0...];
	let flat_fs_src: [SHADER_MAX_BYTES]u8 = [0...];
	let pbr_vs_src: [SHADER_MAX_BYTES]u8 = [0...];
	let pbr_fs_src: [SHADER_MAX_BYTES]u8 = [0...];
	let cell_vs_src: [SHADER_MAX_BYTES]u8 = [0...];
	let cell_fs_src: [SHADER_MAX_BYTES]u8 = [0...];
	let wire_vs_src: [SHADER_MAX_BYTES]u8 = [0...];
	let wire_fs_src: [SHADER_MAX_BYTES]u8 = [0...];
	let line_vs_src: [SHADER_MAX_BYTES]u8 = [0...];
	let line_fs_src: [SHADER_MAX_BYTES]u8 = [0...];
	let depth_vs_src: [SHADER_MAX_BYTES]u8 = [0...];
	let depth_fs_src: [SHADER_MAX_BYTES]u8 = [0...];
	let text_vs_src: [SHADER_MAX_BYTES]u8 = [0...];
	let text_fs_src: [SHADER_MAX_BYTES]u8 = [0...];

	if (!shader_read_into("pollyn_engine/shaders/flat.vert", flat_vs_src[0z..])) { return false; };
	if (!shader_read_into("pollyn_engine/shaders/flat.frag", flat_fs_src[0z..])) { return false; };
	if (!shader_read_into("pollyn_engine/shaders/pbr.vert", pbr_vs_src[0z..])) { return false; };
	if (!shader_read_into("pollyn_engine/shaders/pbr.frag", pbr_fs_src[0z..])) { return false; };
	if (!shader_read_into("pollyn_engine/shaders/cell.vert", cell_vs_src[0z..])) { return false; };
	if (!shader_read_into("pollyn_engine/shaders/cell.frag", cell_fs_src[0z..])) { return false; };
	if (!shader_read_into("pollyn_engine/shaders/wire.vert", wire_vs_src[0z..])) { return false; };
	if (!shader_read_into("pollyn_engine/shaders/wire.frag", wire_fs_src[0z..])) { return false; };
	if (!shader_read_into("pollyn_engine/shaders/line.vert", line_vs_src[0z..])) { return false; };
	if (!shader_read_into("pollyn_engine/shaders/line.frag", line_fs_src[0z..])) { return false; };
	if (!shader_read_into("pollyn_engine/shaders/depth.vert", depth_vs_src[0z..])) { return false; };
	if (!shader_read_into("pollyn_engine/shaders/depth.frag", depth_fs_src[0z..])) { return false; };
	if (!shader_read_into("pollyn_engine/shaders/text.vert", text_vs_src[0z..])) { return false; };
	if (!shader_read_into("pollyn_engine/shaders/text.frag", text_fs_src[0z..])) { return false; };

	let status = shim_gl_init_shaders(
		&flat_vs_src[0z], &flat_fs_src[0z],
		&pbr_vs_src[0z], &pbr_fs_src[0z],
		&cell_vs_src[0z], &cell_fs_src[0z],
		&wire_vs_src[0z], &wire_fs_src[0z],
		&line_vs_src[0z], &line_fs_src[0z],
		&depth_vs_src[0z], &depth_fs_src[0z],
		&text_vs_src[0z], &text_fs_src[0z]);
	return status == 0;
};

