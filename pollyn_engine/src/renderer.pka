	mvp: *f32, model: *f32,
	ldx: f32, ldy: f32, ldz: f32,
	lr: f32, lg: f32, lb: f32,
	ex: f32, ey: f32, ez: f32,
	ar: f32, ag: f32, ab: f32,
	metallic: f32, roughness: f32,
	env_data: *f32, alpha: f32) void;

